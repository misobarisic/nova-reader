+    pub providers: Vec<Provider>,
+}
+
+/// Application content providers, including private per-URI grant providers.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+pub struct Provider {
+    #[serde(rename(serialize = "@android:name"))]
