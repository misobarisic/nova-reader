// Every destructive action (clear history, backup restore, deleting downloads,
// removing addons or library entries, bulk chapter state) asks first through
// this one dialog, which shares its look and motion with Reader's menus. The
// host supplies the wording; choice(0) is the confirm row and choice(1) any
// cancel (the Cancel row, Escape, Back or a tap outside).
import { ChoiceDialog } from "@NovaUiBase/choice-dialog.slint";

export component ActionConfirmSheet inherits ChoiceDialog {
    in property <string> confirm-label;
    labels: [root.confirm-label];
}
