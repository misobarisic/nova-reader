import { Theme, SettingsStyle } from "@NovaUiShared";
import { ReaderImageInteraction } from "reader-context-menu.slint";

// Metadata may cover the whole inventory; only admitted, visible entries carry
// image handles. The host releases those handles when their viewport lease ends.
export struct OverviewTile {
    page-id: string,
    page-number: int,
    thumbnail: image,
    loading: bool,
    error: string,
    tall-preview: bool,
}

export component PageThumbnail inherits Rectangle {
    in property <OverviewTile> tile;
    in property <bool> collection;
    in property <bool> current;
    in property <bool> focused;
    in property <bool> interaction-enabled: true;
    callback selected(string);
    callback zoom-requested(float, length, length);
    private property <string> label: root.collection ? @tr("Image {}", root.tile.page-number) : @tr("Page {}", root.tile.page-number);
    accessible-role: button;
    accessible-label: root.label;
    accessible-value: (root.current ? @tr("Current") + ". " : "")
        + (root.tile.error != "" ? @tr("Preview unavailable") + ": " + root.tile.error
            : root.tile.loading ? @tr("Loading preview") : @tr("Preview ready"))
        + (!root.collection && root.tile.tall-preview ? ". " + @tr("Top section preview; one page") : "");
    accessible-enabled: root.interaction-enabled;
    accessible-checkable: true;
    accessible-checked: root.current;
    accessible-action-default => { if root.interaction-enabled { root.selected(root.tile.page-id); } }
    background: transparent;
    image-frame := Rectangle {
        x: 0px; y: 0px; width: 100%; height: root.collection ? parent.height : parent.height - 32px;
        border-radius: root.collection ? 0px : Theme.card_corner_radius;
        background: root.collection ? #000000 : Theme.current.home_artwork_placeholder;
        border-width: root.collection ? 0px : root.current || root.focused ? 2px : 1px;
        border-color: root.focused ? Theme.current.focus_ring : root.current ? Theme.current.accent : Theme.current.border_card;
        clip: true;
        if root.tile.thumbnail.width > 0: Image {
            x: root.collection ? 0px : 3px; y: root.collection ? 0px : 3px;
            width: parent.width - (root.collection ? 0px : 6px); height: parent.height - (root.collection ? 0px : 6px);
            source: root.tile.thumbnail;
            // Manga pages remain complete (or a labelled bounded top section).
            // Collections use the worker's centered square derivative.
            image-fit: root.collection ? cover : contain;
            horizontal-alignment: center; vertical-alignment: center;
        }
        if root.tile.thumbnail.width == 0: Text {
            x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
            text: root.tile.error != "" ? @tr("Preview unavailable") : root.tile.loading ? @tr("Loading preview") : @tr("Waiting for preview");
            color: Theme.current.text_secondary; font-size: 12px;
            wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center;
        }
        if !root.collection && root.tile.tall-preview && root.tile.thumbnail.width > 0: Rectangle {
            x: 3px; y: parent.height - 29px; width: parent.width - 6px; height: 26px;
            background: Theme.current.card;
            Text {
                width: 100%; height: 100%; text: @tr("Top section");
                color: Theme.current.text_settings; font-size: 11px;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        if tile-touch.feedback-active: Rectangle {
            x: root.collection ? 0px : 2px; y: root.collection ? 0px : 2px;
            width: parent.width - (root.collection ? 0px : 4px); height: parent.height - (root.collection ? 0px : 4px);
            background: Theme.current.selection_wash; border-radius: root.collection ? 0px : max(0px, Theme.card_corner_radius - 2px);
        }
        if root.collection && (root.current || root.focused): Rectangle {
            width: 100%; height: 100%; border-width: 2px;
            border-color: root.focused ? Theme.current.focus_ring : Theme.current.accent;
        }
    }
    if !root.collection: HorizontalLayout {
        x: 2px; y: image-frame.height + 5px; width: parent.width - 4px; height: 24px; spacing: 4px;
        Text {
            text: root.label; min-width: 0px; overflow: elide;
            color: root.current ? Theme.current.accent : Theme.current.text_settings;
            font-size: 12px; font-weight: root.current ? 700 : 400; vertical-alignment: center;
        }
        if root.current: Text {
            text: @tr("Current"); color: Theme.current.accent;
            font-size: 11px; vertical-alignment: center;
        }
    }
    tile-touch := ReaderImageInteraction {
        width: 100%; height: 100%; enabled: root.interaction-enabled;
        context-enabled: false; long-press-enabled: false;
        wheel-zoom-enabled: root.collection;
        tapped => { SettingsStyle.keyboard-mode = false; root.selected(root.tile.page-id); }
        zoom-requested(factor,x,y) => { root.zoom-requested(factor,x,y); }
    }
}
