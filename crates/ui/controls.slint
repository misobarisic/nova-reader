import { Theme, SettingsStyle } from "@NovaUiShared";
import { PillButton, AddonIconButton, SettingsInput, ToggleSwitch, SettingsLink, SettingsBackButton } from "@NovaUiBase/settings-controls.slint";
import { Dropdown } from "@NovaUiBase/dropdown.slint";

// Thin Reader API adapters. All painting, motion, pointer/keyboard handling,
// and geometry come from the same Nova Kit controls used by Nova itself.
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> accent;
    in property <bool> enabled: true;
    callback clicked;
    min-width: 0px; height: 44px; vertical-stretch: 0;
    button := PillButton {
        width: parent.width; height: parent.height;
        label: root.text; primary: root.accent; enabled: root.enabled;
        compact: true; wrap_label: true;
        accessible-action-default => { if root.enabled { root.clicked(); } }
        clicked => { root.clicked(); }
    }
    forward-focus: button;
}

export component IconAction inherits AddonIconButton {
    in property <string> text;
    in property <image> icon;
    name: root.text;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Image {
        source: root.icon; width: 20px; height: 20px;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        colorize: Theme.current.text_settings; image-fit: contain;
    }
}

export component BackButton inherits SettingsBackButton {
    accessible-action-default => { root.clicked(); }
}

export component MenuLink inherits SettingsLink {
    accessible-action-default => { if root.enabled && root.interactive { root.picked(); } }
}

export component ReaderField inherits SettingsInput { min-width: 0px; }
export component ReaderSelect inherits Dropdown {
    min-width: 0px; roomy: true;
    keyboard-input-enabled: true;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-label: root.placeholder-text;
    accessible-value: root.current-index >= 0 ? root.model[root.current-index] : "";
    accessible-action-default => { if root.enabled && root.model.length > 0 { root.open_popup(); } }
    accessible-action-expand => { if root.enabled && root.model.length > 0 { root.open_popup(); } }

}

export component ReaderToggle inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled;
    min-width: 0px; min-height: 44px;
    HorizontalLayout {
        spacing: 12px;
        Text { min-width: 0px; text: root.text; color: Theme.current.text_settings; wrap: word-wrap; vertical-alignment: center; }
        ToggleSwitch {
            name: root.text; checked <=> root.checked;
            accessible-action-default => { self.checked = !self.checked; root.toggled(); }
            toggled => { root.toggled(); }
        }
    }
}

export component CategoryPicker inherits Rectangle {
    in property <string> label;
    in property <[string]> model;
    in-out property <int> current-index;
    callback selected(int);
    min-width: 0px; height: 68px;
    VerticalLayout {
        spacing: 8px;
        Text { min-width: 0px; text: root.label; color: Theme.current.text_secondary; font-size: 12px; }
        ReaderSelect { model: root.model; current-index <=> root.current-index; selected(value) => { root.selected(self.current-index); } }
    }
}
