// Reader destinations hosted in Nova's retained More landing/push-page pattern.
// Layout, SettingsCard/SettingsLink rows and transitions follow Nova b69a1e5.
import { Theme, Anim, SettingsStyle, SliderGesture } from "@NovaUiShared";
import { SettingsCard } from "@NovaUiBase/settings-controls.slint";
import { ScrollView } from "@NovaUiBase/scrollview.slint";
import { ReaderSettingsForm } from "reader-settings.slint";
import { PageHeader } from "page-header.slint";
import { SettingsSectionHost } from "settings-section-host.slint";
import { SettingsPages } from "@NovaUiShared";
import { AboutPage } from "about.slint";
import { ProfilesPage, ProfilesBridge } from "profiles.slint";
import { LicenseSource } from "about-models.slint";
import { MenuLink, ActionButton, ReaderField } from "controls.slint";
import { IndexRow, IndexGroupLabel, IndexGroup } from "more-index.slint";

export component MorePage inherits Rectangle {
    in property <int> section;
    in property <bool> narrow;
    in property <string> app-version;
    in property <[string]> license-text-chunks;
    in property <[LicenseSource]> license-sources;
    in property <bool> update-checks-enabled: false;
    in property <bool> update-checking: false;
    in-out property <bool> about-licenses-open;
    in-out property <length> about-scroll-y;
    in-out property <length> about-licenses-scroll-y;
    in property <int> about-back-request;
    callback license-source-requested(string);
    callback profile-delete-requested(string, string);
    in property <string> status;
    in property <string> image-cache-info;
    in property <string> image-cache-status;
    in property <bool> image-cache-busy;
    callback image-cache-refresh;
    callback image-cache-clear;
    in-out property <string> category-text;
    callback navigate(int);
    callback install-addon;
    callback local-import(bool);
    callback add-category(string);
    callback check-update;
    // Case-insensitive search over a destination's title and keywords.
    pure callback search-matches(string, string) -> bool;
    background: Theme.current.artwork_canvas;
    clip: true;

    // ---- Unified More/Settings index (Nova's design A) ----
    // Wide windows keep the index as a fixed column and show the picked
    // destination beside it; the right side stays empty until something is
    // picked. Narrow windows go index → settings group → section, each a
    // pushed page with Back.
    out property <bool> two-pane: !root.narrow && root.width >= 760px;
    private property <length> index-width: 336px; // 300px of rows plus gutters
    private property <length> pane-x: root.two-pane ? root.index-width + 1px : 0px;
    private property <string> query;
    // The settings group page opened from a narrow index (0 = all sections).
    private property <int> settings-group: 0;
    // Keyboard choice: a destination section, or 101-103 for group rows.
    private property <int> choice: root.narrow ? 7 : 9;
    // Visual order on both layouts; labels (200+) only appear on the wide index.
    private property <[int]> wide-order: [201, 9, 24, 202, 19, 14, 16, 15, 203, 20, 21, 3, 11, 204, 18, 12, 22, 17, 205, 13];
    private property <[int]> narrow-order: [7, 9, 24, 101, 102, 103, 19, 14, 16, 15, 20, 21, 3, 11, 18, 12, 22, 17, 13];
    private property <[int]> key-order: root.two-pane ? root.wide-order : root.narrow-order;
    pure function group-of(id: int) -> int {
        return id == 19 || id == 14 || id == 16 || id == 15 ? 1
            : id == 3 || id == 11 || id == 20 || id == 21 ? 2
            : id == 17 || id == 22 || id == 18 || id == 12 ? 3 : 0;
    }
    pure function group-title(group: int) -> string {
        return group == 1 ? @tr("Experience") : group == 2 ? @tr("Library and sources")
            : group == 3 ? @tr("Storage and data") : @tr("Settings");
    }
    pure function title(id: int) -> string {
        return id == 7 ? @tr("Downloads") : id == 9 ? @tr("Local chapters") : id == 24 ? @tr("Profiles")
            : id == 19 ? @tr("Reader") : id == 14 ? @tr("Theme") : id == 16 ? @tr("Display")
            : id == 15 ? @tr("Look and feel") : id == 3 ? @tr("Sources") : id == 11 ? @tr("Categories")
            : id == 20 ? @tr("Sync") : id == 21 ? @tr("Downloads") : id == 17 ? @tr("Cache")
            : id == 22 ? @tr("Image limits") : id == 18 ? @tr("Screenshots & saved images")
            : id == 12 ? @tr("Data") : id == 13 ? @tr("About")
            : id == 101 ? @tr("Experience") : id == 102 ? @tr("Library and sources")
            : id == 103 ? @tr("Storage and data") : id == 201 ? @tr("YOUR READING")
            : id == 202 ? @tr("EXPERIENCE") : id == 203 ? @tr("LIBRARY AND SOURCES")
            : id == 204 ? @tr("STORAGE AND DATA") : id == 205 ? @tr("NOVA READER") : "";
    }
    // Searchable words beyond the title, matching each section's contents.
    pure function keywords(id: int) -> string {
        return id == 7 ? @tr("Read your saved chapters") : id == 9 ? @tr("Import chapter archives and image folders")
            : id == 24 ? @tr("Separate libraries, history and settings")
            : id == 19 ? @tr("Reading defaults, navigation and image adjustments")
            : id == 14 ? @tr("Accent color, backgrounds and card styling") : id == 16 ? @tr("Library and browse layouts")
            : id == 15 ? @tr("Animations and motion options") : id == 3 ? @tr("Install, browse and configure source addons")
            : id == 11 ? @tr("Organize your library") : id == 20 ? @tr("Paired devices, reading progress and shared settings")
            : id == 21 ? @tr("Auto-delete read chapters and excluded categories")
            : id == 17 ? @tr("Chapter pages, artwork and storage limits")
            : id == 22 ? @tr("File size, dimensions and decoder memory")
            : id == 18 ? @tr("Saved image source, image format, quality and save folders")
            : id == 12 ? @tr("Backup and import") : id == 13 ? @tr("Information about Nova Reader") : "";
    }
    pure function kit-icon(id: int) -> int {
        return id == 7 ? 17 : id == 14 ? 14 : id == 16 ? 3 : id == 15 ? 6 : id == 3 ? 0 : id == 11 ? 1
            : id == 20 ? 7 : id == 21 ? 8 : id == 17 ? 2 : id == 13 ? 15
            : id == 101 ? 6 : id == 102 ? 1 : id == 103 ? 4 : -1;
    }
    pure function own-icon(id: int) -> image {
        return id == 9 ? @image-url("../../assets/icons/settings/folder.svg")
            : id == 24 ? @image-url("../../assets/icons/settings/profiles.svg")
            : id == 19 ? @image-url("../../assets/icons/settings/reader.svg")
            : id == 22 ? @image-url("../../assets/icons/settings/image-limits.svg")
            : id == 18 ? @image-url("../../assets/icons/settings/screenshots.svg")
            : @image-url("../../assets/icons/settings/backup.svg");
    }
    pure function in-group(id: int) -> bool { return root.settings-group == 0 || root.group-of(id) == root.settings-group; }
    pure function hit(id: int) -> bool {
        return root.query == "" || root.search-matches(root.title(id) + " " + root.keywords(id), root.query);
    }
    // Whether a row (or a wide-index label) is listed right now.
    pure function shown(id: int) -> bool {
        if id >= 200 { return root.two-pane && root.query == ""; }
        if id >= 101 && id <= 103 { return !root.two-pane && root.query == ""; }
        if id == 7 { return root.narrow && root.hit(id); }
        // Narrow layouts list settings sections on their group pages, except
        // while searching, when matches are listed directly.
        if root.group-of(id) > 0 && !root.two-pane && root.query == "" { return false; }
        return root.hit(id);
    }
    pure function selectable(id: int) -> bool { return id < 200 && root.shown(id); }
    function pick(id: int) {
        root.choice = id;
        if id >= 101 && id <= 103 {
            root.settings-group = id - 100;
            root.navigate(10);
            return;
        }
        // Back from a section returns to its group page on narrow layouts.
        if root.group-of(id) > 0 { root.settings-group = root.group-of(id); }
        root.navigate(id);
        if id == 17 { root.image-cache-refresh(); }
    }
    // Keyboard steps skip rows hidden by the layout or the search.
    pure function key-index(id: int) -> int {
        return root.key-order[0] == id ? 0 : root.key-order[1] == id ? 1 : root.key-order[2] == id ? 2
            : root.key-order[3] == id ? 3 : root.key-order[4] == id ? 4 : root.key-order[5] == id ? 5
            : root.key-order[6] == id ? 6 : root.key-order[7] == id ? 7 : root.key-order[8] == id ? 8
            : root.key-order[9] == id ? 9 : root.key-order[10] == id ? 10 : root.key-order[11] == id ? 11
            : root.key-order[12] == id ? 12 : root.key-order[13] == id ? 13 : root.key-order[14] == id ? 14
            : root.key-order[15] == id ? 15 : root.key-order[16] == id ? 16 : root.key-order[17] == id ? 17
            : root.key-order[18] == id ? 18 : root.key-order[19] == id ? 19 : -1;
    }
    pure function key-step(index: int, direction: int) -> int {
        let last = root.key-order.length - 1;
        let i1 = clamp(index + direction, 0, last);
        if root.selectable(root.key-order[i1]) { return i1; }
        let i2 = clamp(i1 + direction, 0, last);
        if root.selectable(root.key-order[i2]) { return i2; }
        let i3 = clamp(i2 + direction, 0, last);
        if root.selectable(root.key-order[i3]) { return i3; }
        let i4 = clamp(i3 + direction, 0, last);
        if root.selectable(root.key-order[i4]) { return i4; }
        let i5 = clamp(i4 + direction, 0, last);
        if root.selectable(root.key-order[i5]) { return i5; }
        let i6 = clamp(i5 + direction, 0, last);
        if root.selectable(root.key-order[i6]) { return i6; }
        let i7 = clamp(i6 + direction, 0, last);
        if root.selectable(root.key-order[i7]) { return i7; }
        let i8 = clamp(i7 + direction, 0, last);
        if root.selectable(root.key-order[i8]) { return i8; }
        let i9 = clamp(i8 + direction, 0, last);
        if root.selectable(root.key-order[i9]) { return i9; }
        let i10 = clamp(i9 + direction, 0, last);
        if root.selectable(root.key-order[i10]) { return i10; }
        let i11 = clamp(i10 + direction, 0, last);
        if root.selectable(root.key-order[i11]) { return i11; }
        let i12 = clamp(i11 + direction, 0, last);
        if root.selectable(root.key-order[i12]) { return i12; }
        let i13 = clamp(i12 + direction, 0, last);
        if root.selectable(root.key-order[i13]) { return i13; }
        let i14 = clamp(i13 + direction, 0, last);
        if root.selectable(root.key-order[i14]) { return i14; }
        let i15 = clamp(i14 + direction, 0, last);
        if root.selectable(root.key-order[i15]) { return i15; }
        let i16 = clamp(i15 + direction, 0, last);
        if root.selectable(root.key-order[i16]) { return i16; }
        let i17 = clamp(i16 + direction, 0, last);
        if root.selectable(root.key-order[i17]) { return i17; }
        let i18 = clamp(i17 + direction, 0, last);
        if root.selectable(root.key-order[i18]) { return i18; }
        let i19 = clamp(i18 + direction, 0, last);
        return root.selectable(root.key-order[i19]) ? i19 : index;
    }
    function move-choice(direction: int) {
        let index = root.key-index(root.choice);
        // A choice hidden by search or layout restarts from the first row.
        if index < 0 || !root.selectable(root.choice) {
            root.choice = root.key-order[root.key-step(-1, 1)];
        } else {
            root.choice = root.key-order[root.key-step(index, direction)];
        }
    }
    function reveal-row(y: length, h: length) {
        let top = y - landing-scroll.absolute-position.y;
        if top < 0px { landing-scroll.content-y -= top; }
        else if top + h > landing-scroll.visible-height { landing-scroll.content-y -= top + h - landing-scroll.visible-height; }
    }
    public function focus_shell() {
        if root.section == 4 { nav-scope.focus(); }
        else if root.section == 13 { about-page.focus_shell(); about-focus.start(); }
        else if root.detail-open { detail-scope.focus(); }
        else { child-scope.focus(); }
    }
    changed narrow => { if !root.selectable(root.choice) { root.move-choice(1); } }
    private property <bool> local-open: (root.section >= 9 && root.section <= 22) || root.section == 24;
    private property <bool> detail-open: root.section == 11 || root.section == 12 || root.section == 14 || root.section == 15 || root.section == 16 || root.section == 17 || root.section == 18 || root.section == 19 || root.section == 20 || root.section == 21 || root.section == 22;
    private property <int> child-section: 9;
    private property <int> detail-section: 11;
    private property <bool> entered: false;
    private property <bool> detail-entered: false;
    private property <bool> motion: Anim.enabled && Anim.transitions;
    private property <float> progress: root.entered ? 1 : 0;
    private property <float> fade: root.entered ? 1 : 0;
    private property <float> detail-progress: root.detail-entered ? 1 : 0;
    private property <float> detail-fade: root.detail-entered ? 1 : 0;
    animate progress { duration: Anim.transition_slide; easing: ease-out; }
    animate fade { duration: Anim.transition_fade; }
    animate detail-progress { duration: Anim.transition_slide; easing: ease-out; }
    animate detail-fade { duration: Anim.transition_fade; }
    changed entered => { root.progress = root.entered ? 1 : 0; root.fade = root.entered ? 1 : 0; }
    changed detail-entered => { root.detail-progress = root.detail-entered ? 1 : 0; root.detail-fade = root.detail-entered ? 1 : 0; }
    changed motion => {
        if !root.motion {
            entry-tick.stop(); detail-entry-tick.stop();
            root.entered = root.local-open; root.detail-entered = root.detail-open;
            root.progress = root.local-open ? 1 : 0; root.fade = root.local-open ? 1 : 0;
            root.detail-progress = root.detail-open ? 1 : 0; root.detail-fade = root.detail-open ? 1 : 0;
        }
    }
    // Explicit endpoints keep master-off instantaneous even during a running
    // animation. Retained layers reverse from their current painted position.
    private property <float> slide: root.motion ? root.progress : root.local-open ? 1 : 0;
    private property <float> alpha: root.motion ? root.fade : root.local-open ? 1 : 0;
    private property <float> sub-slide: root.motion ? root.detail-progress : root.detail-open ? 1 : 0;
    private property <float> sub-alpha: root.motion ? root.detail-fade : root.detail-open ? 1 : 0;
    changed local-open => {
        if root.local-open { entry-tick.start(); }
        else { entry-tick.stop(); root.entered = false; }
    }
    changed detail-open => {
        if root.detail-open { detail-entry-tick.start(); }
        else { detail-entry-tick.stop(); root.detail-entered = false; root.child-restore-pending = true; }
    }
    // Mount and lay out before publishing the entrance target, as in Nova.
    entry-tick := Timer { interval: 1ms; running: false; triggered => { self.stop(); root.entered = root.local-open; } }
    detail-entry-tick := Timer { interval: 1ms; running: false; triggered => { self.stop(); root.detail-entered = root.detail-open; } }
    private property <length> landing-scroll-y: 0px;
    private property <bool> restore-pending: true;
    private property <length> child-scroll-y: 0px;
    private property <bool> child-restore-pending: false;
    private property <bool> child-active: root.local-open && !root.detail-open && root.sub-slide <= 0 && root.sub-alpha <= 0;
    private property <bool> detail-active: root.local-open && root.detail-open;
    changed section => {
        SliderGesture.active = false; SliderGesture.hovered = false;
        if root.section == 9 || root.section == 10 || root.section == 13 || root.section == 24 {
            if root.child-section != root.section { child-scroll.content-y = 0px; root.child-scroll-y = 0px; }
            root.child-section = root.section;
        }
        if root.section == 13 { about-focus.start(); }
        if root.detail-open { root.child-section = 10; root.detail-section = root.section; detail-scroll.content-y = 0px; }
        if root.section == 4 { root.restore-pending = true; }
        // Opened directly (not from a group row) on the wide index: list every section.
        if root.section == 10 && root.two-pane { root.settings-group = 0; }
        // Profiles always opens on the picker.
        if root.section == 24 { ProfilesBridge.managing = false; ProfilesBridge.editor = 0; }
    }
    about-focus := Timer { interval: 1ms; running: false; triggered => {
        self.stop(); if root.section == 13 { about-page.focus_shell(); }
    } }
    // The list is hidden while a sub-page covers it and loses its offset, so
    // the saved position is applied from the moment it shows again (not after
    // the slide-back ends) and re-applied until the page is active.
    child-restore := Timer {
        interval: 16ms; running: root.child-restore-pending && root.local-open;
        triggered => {
            if !root.detail-open {
                if abs(child-scroll.content-y - root.child-scroll-y) > 0.5px { child-scroll.content-y = root.child-scroll-y; }
                if root.child-active { root.child-restore-pending = false; child-scope.focus(); }
            }
        }
    }
    // Like Nova's restore_scroll timer, apply the saved position after layout
    // publication. Hidden native scroll views may clamp their content offset.
    restore-scroll := Timer {
        interval: 16ms;
        running: root.section == 4 && root.restore-pending;
        triggered => {
            if root.section == 4 {
                if abs(landing-scroll.content-y - root.landing-scroll-y) > 0.5px { landing-scroll.content-y = root.landing-scroll-y; }
                if root.landing-active { root.restore-pending = false; nav-scope.focus(); }
            }
        }
    }
    private property <bool> landing-active: root.section == 4 && root.slide <= 0 && root.alpha <= 0;
    private property <int> focus-request: SettingsStyle.focus-request;
    changed focus-request => {
        if SettingsStyle.keyboard-mode && root.visible {
            if root.landing-active { root.reveal_landing(); }
            else if root.detail-open { root.reveal_detail(); }
            else if root.local-open { root.reveal_child(); }
        }
    }
    function reveal_landing() {
        let top = SettingsStyle.focus-y - landing-scroll.absolute-position.y;
        if top < 0px { landing-scroll.content-y -= top; }
        else if top + SettingsStyle.focus-height > landing-scroll.visible-height {
            landing-scroll.content-y -= top + SettingsStyle.focus-height - landing-scroll.visible-height;
        }
    }
    function reveal_child() {
        let top = SettingsStyle.focus-y - child-scroll.absolute-position.y;
        if top < 0px { child-scroll.content-y -= top; }
        else if top + SettingsStyle.focus-height > child-scroll.visible-height {
            child-scroll.content-y -= top + SettingsStyle.focus-height - child-scroll.visible-height;
        }
    }
    function reveal_detail() {
        let top = SettingsStyle.focus-y - detail-scroll.absolute-position.y;
        if top < 0px { detail-scroll.content-y -= top; }
        else if top + SettingsStyle.focus-height > detail-scroll.height {
            detail-scroll.content-y -= top + SettingsStyle.focus-height - detail-scroll.height;
        }
    }
    // This scroller remains mounted while its children own input. Returning
    // restores the same cards and position, just like Nova's More page.
    landing := Rectangle {
        width: root.two-pane ? root.index-width : root.width;
        height: max(0px, root.height - (root.narrow && !Theme.transparent_navbar ? 68px : 0px));
        visible: root.two-pane || !root.local-open || root.slide < 1 || root.alpha < 1;
        // Narrow pages enter like a Browse catalogue: a short slide and fade,
        // the page behind nudging aside. The wide index never moves.
        x: root.two-pane ? 0px : -24px * root.slide;
        opacity: root.two-pane ? 1 : 1 - root.alpha;
        nav-scope := FocusScope {
            width: parent.width; height: parent.height; enabled: root.landing-active || root.two-pane;
            key-pressed(e) => {
                if e.text == Key.UpArrow || e.text == Key.DownArrow {
                    SettingsStyle.keyboard-mode = true;
                    root.move-choice(e.text == Key.UpArrow ? -1 : 1);
                    self.focus();
                    return accept;
                }
                if e.text == Key.Return || e.text == " " {
                    if !e.repeat && root.selectable(root.choice) { root.pick(root.choice); }
                    return accept;
                }
                return reject;
            }
            landing-scroll := ScrollView {
                changed content-y => {
                    if root.landing-active && !root.restore-pending { root.landing-scroll-y = self.content-y; }
                }
                width: parent.width; height: parent.height;
                mouse-drag-pan-enabled: true;
                content-width: self.visible-width;
                VerticalLayout {
                    padding: 18px; padding-bottom: 18px + (root.narrow && Theme.transparent_navbar ? 68px : 0px);
                    spacing: root.two-pane ? 8px : 12px; alignment: start;
                    PageHeader { title: @tr("More"); narrow: root.narrow; show-back: root.narrow; back => { root.navigate(0); } }
                    // The active profile, with a quick way to switch.
                    for profile in ProfilesBridge.profiles: Rectangle {
                        visible: profile.active;
                        height: profile.active ? 64px : 0px;
                        background: Theme.current.card; border-radius: Theme.card_corner_radius;
                        border-width: 1px; border-color: Theme.current.border_soft;
                        if profile.active: HorizontalLayout {
                            padding: 12px; spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 40px; height: 40px; border-radius: 20px;
                                    background: profile.avatar-background;
                                    Text { text: profile.initial; color: profile.avatar-foreground; font-size: 18px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            VerticalLayout {
                                alignment: center; spacing: 2px; horizontal-stretch: 1; min-width: 0px;
                                Text { text: profile.name; color: Theme.current.text_bright; font-size: 15px; font-weight: 600; overflow: elide; }
                                Text { text: @tr("Current profile"); color: Theme.current.text_muted; font-size: 12px; overflow: elide; }
                            }
                            ActionButton {
                                text: @tr("Switch"); enabled: root.landing-active || root.two-pane;
                                clicked => { root.pick(24); }
                            }
                        }
                    }
                    ReaderField {
                        placeholder-text: @tr("Search settings");
                        search-icon: true;
                        enabled: root.landing-active || root.two-pane;
                        edited(value) => {
                            root.query = value;
                            if !root.selectable(root.choice) { root.move-choice(1); }
                        }
                    }
                    if root.two-pane: IndexGroup {
                        card: false;
                        for id in root.wide-order: Rectangle {
                            height: root.shown(id) ? (id >= 200 ? label.height : row.height) : 0px;
                            visible: root.shown(id);
                            label := IndexGroupLabel {
                                width: parent.width; visible: id >= 200;
                                text: root.title(id);
                            }
                            row := IndexRow {
                                width: parent.width; visible: id < 200;
                                title: root.title(id); icon-kind: root.kit-icon(id);
                                icon: root.own-icon(id);
                                destination-id: "more:" + id;
                                selected: root.section == id;
                                focused: SettingsStyle.keyboard-mode && root.choice == id && nav-scope.has-focus;
                                interactive: root.two-pane;
                                reveal(y, h) => { root.reveal-row(y, h); }
                                picked => { root.pick(id); }
                            }
                        }
                    }
                    if !root.two-pane: VerticalLayout {
                        spacing: 12px;
                        if root.shown(7) || root.shown(9) || root.shown(24): IndexGroup {
                            for id in [7, 9, 24]: IndexRow {
                                height: root.shown(id) ? 44px : 0px; visible: root.shown(id);
                                title: root.title(id); icon-kind: root.kit-icon(id);
                                icon: root.own-icon(id);
                                destination-id: id == 7 ? "more:downloads" : id == 9 ? "more:local" : "more:profiles";
                                focused: SettingsStyle.keyboard-mode && root.choice == id;
                                interactive: root.landing-active;
                                reveal(y, h) => { root.reveal-row(y, h); }
                                picked => { root.pick(id); }
                            }
                        }
                        if root.query == "": IndexGroup {
                            for group in [101, 102, 103]: IndexRow {
                                title: root.title(group); icon-kind: root.kit-icon(group); chevron: true;
                                destination-id: "more:settings:" + (group - 100);
                                focused: SettingsStyle.keyboard-mode && root.choice == group;
                                interactive: root.landing-active;
                                reveal(y, h) => { root.reveal-row(y, h); }
                                picked => { root.pick(group); }
                            }
                        }
                        if root.query != "": IndexGroup {
                            for id in [19, 14, 16, 15, 20, 21, 3, 11, 18, 12, 22, 17]: IndexRow {
                                height: root.shown(id) ? 44px : 0px; visible: root.shown(id);
                                title: root.title(id); icon-kind: root.kit-icon(id);
                                icon: root.own-icon(id);
                                trailing: root.group-title(root.group-of(id));
                                destination-id: "more:" + id;
                                focused: SettingsStyle.keyboard-mode && root.choice == id;
                                interactive: root.landing-active;
                                reveal(y, h) => { root.reveal-row(y, h); }
                                picked => { root.pick(id); }
                            }
                        }
                        if root.shown(13): IndexGroup {
                            IndexRow {
                                title: root.title(13); icon-kind: 15;
                                destination-id: "more:about";
                                focused: SettingsStyle.keyboard-mode && root.choice == 13;
                                interactive: root.landing-active;
                                reveal(y, h) => { root.reveal-row(y, h); }
                                picked => { root.pick(13); }
                            }
                        }
                    }
                    if root.query != "" && !root.shown(9) && !root.shown(24) && !root.shown(13) && !root.shown(7)
                        && !root.shown(19) && !root.shown(14) && !root.shown(16) && !root.shown(15) && !root.shown(3)
                        && !root.shown(11) && !root.shown(20) && !root.shown(21) && !root.shown(17) && !root.shown(22)
                        && !root.shown(18) && !root.shown(12): Text {
                        text: @tr("Nothing found"); color: Theme.current.text_muted; horizontal-alignment: center;
                    }
                }
            }
        }
    }
    // The wide index's edge; the right side is empty until something is picked.
    if root.two-pane: Rectangle {
        x: root.index-width; width: 1px; height: root.height;
        background: Theme.current.border_soft;
    }
    // Settings landing stays mounted beneath its selected leaf. Back reveals
    // the same scroll/focus state instead of replacing a shared child body.
    // On the wide index, child and detail pages fill the pane beside it.
    child := Rectangle {
        width: root.width - root.pane-x; height: root.height;
        // Beside the index a section replaces a page instead of covering it.
        visible: (root.local-open || root.slide > 0 || root.alpha > 0) && (root.two-pane
            ? !root.detail-open && root.sub-slide <= 0 && root.sub-alpha <= 0
            : (!root.detail-open || root.sub-slide < 1 || root.sub-alpha < 1));
        x: root.pane-x + 48px * (1 - root.slide) - (root.two-pane ? 0px : 24px * root.sub-slide);
        opacity: root.two-pane ? root.alpha : root.alpha * (1 - root.sub-alpha);
        child-scope := FocusScope {
            width: parent.width; height: parent.height; enabled: root.child-active && root.child-section != 13;
            child-scroll := ScrollView {
                visible: root.child-section != 13;
                width: parent.width; height: parent.height;
                mouse-drag-pan-enabled: true; content-width: self.visible-width;
                changed content-y => { if root.child-active && !root.child-restore-pending { root.child-scroll-y = self.content-y; } }
                VerticalLayout {
                    padding: 18px; spacing: 12px; alignment: start;
                    PageHeader {
                        title: root.child-section == 9 ? @tr("Local chapters") : root.child-section == 24 ? (ProfilesBridge.managing ? @tr("Manage profiles") : @tr("Profiles")) : root.child-section == 10 ? root.group-title(root.settings-group) : @tr("About");
                        narrow: root.narrow; show-back: !ProfilesBridge.require-selection || root.child-section != 24;
                        back => {
                            if !root.child-active { return; }
                            // Manage profiles and its editors close one level at a time.
                            if root.child-section == 24 && ProfilesBridge.step-back() { return; }
                            if !(ProfilesBridge.require-selection && root.child-section == 24) { root.navigate(4); }
                        }
                    }
                    if root.status != "": Text { min-width: 0px; text: root.status; color: Theme.current.text_settings; wrap: word-wrap; }
                    if root.child-section == 9: VerticalLayout {
                        spacing: 12px;
                        SettingsCard { MenuLink {
                            interactive: root.child-active; title: @tr("Import a local chapter"); subtitle: @tr("Choose a CBZ or ZIP archive"); icon: @image-url("../../assets/icons/settings/archive-file.svg");
                            picked => { root.local-import(false); }
                        } }
                        SettingsCard { MenuLink {
                            interactive: root.child-active; title: @tr("Import an image folder"); subtitle: @tr("Choose a folder of chapter pages"); icon: @image-url("../../assets/icons/settings/folder.svg");
                            picked => { root.local-import(true); }
                        } }
                    }
                    if root.child-section == 24: ProfilesPage {
                        interactive: root.child-active;
                        delete-requested(id, name) => { root.profile-delete-requested(id, name); }
                    }
                    if root.child-section == 10: VerticalLayout {
                        spacing: 12px; alignment: start;
                        if root.in-group(20): SettingsCard { MenuLink {
                            interactive: root.child-active; title: @tr("Sync"); subtitle: @tr("Paired devices, reading progress and shared settings"); icon-kind: 7;
                            destination-id: "settings:sync"; picked => { root.pick(20); }
                        } }
                        if root.in-group(21): SettingsCard { MenuLink {
                            interactive: root.child-active; title: @tr("Downloads"); subtitle: @tr("Auto-delete read chapters and excluded categories"); icon-kind: 8;
                            picked => { root.pick(21); }
                        } }
                        if root.in-group(19): SettingsCard { MenuLink {
                            interactive: root.child-active; title: @tr("Reader"); subtitle: @tr("Reading defaults, navigation and image adjustments"); icon: @image-url("../../assets/icons/settings/reader.svg");
                            picked => { root.pick(19); }
                        } }
                        if root.in-group(14): SettingsCard { MenuLink {
                            interactive: root.child-active; title: @tr("Theme"); subtitle: @tr("Accent color, backgrounds and card styling"); icon-kind: 14;
                            picked => { root.pick(14); }
                        } }
                        if root.in-group(16): SettingsCard { MenuLink {
                            interactive: root.child-active; title: @tr("Display"); subtitle: @tr("Library and browse layouts"); icon-kind: 3;
                            picked => { root.pick(16); }
                        } }
                        if root.in-group(18): SettingsCard { MenuLink {
                            interactive: root.child-active; title: @tr("Screenshots & saved images"); subtitle: @tr("Saved image source, image format, quality and save folders"); icon: @image-url("../../assets/icons/settings/screenshots.svg");
                            picked => { root.pick(18); }
                        } }
                        if root.in-group(15): SettingsCard { MenuLink {
                            interactive: root.child-active; title: @tr("Look and feel"); subtitle: @tr("Animations and motion options"); icon-kind: 6;
                            picked => { root.pick(15); }
                        } }
                        if root.in-group(3): SettingsCard { MenuLink {
                            interactive: root.child-active; title: @tr("Sources"); subtitle: @tr("Install, browse and configure source addons"); icon-kind: 0;
                            picked => { root.pick(3); }
                        } }
                        if root.in-group(11): SettingsCard { MenuLink {
                            interactive: root.child-active; title: @tr("Categories"); subtitle: @tr("Organize your library"); icon-kind: 1;
                            picked => { root.pick(11); }
                        } }
                        if root.in-group(12): SettingsCard { MenuLink {
                            interactive: root.child-active; title: @tr("Data"); subtitle: @tr("Backup and import"); icon: @image-url("../../assets/icons/settings/backup.svg");
                            picked => { root.pick(12); }
                        } }
                        if root.in-group(22): SettingsCard { MenuLink {
                            interactive: root.child-active; title: @tr("Image limits"); subtitle: @tr("File size, dimensions and decoder memory"); icon: @image-url("../../assets/icons/settings/image-limits.svg");
                            picked => { root.pick(22); }
                        } }
                        if root.in-group(17): SettingsCard { MenuLink {
                            interactive: root.child-active; title: @tr("Cache"); subtitle: @tr("Chapter pages, artwork and storage limits"); icon-kind: 2;
                            picked => { root.pick(17); }
                        } }
                    }

                }
            }
        }
        about-page := AboutPage {
            width: parent.width; height: parent.height;
            visible: root.child-section == 13;
            active: root.child-active && root.section == 13;
            external_navigation: true;
            narrow: root.narrow;
            nav-viewport-width: root.width - root.pane-x;
            app_version: root.app-version;
            license_text_chunks: root.license-text-chunks;
            license_sources: root.license-sources;
            licenses_open <=> root.about-licenses-open;
            scroll_y <=> root.about-scroll-y;
            licenses_scroll_y <=> root.about-licenses-scroll-y;
            system_back_request: root.about-back-request;
            update_checks_enabled: root.update-checks-enabled;
            update_checking: root.update-checking;
            update_status_text: root.status;
            update_check_requested => { root.check-update(); }
            license_source_requested(url) => { root.license-source-requested(url); }
            back_picked => { if root.child-active { root.navigate(4); } }
        }
    }
    detail := Rectangle {
        width: root.width - root.pane-x; height: root.height;
        visible: (root.local-open || root.slide > 0 || root.alpha > 0) && (root.detail-open || root.sub-slide > 0 || root.sub-alpha > 0);
        x: root.pane-x + 48px * (1 - root.sub-slide);
        opacity: root.alpha * root.sub-alpha;
        detail-scope := FocusScope {
            width: parent.width; height: parent.height; enabled: root.detail-active;
            if root.detail-section == 19: VerticalLayout {
                padding: 18px; spacing: 12px;
                PageHeader { title: @tr("Reader"); narrow: root.narrow; show-back: true; back => { if root.detail-active { root.navigate(root.two-pane ? 4 : 10); } } }
                if root.status != "": Text { text: root.status; color: Theme.current.text_settings; wrap: word-wrap; }
                reader-defaults := ReaderSettingsForm { global-settings: true; interactive: root.detail-active; min-height: 0px; vertical-stretch: 1; }
            }
            detail-scroll := Flickable {
                visible: root.detail-section != 19;
                width: parent.width; height: parent.height;
                // Same guard as Nova Settings: a slider owns diagonal motion
                // until release, while ordinary settings swipes still scroll.
                interactive: root.detail-active && !SliderGesture.active;
                mouse-drag-pan-enabled: !SliderGesture.hovered;
                content-width: self.width;
                content-height: max(self.height, detail-content.preferred-height);
                detail-content := VerticalLayout {
                    x: 0px; y: 0px; width: detail-scroll.width; height: self.preferred-height; min-width: 0px;
                    padding: 18px; spacing: 16px; alignment: start;
                    PageHeader {
                        title: root.detail-section == 22 ? @tr("Image limits") : root.detail-section == 21 ? @tr("Downloads") : root.detail-section == 20 ? @tr("Sync") : root.detail-section == 11 ? @tr("Categories") : root.detail-section == 12 ? @tr("Data") : root.detail-section == 14 ? @tr("Theme") : root.detail-section == 16 ? @tr("Display") : root.detail-section == 17 ? @tr("Cache") : root.detail-section == 18 ? @tr("Screenshots & saved images") : @tr("Look and feel");
                        narrow: root.narrow; show-back: true; back => { if root.detail-active { root.navigate(root.two-pane ? 4 : 10); } }
                    }
                    if root.status != "": Text { min-width: 0px; text: root.status; color: Theme.current.text_settings; wrap: word-wrap; }
                    // Sub-pages compiled in their own crates (`crates/ui-settings-*`).
                    if root.detail-section == 22 || root.detail-section == 21 || root.detail-section == 20
                        || root.detail-section == 12 || root.detail-section == 14 || root.detail-section == 16
                        || root.detail-section == 18 || root.detail-section == 17 || root.detail-section == 15: SettingsSectionHost {
                        factory: root.detail-section == 22 ? SettingsPages.limits : root.detail-section == 21 ? SettingsPages.cleanup
                            : root.detail-section == 20 ? SettingsPages.sync : root.detail-section == 12 ? SettingsPages.backup
                            : root.detail-section == 14 ? SettingsPages.theme : root.detail-section == 16 ? SettingsPages.display
                            : root.detail-section == 18 ? SettingsPages.capture : root.detail-section == 17 ? SettingsPages.storage
                            : SettingsPages.motion;
                        slot-width: self.width; slot-height: self.height;
                        interactive: root.detail-active;
                        narrow: root.width < 700px; phone-layout: root.narrow;
                        image-cache-busy: root.image-cache-busy;
                        image-cache-info: root.image-cache-info;
                        image-cache-status: root.image-cache-status;
                    }
                    if root.detail-section == 11: SettingsCard {
                        VerticalLayout {
                            padding: 16px; spacing: 12px;
                            Text { min-width: 0px; text: @tr("Create a category, then assign it from your library."); color: Theme.current.text_settings; wrap: word-wrap; }
                            ReaderField { enabled: root.detail-active; text <=> root.category-text; placeholder-text: @tr("New category"); accepted(value) => { root.add-category(root.category-text); } }
                            ActionButton { enabled: root.detail-active; text: @tr("Add category"); clicked => { root.add-category(root.category-text); } }
                        }
                    }
                }
            }
        }
    }
}
