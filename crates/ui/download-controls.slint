import { Theme, Anim } from "@NovaUiShared";
import { AddonIconButton } from "@NovaUiBase/settings-controls.slint";

// Shared stroke vocabulary for chapter status and download actions.
export component DownloadGlyph inherits Path {
    in property <string> glyph: "download";
    width: 24px; height: 24px;
    viewbox-width: 24; viewbox-height: 24;
    stroke: Theme.current.accent_soft; stroke-width: 1.7px; fill: transparent;
    commands: root.glyph == "check" ? "M21 12a9 9 0 1 1-3-6.7M7 12l3 3 9-10"
        : root.glyph == "pause" ? "M8 5v14M16 5v14"
        : root.glyph == "play" ? "M8 5l11 7-11 7z"
        : root.glyph == "retry" ? "M20 10a8 8 0 1 0-1 8M20 4v6h-6"
        : root.glyph == "cancel" ? "M6 6l12 12M18 6L6 18"
        : root.glyph == "clock" ? "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0M12 6v6l4 2"
        : root.glyph == "up" ? "M5 15l7-7 7 7"
        : root.glyph == "down" ? "M5 9l7 7 7-7"
        : root.glyph == "delete" ? "M4 6h16M9 6V3h6v3M6 6l1 15h10l1-15M10 10v7M14 10v7"
        : root.glyph == "select" ? "M4 4h16v16H4z"
        : root.glyph == "selected" ? "M4 4h16v16H4zM7 12l3 3 7-7"
        : root.glyph == "drag" ? "M8 5h2M14 5h2M8 10h2M14 10h2M8 15h2M14 15h2M8 20h2M14 20h2"
        : "M12 3v12M7 10l5 5 5-5M5 16v5h14v-5";
}

export component DownloadIconButton inherits AddonIconButton {
    in property <string> label;
    in property <string> glyph;
    in property <bool> accent: false;
    name: root.label; width: 48px; height: 48px;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    DownloadGlyph {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        stroke: root.accent ? Theme.current.accent_soft : Theme.current.text_secondary;
    }
}

// The chapter row's download control: a 32px ring around a 20px glyph inside a
// 44px target. The ring shows the job (dashed and turning while queued, an arc
// for progress while running or paused, a red ring when failed) and the tap
// does the obvious next thing. State codes follow `ItemRow::download-state`:
// 0 none, 1 queued, 2 running, 3 paused, 4 failed, 5 complete, 6 cancelled.
export component DownloadRing inherits Rectangle {
    in property <int> state;
    in property <float> progress;
    in property <bool> enabled: true;
    // download, cancel, pause, resume, retry or menu (complete).
    callback activated(string);
    private property <bool> motion: Anim.enabled && Anim.player;
    private property <int> percent: Math.round(Math.clamp(root.progress, 0, 1) * 100);
    out property <string> action: root.state == 1 ? "cancel" : root.state == 2 ? "pause"
        : root.state == 3 ? "resume" : root.state == 4 ? "retry" : root.state == 5 ? "menu" : "download";
    out property <string> label: root.state == 1 ? @tr("Queued, cancel")
        : root.state == 2 ? @tr("Downloading {}%, pause", root.percent)
        : root.state == 3 ? @tr("Paused {}%, resume", root.percent)
        : root.state == 4 ? @tr("Download failed, retry")
        : root.state == 5 ? @tr("Downloaded, chapter options")
        : @tr("Download");
    // The arc follows progress smoothly rather than jumping between polls.
    private property <float> arc: Math.clamp(root.progress, 0, 1);
    animate arc { duration: root.motion ? Anim.player_fast : 0ms; easing: ease-out; }
    private property <angle> arc-end: (-90 + 360 * Math.min(root.arc, 0.9999)) * 1deg;
    // Completion pops the filled circle: 0.4 → past 1 → 1 on an overshooting curve.
    private property <float> pop: 1;
    private property <bool> popping: false;
    animate pop { duration: root.popping ? Anim.player_slide : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    changed state => {
        if root.state == 5 && root.motion {
            root.popping = false; root.pop = 0.4; pop-start.start();
        } else { root.popping = false; root.pop = 1; }
    }
    changed motion => { if !root.motion { pop-start.stop(); root.popping = false; root.pop = 1; } }
    pop-start := Timer {
        interval: 1ms; running: false;
        triggered => { self.stop(); root.popping = true; root.pop = 1; }
    }
    width: 44px; height: 44px; border-radius: 22px;
    background: touch.has-hover && root.enabled ? Theme.current.control_hover : transparent;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.activated(root.action); } }
    // Ring track: running and paused show the full track under the arc; failed
    // a faint red ring.
    if root.state == 2 || root.state == 3 || root.state == 4: Path {
        x: 6px; y: 6px; width: 32px; height: 32px;
        viewbox-width: 32; viewbox-height: 32;
        fill: transparent; stroke-width: 2.5px;
        stroke: root.state == 4 ? Theme.current.text_destructive.with-alpha(0.25) : Theme.current.progress_track_overlay;
        commands: "M 16 1.25 A 14.75 14.75 0 1 1 15.99 1.25 Z";
        accessible-role: none;
    }
    if (root.state == 2 || root.state == 3) && root.arc > 0: Path {
        x: 6px; y: 6px; width: 32px; height: 32px;
        viewbox-width: 32; viewbox-height: 32;
        fill: transparent; stroke-width: 2.5px;
        stroke: root.state == 2 ? Theme.current.accent_soft : Theme.current.text_muted;
        commands: "M 16 1.25 A 14.75 14.75 0 " + (root.arc > 0.5 ? "1" : "0") + " 1 "
            + (16 + 14.75 * Math.cos(root.arc-end)) + " " + (16 + 14.75 * Math.sin(root.arc-end));
        accessible-role: none;
    }
    // Queued: a dashed ring that turns slowly, only while animations run.
    if root.state == 1: Rectangle {
        x: 6px; y: 6px; width: 32px; height: 32px;
        transform-rotation: root.motion ? Math.mod(animation-tick() / 25ms, 360) * 1deg : 0deg;
        Path {
            width: 100%; height: 100%;
            viewbox-width: 32; viewbox-height: 32;
            fill: transparent; stroke-width: 2.5px; stroke: Theme.current.text_muted;
            commands: "M 17.54 1.33 A 14.75 14.75 0 0 1 24.03 3.63 M 27.46 6.72 A 14.75 14.75 0 0 1 30.43 12.93 M 30.67 17.54 A 14.75 14.75 0 0 1 28.37 24.03 M 25.28 27.46 A 14.75 14.75 0 0 1 19.07 30.43 M 14.46 30.67 A 14.75 14.75 0 0 1 7.97 28.37 M 4.54 25.28 A 14.75 14.75 0 0 1 1.57 19.07 M 1.33 14.46 A 14.75 14.75 0 0 1 3.63 7.97 M 6.72 4.54 A 14.75 14.75 0 0 1 12.93 1.57";
            accessible-role: none;
        }
    }
    // Complete: a filled accent circle in place of the ring.
    if root.state == 5: Rectangle {
        x: 9px; y: 9px; width: 26px; height: 26px; border-radius: 13px;
        background: Theme.current.accent.with-alpha(0.2);
        transform-scale: root.pop;
    }
    Path {
        x: 12px; y: 12px; width: 20px; height: 20px;
        viewbox-width: 24; viewbox-height: 24; fill: transparent; stroke-width: 2px;
        stroke: root.state == 4 ? Theme.current.text_destructive
            : root.state == 5 ? Theme.current.accent_soft
            : root.state == 2 ? Theme.current.accent_soft
            : root.state == 0 || root.state == 6 ? Theme.current.text_secondary
            : Theme.current.text_bright;
        commands: root.state == 1 ? "M12 7v5l3 2"
            : root.state == 2 ? "M9 7v10M15 7v10"
            : root.state == 3 ? "M9 6.5l9 5.5-9 5.5z"
            : root.state == 4 ? "M12 6v8M12 17.5v.5"
            : root.state == 5 ? "M7 12.5l3.2 3.2L17 9"
            : "M12 4v11M7 10l5 5 5-5M5 19h14";
        accessible-role: none;
    }
    key-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") && !e.repeat { root.activated(root.action); return accept; }
            return reject;
        }
    }
    forward-focus: key-focus;
    border-width: key-focus.has-focus ? 2px : 0px;
    border-color: Theme.current.focus_ring;
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { root.activated(root.action); }
    }
}
