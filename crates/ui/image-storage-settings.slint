// Nova's actual cache controls are owned by Kit; Reader owns labels and durable
// preferences for independent temporary namespaces and explicit offline jobs.
import { Dropdown } from "@NovaUiBase/dropdown.slint";
import { InterfaceStyle, Theme } from "@NovaUiShared";
import { SettingsCard, SectionHeader } from "@NovaUiBase/settings-controls.slint";
import { CacheDiskToggle, CacheDiskLimit, CacheCompressionToggle, CacheQualityControl, CacheMemoryControl, CacheResolutionControl, CacheClearControl } from "@NovaUiBase/cache-settings-controls.slint";
import { SettingsRow } from "settings-row.slint";

export global ImageStorageSettings {
    in-out property <bool> cache-enabled: true;
    in-out property <int> cache-format: 1;
    in-out property <float> cache-quality: 85;
    in-out property <bool> cache-jxl-lossless-jpeg: false;
    in-out property <bool> cache-lossless-inputs: false;
    in-out property <bool> downloads-enabled: false;
    in-out property <int> downloads-format: 1;
    in-out property <float> downloads-quality: 85;
    in-out property <bool> downloads-jxl-lossless-jpeg: false;
    in-out property <bool> downloads-lossless-inputs: false;
    in-out property <bool> disk-enabled: true;
    in-out property <[string]> disk-limit-names;
    in-out property <int> chapter-disk-limit-index: 3;
    in-out property <int> artwork-disk-limit-index: 3;
    in-out property <float> memory-budget: 128;
    in-out property <[string]> poster-resolution-names;
    in-out property <int> poster-resolution-index: 0;
    in-out property <string> chapter-cache-info;
    in-out property <string> chapter-cache-status;
    in-out property <bool> chapter-cache-busy: false;
    in-out property <string> thumbnail-cache-info;
    in-out property <string> thumbnail-cache-status;
    in-out property <bool> thumbnail-cache-busy: false;
    callback settings-changed(string, int);
    callback policy-changed();
    callback chapter-cache-refresh();
    callback chapter-cache-clear();
    callback thumbnail-cache-refresh();
    callback thumbnail-cache-clear();
}

export component ImageStorageSettingsPage inherits VerticalLayout {
    in property <bool> interactive: true;
    in property <bool> busy: false;
    in property <string> image-cache-info;
    in property <string> image-cache-status;
    callback image-cache-clear();
    private property <bool> maintenance: root.busy || ImageStorageSettings.chapter-cache-busy || ImageStorageSettings.thumbnail-cache-busy;
    spacing: 16px; alignment: start;
    init => { if root.interactive { ImageStorageSettings.chapter-cache-refresh(); ImageStorageSettings.thumbnail-cache-refresh(); } }
    changed interactive => { if root.interactive { ImageStorageSettings.chapter-cache-refresh(); ImageStorageSettings.thumbnail-cache-refresh(); } }
    SectionHeader { label: @tr("Chapter cache"); }
    SettingsCard {
        SettingsRow { setting-key: "reader:image-storage/policy/disk_enabled";
            row-title: @tr("Disk caching");
            row-desc: @tr("Keep viewed chapter pages, thumbnails and artwork on this device to reduce network use. Offline downloads stay independent.");
            CacheDiskToggle {
                busy: !root.interactive || root.maintenance;
                checked <=> ImageStorageSettings.disk-enabled;
                toggled => { ImageStorageSettings.settings-changed("disk_enabled", self.checked ? 1 : 0); }
            }
        }
        SettingsRow { setting-key: "reader:image-storage/policy/chapter_disk_limit_mb";
            row-title: @tr("Chapter disk-cache limit");
            row-desc: @tr("Remove older viewed chapters when this limit is exceeded. Downloaded chapters and local imports are preserved.");
            CacheDiskLimit {
                name: @tr("Chapter disk-cache limit"); keyboard-input-enabled: true;
                model: ImageStorageSettings.disk-limit-names;
                current-index <=> ImageStorageSettings.chapter-disk-limit-index;
                disk-enabled: ImageStorageSettings.disk-enabled;
                busy: !root.interactive || root.maintenance;
                selected(_) => { ImageStorageSettings.settings-changed("chapter_disk_limit_index", self.current-index); }
            }
        }
        SettingsRow {
            row-title: @tr("Chapter cache usage");
            row-desc: ImageStorageSettings.chapter-cache-info;
            CacheClearControl {
                label: @tr("Clear chapter cache");
                busy: !root.interactive || root.maintenance;
                clicked => { ImageStorageSettings.chapter-cache-clear(); }
            }
        }
        SettingsRow {
            row-title: @tr("Thumbnail cache");
            row-desc: (ImageStorageSettings.thumbnail-cache-info == "" ? "" : ImageStorageSettings.thumbnail-cache-info + "\n\n")
                + @tr("Thumbnails share the chapter disk-cache limit. Clear only generated previews; original pages, downloaded chapters and imports stay intact.");
            CacheClearControl {
                height: 48px; label: @tr("Clear thumbnails");
                busy: !root.interactive || root.maintenance;
                clicked => { ImageStorageSettings.thumbnail-cache-clear(); }
            }
        }
    }
    if ImageStorageSettings.chapter-cache-status != "": Text {
        text: ImageStorageSettings.chapter-cache-status;
        color: Theme.current.text_settings; wrap: word-wrap; min-width: 0px;
    }
    if ImageStorageSettings.thumbnail-cache-status != "": Text {
        text: ImageStorageSettings.thumbnail-cache-status;
        color: Theme.current.text_settings; wrap: word-wrap; min-width: 0px;
    }
    SectionHeader { label: @tr("Cache compression"); }
    SettingsCard {
        SettingsRow { setting-key: "reader:image-storage/cache/enabled";
            row-title: @tr("Compress new cached images");
            row-desc: @tr("Compress new temporary chapter pages and artwork. Existing files stay unchanged; unsupported images keep their original encoding.");
            CacheCompressionToggle {
                name: @tr("Compress new cached images");
                disk-enabled: ImageStorageSettings.disk-enabled; busy: !root.interactive || root.maintenance;
                checked <=> ImageStorageSettings.cache-enabled;
                toggled => { ImageStorageSettings.settings-changed("cache_enabled", self.checked ? 1 : 0); }
            }
        }
        cache_format_row := SettingsRow { setting-key: "reader:image-storage/cache/format";
            row-title: @tr("Cache format"); row-desc: @tr("JPEG, WebP, AVIF or JPEG XL for newly cached images.");
            cache_format := Dropdown {
                width: Math.min(252px, Math.max(0px, root.width - 32px)); roomy: true;
                model: [@tr("JPEG"), @tr("WebP"), @tr("AVIF"), @tr("JPEG XL")];
                enabled: !(!root.interactive || root.maintenance || !ImageStorageSettings.disk-enabled) && ImageStorageSettings.cache-enabled;
                current-index <=> ImageStorageSettings.cache-format;
                selected(i) => { ImageStorageSettings.settings-changed("cache_format", self.current-index); }
            }
        }
        cache_quality_row := SettingsRow { setting-key: "reader:image-storage/cache/quality";
            row-title: @tr("Cache quality"); row-desc: @tr("Higher values retain more detail and use more disk space.");
            CacheQualityControl {
                width: Math.min(InterfaceStyle.tv ? 320px : 252px, Math.max(0px, root.width - 32px));
                disk-enabled: ImageStorageSettings.disk-enabled; compression-enabled: ImageStorageSettings.cache-enabled;
                busy: !root.interactive || root.maintenance;
                name: @tr("Cache quality"); increase-label: @tr("Increase cache quality"); decrease-label: @tr("Decrease cache quality");
                value <=> ImageStorageSettings.cache-quality;
                changed(v) => { ImageStorageSettings.settings-changed("cache_quality", Math.round(v)); }
            }
        }
        if ImageStorageSettings.cache-format == 1 || ImageStorageSettings.cache-format == 3: cache_lossless_row := SettingsRow { setting-key: "reader:image-storage/cache/lossless_inputs";
            row-title: @tr("Lossless encoding for lossless inputs");
            row-desc: @tr("Preserve pixels from lossless PNG and WebP inputs. Lossy and unrecognized inputs use the selected quality. Unresized high-depth PNGs keep their original encoding.");
            CacheCompressionToggle {
                name: @tr("Lossless encoding for lossless inputs");
                busy: !root.interactive || root.maintenance || !ImageStorageSettings.disk-enabled || !ImageStorageSettings.cache-enabled;
                checked <=> ImageStorageSettings.cache-lossless-inputs;
                toggled => { ImageStorageSettings.settings-changed("cache_lossless_inputs", self.checked ? 1 : 0); }
            }
        }
        if ImageStorageSettings.cache-format == 3: cache_transcode_row := SettingsRow { setting-key: "reader:image-storage/cache/jxl_lossless_jpeg";
            row-title: @tr("Losslessly transcode JPEG");
            row-desc: @tr("Preserve original JPEG data when no resize is needed. Other images follow the cache compression settings.");
            CacheCompressionToggle {
                name: @tr("Losslessly transcode cache JPEG");
                busy: !root.interactive || root.maintenance || !ImageStorageSettings.disk-enabled || !ImageStorageSettings.cache-enabled;
                checked <=> ImageStorageSettings.cache-jxl-lossless-jpeg;
                toggled => { ImageStorageSettings.settings-changed("cache_jxl_lossless_jpeg", self.checked ? 1 : 0); }
            }
        }
    }
    SectionHeader { label: @tr("Artwork and memory"); }
    SettingsCard {
        SettingsRow { setting-key: "reader:image-storage/policy/artwork_disk_limit_mb";
            row-title: @tr("Artwork disk-cache limit");
            row-desc: @tr("Artwork has its own budget, so viewed chapter pages cannot evict library covers.");
            CacheDiskLimit {
                name: @tr("Artwork disk-cache limit"); keyboard-input-enabled: true;
                model: ImageStorageSettings.disk-limit-names;
                current-index <=> ImageStorageSettings.artwork-disk-limit-index;
                disk-enabled: ImageStorageSettings.disk-enabled;
                busy: !root.interactive || root.maintenance;
                selected(_) => { ImageStorageSettings.settings-changed("artwork_disk_limit_index", self.current-index); }
            }
        }
        SettingsRow { setting-key: "reader:image-storage/policy/poster_max_side";
            row-title: @tr("Poster resolution");
            row-desc: @tr("Limit the longest side of newly processed artwork. Original keeps source dimensions. Chapter pages always keep their original dimensions.");
            CacheResolutionControl {
                width: 100%; name: @tr("Poster resolution"); keyboard-input-enabled: true;
                model: ImageStorageSettings.poster-resolution-names;
                current-index <=> ImageStorageSettings.poster-resolution-index;
                busy: !root.interactive || root.maintenance;
                selected(_) => { ImageStorageSettings.settings-changed("poster_resolution_index", self.current-index); }
            }
        }
        SettingsRow { setting-key: "reader:image-storage/policy/decoded_memory_mb";
            row-title: @tr("Decoded-image budget");
            row-desc: @tr("Memory available for decoded artwork, independent of disk caching.");
            CacheMemoryControl {
                width: Math.min(InterfaceStyle.tv ? 320px : 252px, Math.max(0px, root.width - 32px));
                name: @tr("Decoded-image budget");
                increase-label: @tr("Increase decoded-image budget"); decrease-label: @tr("Decrease decoded-image budget");
                enabled: root.interactive;
                value <=> ImageStorageSettings.memory-budget;
                changed(v) => { ImageStorageSettings.settings-changed("memory_budget", Math.round(v)); }
            }
        }
        SettingsRow {
            row-title: @tr("Artwork cache");
            row-desc: (root.image-cache-info == "" ? "" : root.image-cache-info + "\n\n")
                + @tr("Covers are temporary and can be downloaded again. Downloaded chapters, imports and library data stay intact when you clear this cache.");
            CacheClearControl {
                label: @tr("Clear artwork cache");
                busy: !root.interactive || root.maintenance;
                clicked => { root.image-cache-clear(); }
            }
        }
    }
    if root.image-cache-status != "": Text {
        text: root.image-cache-status;
        color: Theme.current.text_settings; wrap: word-wrap; min-width: 0px;
    }
    SectionHeader { label: @tr("Download compression"); }
    SettingsCard {
        SettingsRow { setting-key: "reader:image-storage/downloads/enabled";
            row-title: @tr("Compress new chapter downloads");
            row-desc: @tr("Re-encode new chapter pages at their original dimensions before saving. Existing downloads stay unchanged; unsupported images keep their original encoding.");
            CacheCompressionToggle {
                name: @tr("Compress new chapter downloads");
                busy: !root.interactive; checked <=> ImageStorageSettings.downloads-enabled;
                toggled => { ImageStorageSettings.settings-changed("downloads_enabled", self.checked ? 1 : 0); }
            }
        }
        downloads_format_row := SettingsRow { setting-key: "reader:image-storage/downloads/format";
            row-title: @tr("Download format"); row-desc: @tr("JPEG, WebP, AVIF or JPEG XL for new offline chapter pages.");
            downloads_format := Dropdown {
                width: Math.min(252px, Math.max(0px, root.width - 32px)); roomy: true;
                model: [@tr("JPEG"), @tr("WebP"), @tr("AVIF"), @tr("JPEG XL")];
                enabled: !(!root.interactive) && ImageStorageSettings.downloads-enabled;
                current-index <=> ImageStorageSettings.downloads-format;
                selected(i) => { ImageStorageSettings.settings-changed("downloads_format", self.current-index); }
            }
        }
        downloads_quality_row := SettingsRow { setting-key: "reader:image-storage/downloads/quality";
            row-title: @tr("Download quality"); row-desc: @tr("Higher values retain more detail and use more disk space.");
            CacheQualityControl {
                width: Math.min(InterfaceStyle.tv ? 320px : 252px, Math.max(0px, root.width - 32px));
                busy: !root.interactive; compression-enabled: ImageStorageSettings.downloads-enabled;
                name: @tr("Download quality"); increase-label: @tr("Increase download quality"); decrease-label: @tr("Decrease download quality");
                value <=> ImageStorageSettings.downloads-quality;
                changed(v) => { ImageStorageSettings.settings-changed("downloads_quality", Math.round(v)); }
            }
        }
        if ImageStorageSettings.downloads-format == 1 || ImageStorageSettings.downloads-format == 3: downloads_lossless_row := SettingsRow { setting-key: "reader:image-storage/downloads/lossless_inputs";
            row-title: @tr("Lossless encoding for lossless inputs");
            row-desc: @tr("Preserve pixels from lossless PNG and WebP inputs. Lossy and unrecognized inputs use the selected quality. High-depth PNGs keep their original encoding.");
            CacheCompressionToggle {
                name: @tr("Lossless encoding for lossless download inputs");
                busy: !root.interactive || !ImageStorageSettings.downloads-enabled;
                checked <=> ImageStorageSettings.downloads-lossless-inputs;
                toggled => { ImageStorageSettings.settings-changed("downloads_lossless_inputs", self.checked ? 1 : 0); }
            }
        }
        if ImageStorageSettings.downloads-format == 3: downloads_transcode_row := SettingsRow { setting-key: "reader:image-storage/downloads/jxl_lossless_jpeg";
            row-title: @tr("Losslessly transcode JPEG");
            row-desc: @tr("Preserve original JPEG data when no resize is needed. Other images and resized JPEGs use the selected quality.");
            CacheCompressionToggle {
                name: @tr("Losslessly transcode download JPEG");
                busy: !root.interactive || !ImageStorageSettings.downloads-enabled;
                checked <=> ImageStorageSettings.downloads-jxl-lossless-jpeg;
                toggled => { ImageStorageSettings.settings-changed("downloads_jxl_lossless_jpeg", self.checked ? 1 : 0); }
            }
        }
    }
}
