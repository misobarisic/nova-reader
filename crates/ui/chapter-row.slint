import { ControlTouchArea } from "@NovaUiBase/control-input.slint";
// Compact chapter list requested from the Mihon reference; Nova Kit controls.
import { Theme, SettingsStyle } from "@NovaUiShared";
import { ItemRow } from "media-models.slint";
import { DownloadRing } from "download-controls.slint";
import { IconAction } from "controls.slint";
import { ChapterMenu } from "chapter-menu.slint";
export component ChapterRow inherits Rectangle {
    in property <ItemRow> chapter;
    callback picked;
    callback action(string);
    // Read state shows only in the text colour; the number column and the
    // title stay aligned whether or not a row has a status or progress.
    height: 68px; min-width: 0px;
    background: touch.feedback-active ? Theme.current.control_hover : transparent;
    border-radius: 14px;
    accessible-role: button; accessible-label: root.chapter.title;
    accessible-description: (root.chapter.read ? @tr("Read") : @tr("Unread"))
        + (root.chapter.status != "" ? " · " + root.chapter.status : "")
        + (root.chapter.chapter-meta != "" ? " · " + root.chapter.chapter-meta : "");
    accessible-action-default => { root.picked(); }
    private property <length> trailing: root.chapter.local-import ? 44px : 96px;
    chapter-number := Text {
        x: 0px; y: 0px; width: 38px; height: 100%;
        text: root.chapter.number;
        color: root.chapter.read ? Theme.current.text_hint : Theme.current.text_bright;
        font-size: 15px; font-weight: root.chapter.read ? 400 : 700;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
    VerticalLayout {
        x: 46px; y: 0px; width: max(1px, root.width - 46px - root.trailing - 4px); height: 100%;
        spacing: 3px; alignment: center;
        HorizontalLayout {
            spacing: 6px;
            if root.chapter.bookmarked: Path {
                width: 14px; height: 14px; y: 2px;
                viewbox-width: 24; viewbox-height: 24;
                fill: Theme.current.accent_vivid; stroke: transparent;
                commands: "M6 3h12v19l-6-4-6 4z";
                accessible-role: none;
            }
            chapter-title := Text {
                horizontal-stretch: 1; min-width: 0px;
                text: root.chapter.short-title != "" ? root.chapter.short-title : root.chapter.title;
                color: root.chapter.read ? Theme.current.text_muted : Theme.current.text_bright;
                font-size: 15px; overflow: elide;
            }
        }
        HorizontalLayout {
            spacing: 0px;
            if root.chapter.status != "": Text {
                text: root.chapter.status;
                color: root.chapter.status-danger ? Theme.current.text_destructive : Theme.current.accent_soft;
                font-size: 12px;
            }
            if root.chapter.status != "" && root.chapter.chapter-meta != "": Text {
                text: " · "; color: Theme.current.text_muted; font-size: 12px;
            }
            chapter-metadata := Text {
                horizontal-stretch: 1; min-width: 0px;
                text: root.chapter.chapter-meta; color: Theme.current.text_muted;
                font-size: 12px; overflow: elide;
            }
        }
        if root.chapter.read-fraction > 0: Rectangle {
            height: 7px;
            reading-progress := Rectangle {
                x: 0px; y: 4px; width: parent.width * 0.7; height: 3px; border-radius: 1.5px;
                background: Theme.current.progress_track_overlay;
                accessible-role: progress-indicator; accessible-label: @tr("Reading progress");
                accessible-value: Math.round(root.chapter.read-fraction * 100) + "%";
                Rectangle {
                    x: 0px; width: parent.width * Math.clamp(root.chapter.read-fraction, 0, 1); height: 100%;
                    border-radius: 1.5px; background: Theme.current.accent_soft;
                }
            }
        }
    }
    scope := FocusScope {
        changed has-focus => { if self.has-focus { SettingsStyle.reveal_control(root.absolute-position.y, root.height, false); } }
        key-pressed(e) => { if e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift) { root.open-menu(root.width - 22px, root.height / 2); return accept; } if e.text == Key.Return || e.text == " " { if !e.repeat { root.picked(); } return accept; } return reject; }
    }
    touch := ControlTouchArea {
        private property <bool> held: false;
        mouse-cursor: pointer;
        clicked => { if !self.held { root.picked(); } self.held = false; }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up { self.held = true; root.open-menu(self.mouse-x, self.mouse-y); }
            else if e.kind == PointerEventKind.down { self.held = false; hold.start(); }
            else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel { hold.stop(); }
        }
        moved => { if Math.abs(self.mouse-y - self.pressed-y) + Math.abs(self.mouse-x - self.pressed-x) > 24px { hold.stop(); } }
    }
    // The ⋯ menu covers the window so it can animate in and out and handle
    // outside taps itself; it grows from the press point within this row.
    in property <length> window-width;
    in property <length> window-height;
    in property <length> safe-top;
    in property <length> safe-bottom;
    private property <length> press-x;
    private property <length> press-y;
    function open-menu(x: length, y: length) { root.press-x = x; root.press-y = y; actions.show(); }
    actions := PopupWindow {
        x: -root.absolute-position.x; y: -root.absolute-position.y;
        width: root.window-width; height: root.window-height;
        close-policy: PopupClosePolicy.no-auto-close;
        ChapterMenu {
            width: 100%; height: 100%;
            chapter: root.chapter;
            anchor-x: root.absolute-position.x + root.press-x;
            anchor-y: root.absolute-position.y + root.press-y;
            row-left: root.absolute-position.x; row-top: root.absolute-position.y;
            row-width: root.width; row-height: root.height;
            safe-top: root.safe-top; safe-bottom: root.safe-bottom;
            picked(action) => { root.action(action); }
            closed => { actions.close(); }
        }
    }
    hold := Timer { interval: 600ms; running: false; triggered => { self.stop(); touch.held = true; root.open-menu(touch.mouse-x, touch.mouse-y); } }
    if !root.chapter.local-import: DownloadRing {
        x: root.width - 96px; y: (root.height - self.height) / 2;
        state: root.chapter.download-state; progress: root.chapter.download-progress;
        // A finished download's ring opens the chapter menu; every other state
        // runs its own next step (download, cancel, pause, resume, retry).
        activated(action) => { if action == "menu" { root.open-menu(self.x + self.width / 2, self.y + self.height / 2); } else { root.action(action); } }
    }
    IconAction { x: root.width - 44px; y: (root.height - self.height) / 2; width: 40px; height: 48px; text: @tr("Chapter options"); icon: @image-url("../../assets/icons/navigation/more.svg"); clicked => { root.open-menu(self.x + self.width / 2, self.y + self.height / 2); } }
}
