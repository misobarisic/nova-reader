import { StatusMenu } from "status-menu.slint";
import { ControlTouchArea } from "@NovaUiBase/control-input.slint";
import { Theme, SettingsStyle, Anim } from "@NovaUiShared";
import { ActionDialog } from "@NovaUiBase/action-dialog.slint";
import { ScrollView } from "@NovaUiBase/scrollview.slint";
import { PillButton } from "@NovaUiBase/settings-controls.slint";
import { EntryCategoryRow } from "@NovaUiShared";

struct EntryAction { label: string, id: string, enabled: bool }

// Nova's shared action sheet on touch layouts; the same actions stay anchored
// to the clicked title on desktop. Category editing keeps the stable target.
export component EntryMenu inherits Rectangle {
    in property <bool> narrow;
    in property <bool> editing;
    in property <bool> status-editing;
    in property <bool> in-library;
    in property <bool> collection;
    // Thumbnail density of the open gallery (0 smallest .. 2 largest columns).
    in property <int> density: 1;
    in property <int> presentation-choice;
    in property <string> title;
    in property <[EntryCategoryRow]> categories;
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <length> safe-bottom;
    in property <length> safe-left;
    in property <length> safe-right;
    callback picked(string);
    callback category-toggled(string);
    callback dismissed;
    // Open straight into the Presentation picker (the detail title menu's Layout).
    in property <bool> start-presentation;
    private property <int> selected: 0;
    private property <length> scroll-y: 0px;
    private property <length> list-height: 0px;
    private property <bool> presentation-editing;
    // Entrance: the desktop panel grows from the click and fades in, the phone
    // sheet rises; both match the title, chapter and page menus.
    private property <bool> motion: Anim.enabled && Anim.player;
    private property <float> progress: 0;
    animate progress { duration: root.motion ? Anim.player_fade : 0ms; easing: cubic-bezier(0.2, 0.85, 0.3, 1); }
    reveal := Timer { interval: 1ms; running: true; triggered => { self.stop(); root.progress = 1; } }
    private property <[EntryAction]> main-actions: [
        { label: @tr("Change status"), id: "change-status", enabled: root.in-library },
        { label: @tr("Categories"), id: "categories", enabled: root.in-library },
        { label: @tr("Mark all read"), id: "mark-all-read", enabled: true },
        { label: @tr("Mark all unread"), id: "mark-all-unread", enabled: true },
        { label: @tr("Clear all chapter positions"), id: "clear-all-positions", enabled: true },
        { label: @tr("Refresh details"), id: "refresh", enabled: true },
        { label: root.in-library ? @tr("Remove from library") : @tr("Add to library"), id: root.in-library ? "remove" : "add", enabled: true },
        { label: @tr("Presentation"), id: "presentation", enabled: true },
    ];
    private property <[EntryAction]> collection-actions: [
        { label: @tr("Smaller thumbnails"), id: "density-smaller", enabled: root.density > 0 },
        { label: @tr("Larger thumbnails"), id: "density-larger", enabled: root.density < 2 },
        { label: @tr("Metadata"), id: "details", enabled: true },
        { label: @tr("Download"), id: "download", enabled: true },
        { label: @tr("Change status"), id: "change-status", enabled: root.in-library },
        { label: @tr("Categories"), id: "categories", enabled: root.in-library },
        { label: @tr("Mark all read"), id: "mark-all-read", enabled: true },
        { label: @tr("Mark all unread"), id: "mark-all-unread", enabled: true },
        { label: @tr("Clear all chapter positions"), id: "clear-all-positions", enabled: true },
        { label: @tr("Refresh details"), id: "refresh", enabled: true },
        { label: root.in-library ? @tr("Remove from library") : @tr("Add to library"), id: root.in-library ? "remove" : "add", enabled: true },
        { label: @tr("Presentation"), id: "presentation", enabled: true },
    ];
    private property <[EntryAction]> actions: root.collection ? root.collection-actions : root.main-actions;
    private property <int> item-count: root.presentation-editing ? 3 : root.editing ? root.categories.length : root.actions.length;
    function pick-action(id: string) {
        if id == "presentation" {
            root.presentation-editing = true;
            root.selected = Math.clamp(root.presentation-choice, 0, 2);
            root.scroll-y = 0px; scope.focus();
        } else { root.picked(id); }
    }
    changed status-editing => { root.selected = 0; root.scroll-y = 0px; }
    if root.status-editing: StatusMenu {
        width: 100%; height: 100%;
        safe-bottom: root.safe-bottom; safe-left: root.safe-left; safe-right: root.safe-right;
        status-picked(code) => { root.picked("status:" + code); }
        closed => { root.dismissed(); }
    }
    init => {
        if root.start-presentation { root.pick-action("presentation"); }
        else if !root.narrow || root.editing { scope.focus(); }
    }
    changed editing => { root.selected = 0; if root.editing { scope.focus(); } }
    function reveal-selected() {
        if root.presentation-editing { return; }
        let count = root.item-count;
        // Done/Cancel is fixed outside the scroller and remains visible.
        if root.selected >= count { return; }
        let top = root.selected * 52px;
        if top < -root.scroll-y { root.scroll-y = -top; }
        else if top + 48px > -root.scroll-y + root.list-height {
            root.scroll-y = root.list-height - top - 48px;
        }
    }
    pure function action-icon(id: string) -> string {
        return id == "change-status" ? "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM8 12l3 3 5-6"
            : id == "categories" ? "M4 6h7v5H4zM13 6h7v5h-7zM4 13h7v5H4zM13 13h7v5h-7z"
            : id == "mark-all-read" ? "M21 12a9 9 0 1 1-3-6.7M7 12l3 3 9-10"
            : id == "mark-all-unread" ? "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0"
            : id == "clear-all-positions" ? "M3 12a9 9 0 1 0 3-6.7M3 4v5h5"
            : id == "refresh" ? "M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7"
            : id == "remove" ? "M5 12h14"
            : id == "add" ? "M12 5v14M5 12h14"
            : id == "presentation" ? "M4 4h7v16H4zM13 4h7v16h-7z"
            : id == "download" ? "M12 3v12M7 10l5 5 5-5M5 16v5h14v-5"
            : id == "details" ? "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 11v5M12 8v.01"
            : "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z";
    }
    if root.narrow && !root.editing && !root.status-editing && !root.presentation-editing: ActionDialog {
        width: 100%; height: 100%;
        title: root.title;
        safe-bottom: root.safe-bottom; safe-left: root.safe-left; safe-right: root.safe-right;
        rows: root.actions.length == 0 ? [] : root.collection ? [
            { label: root.collection-actions[0].label, enabled: root.collection-actions[0].enabled, icon: root.action-icon(root.collection-actions[0].id) },
            { label: root.collection-actions[1].label, enabled: root.collection-actions[1].enabled, icon: root.action-icon(root.collection-actions[1].id) },
            { label: root.collection-actions[2].label, enabled: root.collection-actions[2].enabled, icon: root.action-icon(root.collection-actions[2].id) },
            { label: root.collection-actions[3].label, enabled: root.collection-actions[3].enabled, icon: root.action-icon(root.collection-actions[3].id) },
            { label: root.collection-actions[4].label, enabled: root.collection-actions[4].enabled, icon: root.action-icon(root.collection-actions[4].id) },
            { label: root.collection-actions[5].label, enabled: root.collection-actions[5].enabled, icon: root.action-icon(root.collection-actions[5].id) },
            { label: root.collection-actions[6].label, enabled: root.collection-actions[6].enabled, icon: root.action-icon(root.collection-actions[6].id) },
            { label: root.collection-actions[7].label, enabled: root.collection-actions[7].enabled, icon: root.action-icon(root.collection-actions[7].id) },
            { label: root.collection-actions[8].label, enabled: root.collection-actions[8].enabled, icon: root.action-icon(root.collection-actions[8].id) },
            { label: root.collection-actions[9].label, enabled: root.collection-actions[9].enabled, icon: root.action-icon(root.collection-actions[9].id) },
            { label: root.collection-actions[10].label, enabled: root.collection-actions[10].enabled, danger: root.in-library, icon: root.action-icon(root.collection-actions[10].id) },
            { label: root.collection-actions[11].label, enabled: root.collection-actions[11].enabled, icon: root.action-icon(root.collection-actions[11].id) },
        ] : [
            { label: root.main-actions[0].label, enabled: root.main-actions[0].enabled, icon: root.action-icon(root.main-actions[0].id) },
            { label: root.main-actions[1].label, enabled: root.main-actions[1].enabled, icon: root.action-icon(root.main-actions[1].id) },
            { label: root.main-actions[2].label, enabled: root.main-actions[2].enabled, icon: root.action-icon(root.main-actions[2].id) },
            { label: root.main-actions[3].label, enabled: root.main-actions[3].enabled, icon: root.action-icon(root.main-actions[3].id) },
            { label: root.main-actions[4].label, enabled: root.main-actions[4].enabled, icon: root.action-icon(root.main-actions[4].id) },
            { label: root.main-actions[5].label, enabled: root.main-actions[5].enabled, icon: root.action-icon(root.main-actions[5].id) },
            { label: root.main-actions[6].label, enabled: root.main-actions[6].enabled, danger: root.in-library, icon: root.action-icon(root.main-actions[6].id) },
            { label: root.main-actions[7].label, enabled: root.main-actions[7].enabled, icon: root.action-icon(root.main-actions[7].id) },
        ];
        picked(index) => { root.pick-action(root.actions[index].id); }
        closed => { root.dismissed(); }
    }
    if (!root.narrow || root.editing || root.presentation-editing) && !root.status-editing: Rectangle {
        width: 100%; height: 100%;
        background: root.narrow ? Theme.current.scrim_shadow : transparent;
        TouchArea { width: 100%; height: 100%; clicked => { root.dismissed(); } }
        panel := Rectangle {
            width: min(root.narrow ? 560px : 340px, max(1px, root.width - root.safe-left - root.safe-right - 24px));
            height: min(root.height * 0.85, 94px + (root.presentation-editing ? 88px : (root.editing ? max(1,root.categories.length) : root.actions.length) * 52px) + (root.narrow ? root.safe-bottom : 0px));
            x: root.narrow ? root.safe-left + (root.width - root.safe-left - root.safe-right - self.width) / 2 : Math.clamp(root.anchor-x, 12px + root.safe-left, max(12px + root.safe-left, root.width - root.safe-right - self.width - 12px));
            y: root.narrow ? root.height - self.height + (root.motion ? (1 - root.progress) * 48px : 0px) : Math.clamp(root.anchor-y, 12px, max(12px,root.height - self.height - 12px));
            background: Theme.current.popup; border-radius: 14px;
            border-width: root.narrow ? 0px : 1px; border-color: Theme.current.border_soft;
            drop-shadow-offset-y: root.narrow ? 0px : 8px; drop-shadow-blur: root.narrow ? 0px : 24px; drop-shadow-color: #00000070;
            clip: true;
            opacity: root.motion ? root.progress : 1;
            transform-scale: root.narrow || !root.motion ? 1 : 0.4 + 0.6 * root.progress;
            transform-origin: { x: Math.clamp(root.anchor-x - self.x, 0px, self.width), y: Math.clamp(root.anchor-y - self.y, 0px, self.height) };
            accessible-role: groupbox; accessible-label: root.presentation-editing ? @tr("Choose presentation") : root.editing ? @tr("Edit categories") : @tr("Title actions");
            TouchArea { width: 100%; height: 100%; }
            Text { x: 16px; y: 8px; height: 30px; width: parent.width - 32px; text: root.presentation-editing ? @tr("Presentation") : root.editing ? @tr("Categories for {}", root.title) : root.title; color: Theme.current.text_muted; font-size: 12px; overflow: elide; vertical-alignment: center; }
            entry-scroll := ScrollView {
                content-y <=> root.scroll-y;
                init => { root.list-height = self.visible-height; }
                changed visible-height => { root.list-height = self.visible-height; root.reveal-selected(); }
                x: 8px; y: 38px; width: parent.width - 16px;
                height: max(1px, parent.height - 94px - (root.narrow ? root.safe-bottom : 0px));
                mouse-drag-pan-enabled: true;
                VerticalLayout {
                    spacing: 4px;
                    if !root.editing && !root.presentation-editing: VerticalLayout {
                        spacing: 4px;
                        for action[index] in root.actions: Rectangle {
                            height: 48px; border-radius: 8px;
                            background: action-touch.feedback-active || (scope.has-focus && SettingsStyle.keyboard-mode && root.selected == index) ? Theme.current.control_hover : transparent;
                            accessible-role: button; accessible-label: action.label; accessible-enabled: action.enabled;
                            accessible-action-default => { if action.enabled { root.pick-action(action.id); } }
                            Text { text: action.label; color: action.enabled ? Theme.current.text_primary : Theme.current.text_disabled; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                            action-touch := ControlTouchArea { enabled: action.enabled; mouse-cursor: pointer; clicked => { root.pick-action(action.id); } }
                        }
                    }
                    if root.presentation-editing: VerticalLayout {
                        spacing: 8px;
                        Text { height: 20px; text: @tr("Open this title as"); color: Theme.current.text_secondary; font-size: 13px; }
                        HorizontalLayout {
                            height: 48px; spacing: 8px;
                            for choice-label[index] in [@tr("Default"), @tr("Reader"), @tr("Gallery")]: PillButton {
                                height: 48px; btn_min_width: 48px; compact: true;
                                label: choice-label; primary: root.presentation-choice == index;
                                focused: scope.has-focus && SettingsStyle.keyboard-mode && root.selected == index;
                                accessible-action-default => { root.picked(index == 0 ? "presentation-default" : index == 1 ? "presentation-reader" : "presentation-gallery"); }
                                clicked => { root.picked(index == 0 ? "presentation-default" : index == 1 ? "presentation-reader" : "presentation-gallery"); }
                            }
                        }
                    }
                    if root.editing: VerticalLayout {
                        spacing: 4px;
                        if root.categories.length == 0: Text { height: 48px; text: @tr("Create categories in More → Categories."); color: Theme.current.text_muted; wrap: word-wrap; }
                        for category[index] in root.categories: Rectangle {
                            height: 48px; border-radius: 8px;
                            background: category-touch.feedback-active || (scope.has-focus && SettingsStyle.keyboard-mode && root.selected == index) ? Theme.current.control_hover : category.checked ? Theme.current.selection_wash : transparent;
                            accessible-role: checkbox; accessible-label: category.label;
                            accessible-checkable: true; accessible-checked: category.checked;
                            accessible-action-default => { root.category-toggled(category.id); }
                            Rectangle { x: 14px; y: 14px; width: 20px; height: 20px; border-radius: 4px; border-width: 2px; border-color: Theme.current.accent; background: category.checked ? Theme.current.accent : transparent;
                                if category.checked: Path {
                                    x: 3px; y: 3px; width: 14px; height: 14px; viewbox-width: 24; viewbox-height: 24;
                                    fill: transparent; stroke: Theme.current.on_accent; stroke-width: 3px; commands: "M5 12l5 5 9-10";
                                    accessible-role: none;
                                }
                            }
                            Text { x: 48px; width: parent.width - 64px; height: 100%; text: category.label; color: Theme.current.text_primary; vertical-alignment: center; overflow: elide; }
                            category-touch := ControlTouchArea { mouse-cursor: pointer; clicked => { root.category-toggled(category.id); } }
                        }
                    }
                }
            }
            Rectangle {
                x: 8px; y: parent.height - 52px - (root.narrow ? root.safe-bottom : 0px); width: parent.width - 16px; height: 48px; border-radius: 8px;
                background: done-touch.feedback-active || (scope.has-focus && SettingsStyle.keyboard-mode && root.selected == root.item-count) ? Theme.current.control_hover : transparent;
                border-width: scope.has-focus && SettingsStyle.keyboard-mode && root.selected == root.item-count ? 2px : 0px;
                border-color: Theme.current.focus_ring;
                accessible-role: button; accessible-label: root.editing ? @tr("Done") : @tr("Cancel");
                accessible-action-default => { root.dismissed(); }
                Text { text: root.editing ? @tr("Done") : @tr("Cancel"); color: Theme.current.accent; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                done-touch := ControlTouchArea { mouse-cursor: pointer; clicked => { root.dismissed(); } }
            }
        }
    }
    scope := FocusScope {
        width: 0px; height: 0px;
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace { if !event.repeat { root.dismissed(); } return accept; }
            if root.presentation-editing && (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                SettingsStyle.keyboard-mode = true;
                root.selected = Math.clamp(root.selected + (event.text == Key.LeftArrow ? -1 : 1), 0, 2); return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                SettingsStyle.keyboard-mode = true;
                root.selected = Math.clamp(root.selected + (event.text == Key.UpArrow ? -1 : 1),0,root.item-count);
                root.reveal-selected(); return accept;
            }
            if event.text == Key.Return || event.text == " " {
                if !event.repeat {
                    if root.presentation-editing {
                        if root.selected < 3 { root.picked(root.selected == 0 ? "presentation-default" : root.selected == 1 ? "presentation-reader" : "presentation-gallery"); } else { root.dismissed(); }
                    } else if root.editing {
                        if root.selected < root.categories.length { root.category-toggled(root.categories[root.selected].id); } else { root.dismissed(); }
                    } else if root.selected < root.actions.length { if root.actions[root.selected].enabled { root.pick-action(root.actions[root.selected].id); } } else { root.dismissed(); }
                }
                return accept;
            }
            return reject;
        }
    }
}
