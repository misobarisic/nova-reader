    public function go-back() {
        // The startup picker cannot be dismissed without choosing a profile.
        if ProfilesBridge.require-selection && root.section == 24 && !root.action-confirm-open { return; }
        if root.action-confirm-open { root.resolve-action-confirm(1); return; }
        if BackupBridge.confirm_open { root.resolve-restore-confirm(1); return; }
        if root.download-confirm-open { root.resolve-download-confirm(1); return; }
        if root.export-conflict-open { root.resolve-export-conflict(2); return; }
        if root.title-menu-open { root.title-menu-open = false; keyboard.focus(); return; }
        // Back leaves chapter selection before it leaves the title.
        if root.section == 5 && root.chapter-selecting { root.chapter-selection("clear", -1); return; }
        if root.capture-editor-visible {
            root.capture-editor-action(root.capture-editor-preview-mode ? "adjust" : "cancel"); return;
        }
        if SettingsSync.open { SettingsSync.open = false; return; }
        if SyncContent.sync_remove_prompt_visible {
            SyncContent.sync_remove_prompt_visible = false;
            SyncContent.sync_remove_prompt_id = "";
            SyncContent.sync_remove_prompt_name = "";
            return;
        }
        if root.section == 20 && ReaderSyncSettings.sync_pair_prompt_visible {
            ReaderSyncSettings.sync_respond_pair(ReaderSyncSettings.sync_pair_prompt_id, false); return;
        }
        if root.section == 6 && root.show-reader-options { root.show-reader-options = false; return; }
        if root.section == 6 && root.reader-osd { root.reader-osd = false; return; }
        if root.section == 13 { root.about-back-request += 1; return; }
        if root.section == 24 && ProfilesBridge.step-back() { return; }
