export struct TileRow { image: image, offset: float, fraction: float, left: float, right: float, bottom: float }
export struct ReaderBoundaryRow { position: float, previous: string, next: string }
export struct PageRow { tiles:[TileRow], page-id: string, image: image, ratio: float, position: float, loaded: bool, preview: bool, error: string }
export struct ReaderCaptureViewport { x: float, y: float, width: float, height: float, content-x: float, content-y: float }
export { SettingRow } from "@NovaUiShared";
import { SettingRow } from "@NovaUiShared";

export component AppWindow inherits Window {
    title: "Nova Reader";
    in-out property <bool> touch-menus <=> ControlInput.touch-feedback;
    in property <string> app-version;
    in-out property <[OverviewTile]> overview-tiles;
    in-out property <string> overview-title;
    in-out property <string> overview-subtitle;
    in-out property <bool> overview-collection;
    in-out property <bool> overview-rtl;
    in-out property <bool> overview-busy;
    in-out property <string> overview-status;
    in-out property <int> overview-current-index: -1;
    in-out property <int> overview-density: 1;
    in-out property <int> overview-origin: 0;
    in-out property <int> overview-focus-request;
    in-out property <int> overview-restore-index: -1;
    in-out property <float> overview-restore-fraction;
    in-out property <int> overview-restore-serial;
    in-out property <[string]> overview-groups;
    in-out property <int> overview-group-index;
    callback overview-selected(string);
    callback overview-visible-range(int, int, int);
    callback overview-anchor(string, float);
    callback overview-density-changed(int);
    callback overview-zoom-requested(int, string, float);
    callback overview-group-selected(int);
    callback overview-back();
    callback overview-current();
    callback overview-menu();
    callback overview-retry();

    in-out property <[string]> license-text-chunks;
    in-out property <[LicenseSource]> license-sources;
    in-out property <bool> about-licenses-open: false;
    in-out property <length> about-scroll-y: 0px;
    in-out property <length> about-licenses-scroll-y: 0px;
    in-out property <int> about-back-request: 0;
    in-out property <bool> about-update-checks-enabled: false;
    callback license-source-requested(string);
    in-out property <bool> export-conflict-open: false;
    in-out property <string> export-conflict-name;
    callback export-conflict-choice(int);
    in property <bool> update-checking: false;
    // The backup flow asks through the shared sheet before it changes data.
    function resolve-restore-confirm(choice: int) {
        if !BackupBridge.confirm_open { return; }
        BackupBridge.confirm_open = false;
        BackupBridge.confirm_choice(choice);
    }
    in-out property <bool> download-confirm-open: false;
    in-out property <string> download-confirm-message;
    callback download-confirm-choice(int);
    function resolve-download-confirm(choice: int) {
        if !root.download-confirm-open { return; }
        root.download-confirm-open = false;
        root.download-confirm-choice(choice);
    }
    // One sheet confirms every destructive action that has no undo. The pending
    // call is captured when the sheet opens, so list reorders cannot retarget it.
    private property <bool> action-confirm-open: false;
    private property <string> action-confirm-prompt;
    private property <string> action-confirm-label;
    private property <string> action-confirm-kind;
    private property <string> action-confirm-a;
    private property <string> action-confirm-b;
    private property <int> action-confirm-index;
    // Public so the separately compiled Browse page can ask too.
    public function ask-confirm(kind: string, a: string, b: string, index: int, prompt: string, label: string) {
        root.action-confirm-kind = kind; root.action-confirm-a = a; root.action-confirm-b = b;
        root.action-confirm-index = index; root.action-confirm-prompt = prompt;
        root.action-confirm-label = label; root.action-confirm-open = true;
    }
    function resolve-action-confirm(choice: int) {
        if !root.action-confirm-open { return; }
        root.action-confirm-open = false;
        if choice == 0 {
            if root.action-confirm-kind == "extension" { root.extension-action(root.action-confirm-a, root.action-confirm-b); }
            else if root.action-confirm-kind == "source" { root.source-action(root.action-confirm-a); }
            else if root.action-confirm-kind == "library" { root.toggle-library(); }
            else if root.action-confirm-kind == "entry" { root.entry-action(root.action-confirm-a, root.action-confirm-b); }
            else if root.action-confirm-kind == "chapter" { root.item-action(root.action-confirm-index, root.action-confirm-a); }
            else if root.action-confirm-kind == "selection" { root.chapter-selection(root.action-confirm-a, -1); }
            else if root.action-confirm-kind == "profile" { ProfilesBridge.delete-profile(root.action-confirm-a); }
        }
        keyboard.focus();
    }
    function confirm-entry-action(key: string, action: string) {
        if action == "remove" { root.ask-confirm("entry", key, action, 0, @tr("Remove this title from your library?"), @tr("Remove from library")); }
        else if action == "mark-all-read" { root.ask-confirm("entry", key, action, 0, @tr("Mark every chapter of this title as read?"), @tr("Mark all read")); }
        else if action == "mark-all-unread" { root.ask-confirm("entry", key, action, 0, @tr("Mark every chapter of this title as unread?"), @tr("Mark all unread")); }
        else { root.ask-confirm("entry", key, action, 0, @tr("Clear every saved reading position for this title?"), @tr("Clear all chapter positions")); }
    }
    function resolve-export-conflict(choice: int) {
        if !root.export-conflict-open { return; }
        root.export-conflict-open = false;
        root.export-conflict-choice(choice);
        keyboard.focus();
    }
    in-out property <string> image-cache-info;
    in-out property <string> image-cache-status;
    in-out property <bool> image-cache-busy;
    callback image-cache-refresh;
    callback image-cache-clear;
    min-width: 320px;
    min-height: 240px;
    preferred-width: 1120px;
    preferred-height: 780px;
    background: Theme.current.artwork_canvas;
    default-font-family: "Roboto";
    default-font-size: 14px;
    in-out property <int> section: 0;
    in property <int> detail-origin: 0;
    in property <string> heading: @tr("Your library");
    in property <string> caption: @tr("A home for your next chapter.");
    in property <string> status;
    in property <bool> busy;
    in property <bool> reader-opening;
    in property <string> reader-open-error;
    in-out property <int> reader-return-section: 5;
    in-out property <bool> reader-collection;
    in-out property <int> reader-gallery-group-count;
    callback reader-retry-open;
    private property <bool> reader-initial-content: root.pages.length > 0 &&
        (root.pages[root.current-page].loaded || root.pages[root.current-page].preview || root.pages[root.current-page].error != "");
    private property <bool> reader-entry-revealed: true;
    private property <float> reader-entry-fade: root.reader-entry-revealed ? 1 : 0;
    out property <float> reader-entry-opacity: Anim.enabled && Anim.transitions ? root.reader-entry-fade : 1;
    animate reader-entry-fade { duration: root.reader-entry-revealed ? 160ms : 0ms; easing: ease-out; }
    public function begin-reader-entry() { root.reader-entry-revealed = false; }
    changed reader-initial-content => { if root.reader-initial-content { root.reader-entry-revealed = true; } }
    in-out property <bool> addon-zip-import-busy <=> BrowseBridge.addon-zip-import-busy;
    // Nova detail.slint defers its entrance by 40ms so the initial opacity
    // is painted before the shared transition fade starts.
    private property <bool> detail-motion: Anim.enabled && Anim.transitions;
    private property <bool> detail-entry-animate: false;
    private property <bool> detail-entered: true;
    private property <float> detail-fade: root.detail-entered ? 1 : 0;
    private property <float> detail-opacity: root.detail-motion && root.detail-entry-animate ? root.detail-fade : 1;
    animate detail-fade { duration: root.detail-entry-animate && root.detail-entered ? Anim.transition_fade : 0ms; }
    function begin-detail-entry() {
        detail-enter-timer.stop();
        root.detail-entry-animate = root.detail-motion;
        root.detail-entered = !root.detail-motion;
        if root.detail-motion { detail-enter-timer.start(); }
    }
    changed detail-motion => {
        if !root.detail-motion {
            detail-enter-timer.stop();
            root.detail-entry-animate = false;
            root.detail-entered = true;
        }
    }
    detail-enter-timer := Timer {
        interval: 40ms; running: false;
        triggered => { self.stop(); if root.section == 5 { root.detail-entered = true; } }
    }
    in property <[ItemRow]> items;
    in-out property <[string]> sources <=> BrowseBridge.sources;
    in-out property <[SourceRow]> source-rows <=> BrowseBridge.source-rows;
    in-out property <[ExtensionRow]> extensions <=> BrowseBridge.extensions;
    in-out property <int> browse-tab <=> BrowseBridge.browse-tab;
    callback source-pin-picked(string);
    callback source-latest-selected(int);
    callback extension-action(string,string);
    in-out property <int> source-index <=> BrowseBridge.source-index;
    in-out property <bool> source-catalog-open <=> BrowseBridge.source-catalog-open;
    in-out property <string> source-title <=> BrowseBridge.source-title;
    in-out property <bool> source-has-filters <=> BrowseBridge.source-has-filters;
    in-out property <[SettingRow]> source-filters <=> BrowseBridge.source-filters;
    in-out property <string> source-filter-notice <=> BrowseBridge.source-filter-notice;
    in-out property <bool> source-filters-open <=> BrowseBridge.source-filters-open;
    in-out property <string> source-catalogue-kind <=> BrowseBridge.source-catalogue-kind;
    in-out property <length> catalogue-scroll-y <=> BrowseBridge.catalogue-scroll-y;
    in-out property <string> source-query <=> BrowseBridge.source-query;
    in-out property <string> catalogue-page-error <=> BrowseBridge.catalogue-page-error;
    private property <bool> catalogue-restore-pending <=> BrowseBridge.catalogue-restore-pending;
    public function prepare-catalogue-return() { root.catalogue-restore-pending = true; }
    public function reset-catalogue-scroll() { root.catalogue-restore-pending = false; root.catalogue-scroll-y = 0px; }
    callback source-filters-requested;
    callback source-filter-changed(string,string);
    callback source-filter-selected(string,int);
    callback source-filters-applied;
    in property <string> series-title;
    // Counts for the chapter filter empty state; Rust refreshes them with the rows.
    in property <int> detail-unread-count;
    in property <int> detail-downloaded-count;
    in property <int> detail-bookmarked-count;
    // Each chapter's place among the rows the Unread/Downloaded/Bookmarked
    // filters show (`publish_chapter_filter_counts`), for the two-column list.
    in property <[int]> detail-rank-unread;
    in property <[int]> detail-rank-downloaded;
    in property <[int]> detail-rank-bookmarked;
    in property <int> detail-new-count;
    // Multi-chapter selection on the detail screen; the backend owns it.
    in property <bool> chapter-selecting;
    in property <int> chapter-selected-count;
    callback chapter-selection(string, int);
    // The open title's unfinished downloads, as a card above its chapters.
    in property <bool> detail-queue-visible;
    in property <string> detail-queue-title;
    in property <string> detail-queue-counts;
    in property <string> detail-queue-failed;
    in property <float> detail-queue-progress;
    in property <bool> detail-queue-running;
    in property <bool> detail-queue-pausable;
    callback detail-queue-action(string);
    in property <string> detail-series-key;
    in-out property <bool> detail-gallery-single;
    in-out property <length> detail-scroll-y: 0px;
    in-out property <bool> detail-synopsis-expanded: false;
    private property <bool> detail-restore-pending: false;
    changed detail-series-key => {
        root.detail-scroll-y = 0px;
        root.detail-synopsis-expanded = false;
        if root.section == 5 { root.detail-restore-pending = true; root.begin-detail-entry(); }
    }
    in property <string> series-description;
    in property <string> resume-chapter;
    in property <string> resume-action-label: root.resume-chapter == "" ? @tr("Continue") : @tr("Continue chapter {}",root.resume-chapter);
    in property <string> series-metadata;
    in property <[string]> series-genres;
    in property <string> series-artwork-key;
    in-out property <image> series-poster;
    // A few-pixel copy of the poster for the desktop detail backdrop.
    in-out property <image> series-backdrop;
    in-out property <int> chapter-filter;
    in-out property <bool> chapters-descending: true;
    in property <bool> in-library;
    in-out property <bool> has-more <=> BrowseBridge.has-more;
    in-out property <bool> show-adult <=> BrowseBridge.show-adult;
    in property <[PageRow]> pages;
    in property <float> total-ratio;
    in-out property <length> scroll-y: 0px;
    in-out property <int> current-page: 0;
    in-out property <int> reading-mode: 0;
    // Actual renderer modes stay 0–3; index 4 is a persisted Automatic choice.
    in-out property <int> reader-mode-choice: 6;
    in-out property <int> reader-rotation-choice: -1;
    // History's ⋯ menu opens this from Rust; the sheet below confirms.
    in-out property <bool> clear-history-confirm-open: false;
    in-out property <string> reader-mode-label: @tr("Webtoon");
    in-out property <string> reader-chapter-title;
    in-out property <bool> reader-bookmarked: false;
    in-out property <float> reader-progress: 0;
    in-out property <int> reader-local-page: 1;
    in-out property <int> reader-page-count: 0;
    in-out property <[ReaderBoundaryRow]> reader-boundaries;
    private property <bool> reader-transition-open: false;
    private property <string> reader-transition-from;
    private property <string> reader-transition-to;
    public function show-reader-transition(previous: string, next: string) {
        if root.reading-mode != 0 && ReaderSettings.chapter-transition {
            root.reader-transition-from = previous;
            root.reader-transition-to = next;
            root.reader-transition-open = true;
            reader-transition-timer.restart();
        }
    }
    reader-transition-timer := Timer { interval: 2400ms; running: false; triggered => { root.reader-transition-open = false; self.stop(); } }
    in-out property <string> reader-continuation-error;
    callback retry-continuation;
    in-out property <color> reader-background: #000000;
    in-out property <bool> reader-window-fullscreen: false;
    in-out property <int> reader-side-padding: 0;
    in-out property <float> reader-gap: 0;
    in-out property <bool> reader-double-tap-enabled: true;
    in-out property <length> scroll-x: 0px;
    in-out property <int> reader-orientation: 0;
    in-out property <bool> reader-platform-android: false;
    in-out property <bool> reader-split-page: false;
    in-out property <int> reader-split-half: 0;
    out property <length> reader-canvas-width: !root.reader-platform-android && (root.reader-orientation == 2 || root.reader-orientation == 4 || root.reader-orientation == 6) ? min(root.width,root.height * 0.72) : root.width;
    out property <length> reader-canvas-height: !root.reader-platform-android && (root.reader-orientation == 3 || root.reader-orientation == 5) ? min(root.height,root.width * 0.625) : root.height;
    callback reader-action(string);
    callback reader-seek(float);
    callback reader-tap(float,float);
    callback reader-double-tap(float,float);
    callback reader-zoom-by(float,float,float);
    callback reader-transform(float,float,float,float,float);
    // Reader gestures follow the same motion policy as gallery paging.
    out property <bool> reader-zoom-motion: Anim.enabled && ReaderSettings.page-animations;
    in-out property <bool> reader-zoom-animating: false;
    private property <float> reader-zoom-progress: 0;
    callback reader-zoom-frame(float);
    callback reader-zoom-cancel(bool);
    animate reader-zoom-progress { duration: root.reader-zoom-animating ? 200ms : 0ms; easing: ease-out; }
    changed reader-zoom-progress => {
        if root.reader-zoom-animating { root.reader-zoom-frame(root.reader-zoom-progress); }
    }
    public function start-reader-zoom() {
        root.reader-zoom-animating = false;
        root.reader-zoom-progress = 0;
        root.reader-zoom-animating = true;
        reader-zoom-start.start();
    }
    public function cancel-reader-zoom() {
        reader-zoom-start.stop();
        if root.reader-zoom-animating {
            root.reader-zoom-animating = false;
            root.reader-zoom-cancel(false);
        }
    }
    public function finish-reader-zoom() {
        reader-zoom-start.stop();
        if root.reader-zoom-animating {
            root.reader-zoom-animating = false;
            root.reader-zoom-cancel(true);
        }
    }
    changed reader-zoom-motion => { if !root.reader-zoom-motion { root.finish-reader-zoom(); } }
    changed current-page => { root.cancel-reader-zoom(); }
    changed reading-mode => { root.cancel-reader-zoom(); }
    reader-zoom-start := Timer { interval: 1ms; running: false; triggered => { self.stop(); root.reader-zoom-progress = 1; } }
    callback reader-rotation-changed(int);
    private property <int> reader-settings-tab: 0;
    private property <bool> reader-flash-active: false;
    private property <bool> reader-page-entered: true;
    private property <bool> reader-page-motion: false;
    private property <float> reader-page-opacity: root.reader-page-entered ? 1 : 0;
    private property <bool> reader-gallery-committing;
    animate reader-page-opacity { duration: root.reader-page-motion && ReaderSettings.page-animations ? 150ms : 0ms; easing: ease-out; }
    public function animate-reader-page() { if root.reading-mode != 0 && ReaderSettings.page-animations && !root.reader-gallery-committing { root.reader-page-motion = false; root.reader-page-entered = false; reader-page-animation-timer.start(); } }
    reader-page-animation-timer := Timer { interval: 16ms; triggered => { root.reader-page-motion = true; root.reader-page-entered = true; } }
    public function flash-reader-page() { if ReaderSettings.page-flash { root.reader-flash-active = true; reader-flash-timer.restart(); } }
    reader-flash-timer := Timer { interval: 100ms; triggered => { root.reader-flash-active = false; } }
    in-out property <float> zoom: 1;
    in property <bool> can-previous;
    in property <bool> can-next;
    in-out property <string> path-text;
    in-out property <string> category-text;
    in property <[string]> categories;
    // Titles per category chip (All, statuses, user categories), ignoring search.
    in property <[int]> category-counts;
    // "N titles" beside the Library heading.
    in property <string> library-count-label;
    in-out property <int> category-index: 0;
    in-out property <bool> entry-menu-visible: false;
    in-out property <int> entry-menu-presentation;
    callback entry-menu-requested(string);
    in property <[EntryCategoryRow]> entry-categories;
    private property <string> entry-menu-key;
    private property <string> entry-menu-title;
    private property <bool> entry-menu-library;
    private property <bool> entry-menu-editing;
    private property <bool> entry-menu-status-editing;
    private property <length> entry-menu-x;
    private property <bool> entry-menu-presentation-start;
    // The title menu: the detail screen's ⋯ and a hold or right-click on a
    // Library title. Rust publishes the summary and download counts for
    // `title-menu-key` (`title-menu-requested`).
    in-out property <bool> title-menu-open;
    in-out property <string> title-menu-key;
    private property <string> title-menu-title;
    private property <bool> title-menu-library;
    // The title's reading status action code (-1 when not in the library).
    in property <int> title-menu-status;
    private property <length> title-menu-right;
    private property <length> title-menu-bottom;
    private property <length> title-menu-origin;
    callback title-menu-requested(string);
    public function open-title-menu(key: string, title: string, in-library: bool, right: length, bottom: length, origin-x: length) {
        if key == "" { return; }
        root.title-menu-origin = origin-x;
        root.title-menu-key = key; root.title-menu-title = title; root.title-menu-library = in-library;
        root.title-menu-right = right; root.title-menu-bottom = bottom;
        root.title-menu-requested(key);
        root.title-menu-open = true;
    }
    in property <string> detail-menu-summary;
    in property <int> detail-unread-to-download;
    in property <int> detail-all-to-download;
    function title-menu-picked(action: string) {
        let key = root.title-menu-key;
        // Status, layout and category choices come from the menu's own
        // pages and go straight to the backend, like Download's.
        if action == "remove" || action == "mark-all-read" || action == "mark-all-unread" || action == "clear-all-positions" {
            root.confirm-entry-action(key, action);
        } else if action == "delete-read-downloads" {
            root.ask-confirm("entry", key, action, 0, @tr("Delete the downloads of read chapters from this device? Bookmarked chapters keep theirs."), @tr("Delete read downloads"));
        } else {
            root.entry-action(key, action);
        }
    }
    private property <length> entry-menu-y;
    callback entry-action(string,string);
    public function open-entry-menu(key: string,title: string,in-library: bool,x: length,y: length) {
        if key == "" { return; }
        root.entry-menu-key = key; root.entry-menu-title = title;
