import { Spinner } from "std-widgets.slint";
import { Theme, SettingsStyle } from "@NovaUiShared";
import { ScrollView } from "@NovaUiBase/scrollview.slint";
import { ReaderField as LineEdit, ReaderSelect as ComboBox, ReaderToggle as CheckBox } from "controls.slint";
import { PageHeader } from "page-header.slint";
import { SourceRow, ExtensionRow } from "media-models.slint";
export { SourceRow, ExtensionRow } from "media-models.slint";
import { SourceList } from "source-list.slint";
import { ExtensionList } from "extensions.slint";
import { Segmented } from "@ReaderSegmented";
import { ItemRow } from "media-models.slint";
export { ItemRow } from "media-models.slint";
import { Appearance } from "appearance.slint";
import { SeriesGrid, LibraryViewSwitch } from "library-cards.slint";
import { DetailHero } from "detail-hero.slint";
import { ChapterRow } from "chapter-row.slint";
import { SettingsCard } from "@NovaUiBase/settings-controls.slint";
import { SourceFilterPanel } from "source-filters.slint";
import { TimelineList } from "timeline.slint";
import { ReaderContextMenu, ReaderImageInteraction } from "reader-context-menu.slint";
import { SaveConflictSheet } from "save-conflict-sheet.slint";
import { LibraryFilterChip } from "@NovaUiBase/filter-chip.slint";
import { LibrarySearchReveal } from "library-search.slint";
import { EntryMenu, EntryCategoryRow } from "entry-menu.slint";
export { EntryCategoryRow } from "entry-menu.slint";
import { MorePage } from "more.slint";
import { LicenseSource } from "about-models.slint";
export { LicenseSource } from "about-models.slint";
export { Appearance } from "appearance.slint";
export { CaptureSettings } from "capture-settings.slint";
export { ImageStorageSettings } from "image-storage-settings.slint";
export { Theme, Anim } from "@NovaUiShared";
import "../../assets/fonts/Roboto-Regular.ttf";
import "../../assets/fonts/Roboto-Bold.ttf";
import { ActionButton, IconAction, BackButton, MenuLink } from "controls.slint";
import { DesktopSidebar, MobileNavigation } from "navigation.slint";

export struct TileRow { image: image, offset: float, fraction: float, left: float, right: float, bottom: float }
export struct PageRow { tiles:[TileRow], page-id: string, image: image, ratio: float, position: float, loaded: bool, error: string }
export struct ReaderCaptureViewport { x: float, y: float, width: float, height: float, content-x: float, content-y: float }
export { SettingRow } from "media-models.slint";
import { SettingRow } from "media-models.slint";

export component AppWindow inherits Window {
    title: "Nova Reader";
    in property <string> app-version;
    in-out property <[string]> license-text-chunks;
    in-out property <[LicenseSource]> license-sources;
    in-out property <bool> about-licenses-open: false;
    in-out property <length> about-scroll-y: 0px;
    in-out property <length> about-licenses-scroll-y: 0px;
    in-out property <int> about-back-request: 0;
    in-out property <bool> about-update-checks-enabled: false;
    callback license-source-requested(string);
    in-out property <bool> export-conflict-open: false;
    in-out property <string> export-conflict-name;
    callback export-conflict-choice(int);
    function resolve-export-conflict(choice: int) {
        if !root.export-conflict-open { return; }
        root.export-conflict-open = false;
        root.export-conflict-choice(choice);
        keyboard.focus();
    }
    in-out property <string> image-cache-info;
    in-out property <string> image-cache-status;
    in-out property <bool> image-cache-busy;
    callback image-cache-refresh;
    callback image-cache-clear;
    min-width: 320px;
    min-height: 240px;
    preferred-width: 1120px;
    preferred-height: 780px;
    background: Theme.current.artwork_canvas;
    default-font-family: "Roboto";
    default-font-size: 14px;
    in-out property <int> section: 0;
    in property <int> detail-origin: 0;
    in property <string> heading: @tr("Your library");
    in property <string> caption: @tr("A home for your next chapter.");
    in property <string> status;
    in property <bool> busy;
    in property <[ItemRow]> items;
    in property <[string]> sources;
    in property <[SourceRow]> source-rows;
    in property <[ExtensionRow]> extensions;
    in-out property <int> browse-tab: 0;
    callback source-pin-picked(string);
    callback source-latest-selected(int);
    callback extension-action(string,string);
    in-out property <int> source-index: -1;
    in-out property <bool> source-catalog-open: false;
    in property <string> source-title;
    in property <bool> source-has-filters;
    in property <[SettingRow]> source-filters;
    in property <string> source-filter-notice;
    in-out property <bool> source-filters-open: false;
    private property <bool> source-options-open: false;
    private property <bool> source-search-open: false;
    in-out property <string> source-catalogue-kind: "popular";
    in-out property <length> catalogue-scroll-y: 0px;
    in-out property <string> source-query;
    in property <string> catalogue-page-error;
    private property <bool> catalogue-restore-pending: false;
    public function prepare-catalogue-return() { root.catalogue-restore-pending = true; }
    public function reset-catalogue-scroll() { root.catalogue-restore-pending = false; root.catalogue-scroll-y = 0px; }
    callback source-filters-requested;
    callback source-filter-changed(string,string);
    callback source-filter-selected(string,int);
    callback source-filters-applied;
    in property <string> series-title;
    in property <string> detail-series-key;
    in-out property <length> detail-scroll-y: 0px;
    in-out property <bool> detail-synopsis-expanded: false;
    private property <bool> detail-restore-pending: false;
    changed detail-series-key => {
        root.detail-scroll-y = 0px;
        root.detail-synopsis-expanded = false;
        if root.section == 5 { root.detail-restore-pending = true; }
    }
    in property <string> series-description;
    in property <string> resume-chapter;
    in property <string> series-metadata;
    in property <[string]> series-genres;
    in property <string> series-artwork-key;
    in-out property <image> series-poster;
    in-out property <bool> chapters-descending: true;
    in property <bool> in-library;
    in property <bool> has-more;
    in-out property <bool> show-adult: false;
    in property <[PageRow]> pages;
    in property <float> total-ratio;
    in-out property <length> scroll-y: 0px;
    in-out property <int> current-page: 0;
    in-out property <int> reading-mode: 0;
    // Actual renderer modes stay 0–3; index 4 is a persisted Automatic choice.
    in-out property <int> reader-mode-choice: 4;
    in-out property <float> zoom: 1;
    in property <string> position-label;
    in property <bool> can-previous;
    in property <bool> can-next;
    in-out property <string> path-text;
    in-out property <string> category-text;
    in property <[string]> categories;
    in-out property <int> category-index: 0;
    in-out property <bool> entry-menu-visible: false;
    in property <[EntryCategoryRow]> entry-categories;
    private property <string> entry-menu-key;
    private property <string> entry-menu-title;
    private property <bool> entry-menu-library;
    private property <bool> entry-menu-editing;
    private property <length> entry-menu-x;
    private property <length> entry-menu-y;
    callback entry-action(string,string);
    public function open-entry-menu(key: string,title: string,in-library: bool,x: length,y: length) {
        if key == "" { return; }
        root.entry-menu-key = key; root.entry-menu-title = title;
        root.entry-menu-library = in-library; root.entry-menu-editing = false;
        root.entry-menu-x = x; root.entry-menu-y = y; root.entry-menu-visible = true;
    }
    public function close-entry-menu() { root.entry-menu-visible = false; root.entry-menu-editing = false; keyboard.focus(); }
    function entry-menu-picked(action: string) {
        // Dispatch before the conditional overlay is destroyed, including
        // accessibility actions. Category toggles retain this captured ID.
        root.entry-action(root.entry-menu-key,action);
        if action == "categories" { root.entry-menu-editing = true; }
        else { root.close-entry-menu(); }
    }
    in property <[SettingRow]> settings;
    // Nova's responsive breakpoint applies equally to Android and desktop.
    out property <bool> mobile-ui: root.width < 700px;
    private property <bool> edge-to-edge-artwork: root.section == 5 || root.section == 6;
    out property <length> navigation-width: root.mobile-ui || root.section == 5 || root.section == 6 ? 0px : 64px;
    out property <length> bottom-navigation-height: root.mobile-ui && !(root.section == 3 && root.source-catalog-open) && (root.section == 0 || root.section == 1 || root.section == 2 || root.section == 3 || root.section == 4) ? 68px : 0px;
    in-out property <bool> reader-osd: false;
    private property <bool> show-reader-options: false;
    in-out property <bool> reader-context-visible: false;
    out property <int> reader-context-page: -1;
    in property <string> reader-context-status;
    in property <bool> reader-context-busy;
    private property <length> reader-context-x;
    private property <length> reader-context-y;
    private property <string> reader-context-page-id;
    private property <bool> reader-context-capturing;
    private property <bool> reader-context-toast-open;
    callback reader-context-opening(int);
    in-out property <ReaderCaptureViewport> reader-capture-viewport;
    out property <color> reader-capture-background: Theme.current.artwork_canvas;
    callback reader-context-action(int, string);
    callback reader-context-closed;
    public function open-reader-context(page: int, x: length, y: length) {
        if root.section != 6 || page < 0 || page >= root.pages.length || !root.pages[page].loaded { return; }
        if root.reader-context-visible { root.close-reader-context(); }
        root.reader-osd = false;
        root.show-reader-options = false;
        root.reader-context-toast-open = false;
        root.reader-context-page = page;
        root.reader-context-page-id = root.pages[page].page-id;
        root.reader-context-x = x; root.reader-context-y = y;
        // The renderer snapshots synchronously here, before either the menu or
        // export feedback can enter the captured chapter viewport.
        root.reader-context-capturing = true;
        root.reader-context-opening(page);
        root.reader-context-visible = true;
        root.reader-context-capturing = false;
    }
    public function close-reader-context() {
        if !root.reader-context-visible { return; }
        root.reader-context-visible = false;
        root.reader-context-page = -1;
        keyboard.focus();
        root.reader-context-closed();
    }
    function reader-context-picked(action: string) {
        if root.reader-context-busy || !root.reader-context-visible { return; }
        let page = root.reader-context-page;
        root.reader-context-visible = false;
        keyboard.focus();
        root.reader-context-action(page, action);
        if !root.reader-context-busy && root.reader-context-status != "" {
            root.reader-context-toast-open = true;
            reader-context-toast-timer.restart();
        }
        // The action callback borrows the pre-menu snapshot before release.
        root.reader-context-closed();
        root.reader-context-page = -1;
    }
    changed reader-context-status => {
        root.reader-context-toast-open = !root.reader-context-busy && root.reader-context-status != "";
        if root.reader-context-toast-open { reader-context-toast-timer.restart(); }
    }
    changed reader-context-busy => {
        root.reader-context-toast-open = !root.reader-context-busy && root.reader-context-status != "";
        if root.reader-context-toast-open { reader-context-toast-timer.restart(); }
    }
    changed pages => {
        if root.reader-context-visible && (root.reader-context-page < 0 || root.reader-context-page >= root.pages.length
            || root.pages[root.reader-context-page].page-id != root.reader-context-page-id) { root.close-reader-context(); }
    }
    reader-context-toast-timer := Timer {
        // restart() resets an existing native timer; the binding also admits
        // its very first notice, when no native timer has been started yet.
        interval: 4s; running: root.reader-context-toast-open && !root.reader-context-busy;
        triggered => { root.reader-context-toast-open = false; }
    }
    callback immersive-changed(bool);
    public function toggle-reader-osd() { if !root.reader-context-visible { root.reader-osd = !root.reader-osd; } }
    changed reader-osd => {
        if root.reader-context-visible && root.reader-osd { root.reader-osd = false; }
        if !root.reader-osd { root.show-reader-options = false; }
        root.immersive-changed(root.section == 6 && !root.reader-osd);
    }
    out property <length> reader-width: min(1100px, max(100px, (root.width - (root.section == 6 ? 0px : root.safe-area-insets.left + root.safe-area-insets.right) - 16px) * root.zoom));
    private property <length> reader-height: root.total-ratio * root.reader-width;

    callback request-artwork(int,int);
    callback library-sort-changed;
    in-out property <string> library-query;
    private property <bool> library-search-open: false;
    private property <int> library-search-focus-request: 0;
    public function focus-library-search() {
        if root.section != 0 { return; }
        root.library-search-open = true;
        root.library-search-focus-request += 1;
    }
    function close-library-search() {
        root.library-search-open = false;
        root.library-query = "";
        keyboard.focus();
        root.search("");
    }
    function toggle-library-search() {
        if root.library-search-open { root.close-library-search(); }
        else { root.focus-library-search(); }
    }
    callback chapter-order-changed(bool);
    callback adult-visibility-changed(bool);
    callback navigate(int);
    callback return-to-catalogue;
    callback open-item(int);
    callback open-series(int);
    callback item-action(int, string);
    callback search(string);
    callback source-selected(int);
    callback browse(string);
    callback load-more;
    callback install-addon;
    callback install-path(string);
    callback local-import(bool);
    callback backup(bool);
    callback check-update;
    callback toggle-library;
    callback download-chapter;
    callback chapter-step(int);
    in-out property <length> reader-viewport-height: 0px;
    callback reader-position(float, float, float);
    callback reader-reflow(float,float);
    callback mode-changed(int);
    callback page-step(int);
    callback add-category(string);
    callback category-selected(int);
    callback setting-changed(string, string);
    callback source-action(string);
    callback flush-progress;

    public function go-back() {
        if root.export-conflict-open { root.resolve-export-conflict(2); return; }
        if root.section == 13 { root.about-back-request += 1; return; }
        if root.entry-menu-visible { root.close-entry-menu(); return; }
        if root.reader-context-visible { root.close-reader-context(); return; }
        if root.section == 0 && root.library-search-open { root.close-library-search(); return; }
        if ((root.section == 5 && root.detail-origin == 3) || root.section == 8) && root.source-catalog-open { root.return-to-catalogue(); return; }
        if root.section == 3 && root.source-catalog-open { root.source-catalog-open = false; root.navigate(3); return; }
        root.navigate(root.section == 6 ? 5 : root.section == 8 ? 3 : root.section == 11 || root.section == 12 || root.section == 14 || root.section == 15 || root.section == 16 || root.section == 17 || root.section == 18 ? 10 : root.section >= 9 || root.section == 7 ? 4 : root.section == 5 ? root.detail-origin : 0);
    }

    changed section => {
        if root.export-conflict-open { root.resolve-export-conflict(2); }
        if root.entry-menu-visible { root.close-entry-menu(); }
        root.detail-restore-pending = root.section == 5;
        if root.reader-context-visible { root.close-reader-context(); }
        root.reader-context-toast-open = false;
        if root.section == 6 { root.reader-osd = false; root.show-reader-options = false; }
        root.immersive-changed(root.section == 6 && !root.reader-osd);
        keyboard.focus();
        if root.section == 4 || root.section >= 9 { more-page.focus_shell(); }
    }

    changed reader-width => { if root.section == 6 {root.reader-reflow(root.reader-width / 1px, root.reader-viewport-height / 1px);} }

    // Insets come from the actual Window, including Android system bars and
    // cutouts. Both shells share pages/callbacks, never the desktop geometry.
    if root.navigation-width > 0px: Rectangle {
        x: 0px; y: 0px; width: root.navigation-width + root.safe-area-insets.left; height: root.height;
        background: Theme.current.nav_rail;
    }
    if root.bottom-navigation-height > 0px && !Theme.transparent_navbar: Rectangle {
        y: root.height - root.bottom-navigation-height - root.safe-area-insets.bottom;
        width: root.width; height: root.bottom-navigation-height + root.safe-area-insets.bottom;
        background: Theme.current.nav_bottom;
    }
    keyboard := FocusScope {
        width: root.width; height: root.height;
        // Chapter artwork reaches underneath status bars and display cutouts.
        // Only the OSD controls use those insets, so showing controls does not
        // resize or shift the reading viewport.
        content-viewport := Rectangle {
            x: root.edge-to-edge-artwork ? 0px : root.safe-area-insets.left;
            y: root.edge-to-edge-artwork ? 0px : root.safe-area-insets.top;
            width: max(0px, root.width - (root.edge-to-edge-artwork ? 0px : root.safe-area-insets.left + root.safe-area-insets.right));
            height: max(0px, root.height - (root.edge-to-edge-artwork ? 0px : root.safe-area-insets.top) - root.safe-area-insets.bottom);
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    spacing: 0px;
                    if root.navigation-width > 0px: DesktopSidebar {
                        section: root.section >= 9 ? 4 : root.section;
                        navigate(section) => { root.navigate(section); }
                    }
                    Rectangle {
                        min-width: 0px;
                        if root.section != 6 && root.section != 4 && root.section < 9: page-scroll := ScrollView {
                            private property <int> control-focus-request: SettingsStyle.focus-request;
                            changed control-focus-request => {
                                if SettingsStyle.keyboard-mode {
                                    let top = SettingsStyle.focus-y - self.absolute-position.y;
                                    if top < 0px { self.content-y -= top; }
                                    else if top + SettingsStyle.focus-height > self.visible-height {
                                        self.content-y -= top + SettingsStyle.focus-height - self.visible-height;
                                    }
                                }
                            }
                            in property <int> destination: root.section;
                            changed destination => {
                                if root.section == 5 { root.detail-restore-pending = true; }
                                else if root.section == 3 && root.source-catalog-open { root.catalogue-restore-pending = true; }
                                else { self.content-y = 0px; }
                            }
                            changed content-y => {
                                if root.section == 3 && root.source-catalog-open && !root.catalogue-restore-pending { root.catalogue-scroll-y = self.content-y; }
                                if root.section == 5 && !root.detail-restore-pending && !root.busy { root.detail-scroll-y = self.content-y; }
                            }
                            in property <length> catalogue-position: root.catalogue-scroll-y;
                            changed catalogue-position => { if root.section == 3 && root.source-catalog-open && !root.catalogue-restore-pending && Math.abs(self.content-y - root.catalogue-scroll-y) > 0.5px { self.content-y = root.catalogue-scroll-y; } }
                            Timer { interval: 16ms; running: root.catalogue-restore-pending && root.section == 3 && root.source-catalog-open; triggered => { page-scroll.content-y = root.catalogue-scroll-y; root.catalogue-restore-pending = false; } }
                            Timer {
                                interval: 100ms;
                                running: root.section == 3 && root.source-catalog-open;
                                triggered => {
                                    // Also fill a short first page; only request when the
                                    // source can advance and the previous page succeeded.
                                    if !root.catalogue-restore-pending && root.has-more && !root.busy && root.catalogue-page-error == "" && page-scroll.visible-height > 0px && page-scroll.content-height + page-scroll.content-y <= page-scroll.visible-height * 2 {
                                        root.load-more();
                                    }
                                }
                            }
                            Timer { interval: 16ms; running: root.detail-restore-pending && root.section == 5; triggered => { page-scroll.content-y = root.detail-scroll-y; root.detail-restore-pending = false; } }
                            in property <bool> catalog-open: root.source-catalog-open;
                            changed catalog-open => { if root.section == 3 { self.content-y = 0px; } }
                            in property <string> catalogue: root.source-catalogue-kind;
                            changed catalogue => { if root.section == 3 && !root.catalogue-restore-pending { self.content-y = 0px; root.catalogue-scroll-y = 0px; } }
                            min-width: 0px;
                            mouse-drag-pan-enabled: true;
                            content-width: self.visible-width;
                            // Headers and filters scroll with the page, so landscape
                            // and the software keyboard cannot squeeze out the list.
                            VerticalLayout {
                                padding: root.section == 5 ? 0px : 18px;
                                padding-bottom: root.section == 5 ? 16px : 18px + (Theme.transparent_navbar ? root.bottom-navigation-height : 0px);
                                spacing: 16px; alignment: start;
                                if root.section != 5: page-heading := PageHeader {
                                    title: root.section == 3 && root.source-catalog-open ? root.source-title : root.heading; subtitle: root.section == 3 && root.source-catalog-open ? "" : root.caption; narrow: root.mobile-ui;
                                    show-back: (root.section == 3 && root.source-catalog-open) || root.section == 5 || root.section == 7 || root.section == 8;
                                    back => { root.go-back(); }
                                }
                                if root.status != "" && root.section != 5: Rectangle {
                                    min-height: status-text.preferred-height + 24px;
                                    background: Theme.current.selection_wash; border-radius: 8px;
                                    status-text := Text {
                                        text: root.status; color: Theme.current.text_settings; wrap: word-wrap;
                                        x: 12px; y: 12px; width: max(0px, parent.width - 24px);
                                    }
                                }
                                if root.busy && root.section != 5: HorizontalLayout {
                                    Spinner { width: 24px; height: 24px; }
                                    Text { min-width: 0px; text: @tr("Loading…"); color: Theme.current.text_secondary; }
                                }
                                if root.section == 3 && !root.source-catalog-open: VerticalLayout {
                                    spacing: 12px;
                                    Segmented { labels: [@tr("Sources"),@tr("Extensions ({})",root.extensions.length)]; current-index: root.browse-tab; picked(i) => { root.browse-tab = i; } }
                                    if root.browse-tab == 0: VerticalLayout {
                                        spacing: 12px;
                                        CheckBox { text: @tr("Show adult sources"); checked <=> root.show-adult; toggled => { root.adult-visibility-changed(self.checked); } }
                                        SourceList {
                                            items: root.source-rows;
                                            picked(i) => { root.source-index = i; root.source-catalog-open = true; root.source-catalogue-kind = "popular"; root.source-selected(i); }
                                            latest-picked(i) => { root.source-index = i; root.source-catalog-open = true; root.source-catalogue-kind = "latest"; root.source-latest-selected(i); }
                                            pin-picked(id) => { root.source-pin-picked(id); }
                                        }
                                        if root.source-rows.length == 0: Text { text: @tr("Install an extension to add a source."); color: Theme.current.text_secondary; wrap: word-wrap; min-width: 0px; }
                                    }
                                    if root.browse-tab == 1: VerticalLayout {
                                        spacing: 12px;
                                        ActionButton { text: @tr("Install addon"); clicked => { root.install-addon(); } }
                                        ExtensionList { items: root.extensions; action(id,action) => { root.extension-action(id,action); } }
                                    }
                                }
                                if root.section == 3 && root.source-catalog-open: VerticalLayout {
                                    spacing: 12px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        IconAction { width: 44px; text: @tr("Search source"); icon: @image-url("../../assets/icons/navigation/search.svg"); clicked => { root.source-search-open = !root.source-search-open; } }
                                        LibraryViewSwitch { list-view: Appearance.library-list-view; picked(list) => { Appearance.setting-changed("library_list_view", list ? 1 : 0); } }
                                        Rectangle { horizontal-stretch: 1; min-width: 0px; }
                                        IconAction { width: 44px; text: @tr("Source options"); icon: @image-url("../../assets/icons/navigation/more.svg"); clicked => { root.source-options-open = !root.source-options-open; } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        LibraryFilterChip { label: @tr("Popular"); selected: root.source-catalogue-kind == "popular"; keyboard-focusable: true;
                                            accessible-action-default => { root.source-catalogue-kind = "popular"; root.browse("popular"); }
                                            picked => { root.source-catalogue-kind = "popular"; root.browse("popular"); } }
                                        LibraryFilterChip { label: @tr("Latest"); selected: root.source-catalogue-kind == "latest"; keyboard-focusable: true;
                                            accessible-action-default => { root.source-catalogue-kind = "latest"; root.browse("latest"); }
                                            picked => { root.source-catalogue-kind = "latest"; root.browse("latest"); } }
                                        if root.source-has-filters: LibraryFilterChip { label: @tr("Filter"); selected: root.source-filters-open; keyboard-focusable: true;
                                            accessible-action-default => { root.source-filters-requested(); }
                                            picked => { root.source-filters-requested(); } }
                                    }
                                    if root.source-search-open: HorizontalLayout {
                                        spacing: 8px;
                                        query := LineEdit { min-width: 0px; text <=> root.source-query; placeholder-text: @tr("Search this source…"); accepted => { root.source-catalogue-kind = "search"; root.search(self.text); } }
                                        ActionButton { width: 80px; text: @tr("Search"); clicked => { root.source-catalogue-kind = "search"; root.search(query.text); } }
                                    }
                                    if root.source-filters-open: SourceFilterPanel {
                                        settings: root.source-filters; notice: root.source-filter-notice;
                                        changed(key,value) => { root.source-filter-changed(key,value); }
                                        selection-changed(key,index) => { root.source-filter-selected(key,index); }
                                        apply => { root.source-catalogue-kind = "filtered"; root.source-filters-applied(); }
                                    }
                                    if root.source-options-open: ComboBox {
                                        model: root.sources; current-index <=> root.source-index;
                                        placeholder-text: @tr("Change source");
                                        selected(_) => { root.source-selected(self.current-index); }
                                    }
                                    if root.source-options-open: HorizontalLayout {
                                        spacing: 8px;
                                        ActionButton { text: @tr("Enable / disable"); clicked => { root.source-action("toggle"); } }
                                        ActionButton { text: @tr("Remove"); clicked => { root.source-action("remove"); } }
                                        ActionButton { text: @tr("Settings"); clicked => { root.source-action("settings"); } }
                                    }
                                }
                                if root.section == 0: VerticalLayout {
                                    spacing: 12px;
                                    library-controls := Rectangle {
                                        min-width: 0px;
                                        height: library-search.height + library-toolbar.preferred-height;
                                        library-search := LibrarySearchReveal {
                                            x: 0px; y: root.mobile-ui ? library-toolbar.preferred-height : 0px;
                                            width: 100%; open: root.library-search-open;
                                            viewport-height: page-scroll.visible-height;
                                            query <=> root.library-query;
                                            focus-request: root.library-search-focus-request;
                                            reveal-requested => {
                                                let top = library-search.absolute-position.y - page-scroll.absolute-position.y;
                                                if top < 0px || top + 44px > page-scroll.visible-height {
                                                    let target = root.mobile-ui ? min(library-toolbar.preferred-height, max(0px, page-scroll.visible-height - 44px)) : 0px;
                                                    page-scroll.content-y += target - top;
                                                }
                                            }
                                            close-requested => { root.close-library-search(); }
                                            search(query) => { root.search(query); }
                                            submitted => { if !root.mobile-ui { keyboard.focus(); } }
                                        }
                                        library-toolbar := VerticalLayout {
                                            x: 0px; y: root.mobile-ui ? 0px : library-search.height;
                                            width: 100%; height: self.preferred-height; spacing: 12px;
                                            HorizontalLayout {
                                                spacing: 10px;
                                                ComboBox {
                                                    model: [@tr("Recently added"), @tr("Title"), @tr("Unread chapters")];
                                                    current-index: Appearance.library-sort; min-width: 0px; max-width: 190px;
                                                    placeholder-text: @tr("Sort library");
                                                    selected(_) => { Appearance.setting-changed("library_sort", self.current-index); root.library-sort-changed(); }
                                                }
                                                Rectangle { min-width: 0px; horizontal-stretch: 1; }
                                                LibraryViewSwitch { list-view: Appearance.library-list-view; picked(list) => { Appearance.setting-changed("library_list_view", list ? 1 : 0); } }
                                                IconAction {
                                                    width: 44px;
                                                    text: root.library-search-open ? @tr("Close library search") : @tr("Search library");
                                                    icon: root.library-search-open ? @image-url("../../assets/icons/navigation/close.svg") : @image-url("../../assets/icons/navigation/search.svg");
                                                    clicked => { root.toggle-library-search(); }
                                                }
                                            }
                                            ScrollView {
                                                height: 44px; content-height: 44px;
                                                content-width: categories-row.preferred-width;
                                                mouse-drag-pan-enabled: true;
                                                categories-row := HorizontalLayout {
                                                    spacing: 8px; alignment: start;
                                                    for category[i] in root.categories: LibraryFilterChip {
                                                        keyboard-focusable: true;
                                                        label: category; selected: i == root.category-index;
                                                        accessible-action-default => { root.category-index = i; root.category-selected(i); }
                                                        picked => { root.category-index = i; root.category-selected(i); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.section == 1: ActionButton { text: @tr("Refresh library"); clicked => { root.browse("refresh"); } }
                                if root.section == 2: HorizontalLayout {
                                    spacing: 8px;
                                    history-query := LineEdit { placeholder-text: @tr("Search history…"); accepted => { root.search(self.text); } }
                                    ActionButton { width: 80px; text: @tr("Search"); clicked => { root.search(history-query.text); } }
                                    IconAction { width: 44px; text: @tr("Clear history"); icon: @image-url("../../assets/icons/navigation/delete.svg"); clicked => { root.item-action(-1,"clear-history"); } }
                                }
                                if root.section == 1 || root.section == 2: TimelineList {
                                    items: root.items; history: root.section == 2;
                                    viewport-top: page-scroll.absolute-position.y; viewport-height: page-scroll.visible-height;
                                    picked(i) => { root.open-item(i); } series-picked(i) => { root.open-series(i); } action(i,action) => { root.item-action(i,action); }
                                    request-artwork(first,last) => { root.request-artwork(first,last); }
                                }
                                if root.section == 5: DetailHero {
                                    viewport-width: root.width;
                                    safe-top: root.safe-area-insets.top;
                                    safe-left: root.safe-area-insets.left; safe-right: root.safe-area-insets.right;
                                    title: root.series-title; description: root.series-description; resume-chapter: root.resume-chapter;
                                    metadata: root.series-metadata; genres: root.series-genres;
                                    poster: root.series-poster; in-library: root.in-library; can-resume: root.items.length > 0;
                                    narrow: root.mobile-ui; scroll-y: page-scroll.content-y;
                                    expanded <=> root.detail-synopsis-expanded;
                                    resume => { root.detail-scroll-y = page-scroll.content-y; root.chapter-step(0); } toggle-library => { root.toggle-library(); }
                                    request-artwork => { root.request-artwork(-1,-1); }
                                }
                                if (root.section == 0 || (root.section == 3 && root.source-catalog-open)) && root.items.length > 0: SeriesGrid {
                                    items: root.items; list-view: Appearance.library-list-view;
                                    min-cols: root.section == 3 ? Appearance.browse-min-cols : Appearance.library-min-cols;
                                    overlay-caption: root.section == 3;
                                    context-enabled: root.section == 0;
                                    viewport-top: page-scroll.absolute-position.y; viewport-height: page-scroll.visible-height;
                                    picked(i) => { root.open-item(i); }
                                    context-requested(key,title,in-library,x,y) => { root.open-entry-menu(key,title,in-library,x,y); }
                                    request-artwork(first,last) => { root.request-artwork(first,last); }
                                }
                                if root.section == 5: VerticalLayout {
                                    padding-left: root.safe-area-insets.left + (root.mobile-ui ? 20px : 64px);
                                    padding-right: root.safe-area-insets.right + (root.mobile-ui ? 20px : 64px);
                                    spacing: 4px;
                                    if root.status != "": Text { text: root.status; color: Theme.current.text_settings; wrap: word-wrap; min-width: 0px; }
                                    HorizontalLayout {
                                        Text { text: @tr("{n} chapter" | "{n} chapters" % root.items.length); font-size: 20px; font-weight: 600; color: Theme.current.text_bright; vertical-alignment: center; min-width: 0px; }
                                        IconAction { width: 44px; text: @tr("Reverse chapter order"); icon: @image-url("../../assets/icons/navigation/updates.svg"); clicked => { root.chapter-order-changed(!root.chapters-descending); } }
                                    }
                                    for chapter[i] in root.items: ChapterRow {
                                        chapter: chapter; picked => { root.detail-scroll-y = page-scroll.content-y; root.open-item(i); } action(action) => { root.item-action(i,action); }
                                    }
                                }
                                if root.section != 4 && root.section != 8: VerticalLayout {
                                    spacing: Theme.card_spacing;
                                    if root.section != 0 && root.section != 1 && root.section != 2 && root.section != 3 && root.section != 5: VerticalLayout {
                                    spacing: Theme.card_spacing;
                                    for row[index] in root.items: Rectangle {
                                        height: (root.section == 5 || root.section == 7) ? 136px : 80px;
                                        border-radius: Theme.card_corner_radius; background: hover.has-hover ? Theme.current.control_hover : Theme.current.card;
                                        border-width: 1px; border-color: Theme.current.border_soft;
                                        VerticalLayout {
                                            padding: 8px; spacing: 0px;
                                            Rectangle {
                                                height: 64px;
                                                HorizontalLayout {
                                                    padding: 6px; spacing: 10px;
                                                    Rectangle { width: 4px; border-radius: 2px; background: row.bookmarked ? Theme.current.accent_soft : Theme.current.control_border; }
                                                    VerticalLayout {
                                                        spacing: 6px;
                                                        Text { min-width: 0px; text: row.title; color: Theme.current.text_bright; font-weight: 600; overflow: elide; }
                                                        Text { min-width: 0px; text: row.subtitle; color: Theme.current.text_secondary; font-size: 12px; overflow: elide; }
                                                    }
                                                    Text { width: root.mobile-ui ? 64px : 96px; text: row.badge; color: Theme.current.accent_soft; font-size: 11px; overflow: elide; horizontal-alignment: right; }
                                                }
                                                hover := TouchArea { clicked => { root.open-item(index); } }
                                            }
                                            if root.section == 5: HorizontalLayout {
                                                spacing: 6px;
                                                ActionButton { text: @tr("Read / unread"); clicked => { root.item-action(index, "read"); } }
                                                ActionButton { text: row.bookmarked ? @tr("Unbookmark") : @tr("Bookmark"); clicked => { root.item-action(index, "bookmark"); } }
                                                ActionButton { text: @tr("Download"); clicked => { root.item-action(index, "download"); } }
                                            }
                                            if root.section == 7: HorizontalLayout {
                                                spacing: 6px;
                                                ActionButton { text: @tr("Pause"); clicked => { root.item-action(index, "pause"); } }
                                                ActionButton { text: @tr("Resume"); clicked => { root.item-action(index, "resume"); } }
                                                ActionButton { text: @tr("Cancel"); clicked => { root.item-action(index, "cancel"); } }
                                                if row.has-download && !row.local-import: ActionButton { text: @tr("Delete download"); clicked => { root.item-action(index, "delete-download"); } }
                                            }
                                        }
                                    }
                                    }
                                    if root.items.length == 0 && !root.busy && (root.section != 3 || root.source-catalog-open): Rectangle {
                                        min-height: 220px;
                                        VerticalLayout {
                                            alignment: center; spacing: 12px;
                                            Rectangle {
                                                height: 56px;
                                                Image {
                                                    source: @image-url("../../assets/icons/navigation/library.svg"); width: 48px; height: 48px;
                                                    x: (parent.width - self.width) / 2; y: 4px;
                                                    image-fit: contain; colorize: Theme.current.text_muted;
                                                }
                                            }
                                            Text { min-width: 0px; text: root.section == 0 ? @tr("Your next story starts here") : @tr("Nothing here yet"); color: Theme.current.text_bright; font-size: 19px; wrap: word-wrap; horizontal-alignment: center; }
                                            Text { min-width: 0px; text: root.section == 0 ? @tr("Install a source in Browse, or import a local chapter in More.") : @tr("Try refreshing or choosing another source."); color: Theme.current.text_secondary; wrap: word-wrap; horizontal-alignment: center; }
                                        }
                                    }
                                    if root.section == 3 && root.source-catalog-open && root.catalogue-page-error != "": VerticalLayout {
                                        spacing: 8px;
                                        Text { text: root.catalogue-page-error; color: Theme.current.text_secondary; wrap: word-wrap; }
                                        ActionButton { text: @tr("Retry"); enabled: !root.busy; clicked => { root.load-more(); } }
                                    }
                                }
                                if root.section == 8: VerticalLayout {
                                    spacing: 16px;
                                    for setting in root.settings: VerticalLayout {
                                        spacing: 8px;
                                        Text { min-width: 0px; text: setting.name; color: Theme.current.text_bright; wrap: word-wrap; }
                                        if setting.kind == "bool": CheckBox { checked: setting.checked; toggled => { root.setting-changed(setting.key, self.checked ? "true" : "false"); } }
                                        if setting.kind == "text" || setting.kind == "secret": LineEdit { min-width: 0px; text: setting.value; input-type: setting.kind == "secret" ? InputType.password : InputType.text; placeholder-text: setting.kind == "secret" ? @tr("Enter a new secret to replace it") : ""; accepted => { root.setting-changed(setting.key, self.text); } }
                                        if setting.kind == "select": ComboBox { min-width: 0px; model: setting.options; current-index: setting.selected; selected(value) => { root.setting-changed(setting.key, value); } }
                                    }
                                    if root.settings.length == 0: Text { min-width: 0px; text: @tr("This source has no configurable settings."); color: Theme.current.text_secondary; wrap: word-wrap; }
                                    Text { min-width: 0px; text: @tr("Text fields save when you press Enter. Secrets are stored only in this profile and are excluded from backups."); color: Theme.current.text_secondary; wrap: word-wrap; }
                                }
                            }
                        }
                        if root.section == 6: Rectangle {
                            reader := Flickable {
                                private property <length> physical-pixel: 1phx;
                                changed physical-pixel => {root.reader-reflow(root.reader-width / 1px,self.height / 1px);}
                                width: parent.width; height: parent.height;
                                content-y <=> root.scroll-y;
                                changed content-y => {if root.reading-mode==0{root.reader-position(-self.content-y / 1px,root.reader-width / 1px,self.height / 1px);}}
                                changed height => {root.reader-viewport-height=self.height;root.reader-reflow(root.reader-width / 1px,self.height / 1px);}
                                interactive: root.reading-mode == 0 || root.zoom > 1;
                                content-width: max(self.width, root.reader-width);
                                content-height: root.reading-mode == 0 ? max(self.height, root.reader-height) : self.height;
                                ReaderImageInteraction {
                                    width: reader.content-width; height: reader.content-height;
                                    context-enabled: false;
                                    accessible-role: button; accessible-label: @tr("Toggle reader controls");
                                    accessible-action-default => { root.toggle-reader-osd(); }
                                    tapped => { root.toggle-reader-osd(); }
                                }
                                for page[index] in root.pages: page-frame := Rectangle {
                                    visible: root.reading-mode == 0 || index == root.current-page;
                                    x: (max(reader.width, root.reader-width) - self.width) / 2;
                                    y: root.reading-mode == 0 ? page.position * root.reader-width : 0px;
                                    width: root.reader-width;
                                    height: root.reading-mode == 0 ? root.reader-width * page.ratio : reader.height;
                                    // Loaded page frames stay transparent: a logical,
                                    // unsnapped background could paint over its neighbour's
                                    // snapped image edge while the chapter is scrolling.
                                    if page.loaded: image-frame := Rectangle {
                                        width: root.reading-mode==0 ? parent.width : min(parent.width,parent.height/page.ratio);
                                        height: root.reading-mode==0 ? parent.height : min(parent.height,parent.width*page.ratio);
                                        x:(parent.width - self.width)/2; y:(parent.height - self.height)/2;
                                        // Keep layout/resume coordinates continuous. Only
                                        // raster edges use physical pixels, including the
                                        // fractional viewport scroll and window origin.
                                        private property <length> raster-origin-y: root.reading-mode == 0 ? reader.absolute-position.y + reader.content-y + page.position * root.reader-width : self.absolute-position.y;
                                        private property <length> raster-bottom-y: root.reading-mode == 0 ? reader.absolute-position.y + reader.content-y + (index + 1 < root.pages.length ? root.pages[index + 1].position : root.total-ratio) * root.reader-width : self.absolute-position.y + self.height;
                                        for tile[tile-index] in page.tiles: reader-tile := Image {
                                            source: tile.image;
                                            private property <length> logical-top: image-frame.raster-origin-y + tile.offset * image-frame.height;
                                            // The next tile/page owns the shared edge. Do
                                            // not independently round offset + height.
                                            private property <float> bottom-offset: tile.bottom > tile.offset ? tile.bottom : tile-index + 1 < page.tiles.length ? page.tiles[tile-index + 1].offset : tile.offset + tile.fraction;
                                            private property <length> logical-bottom: self.bottom-offset >= 0.999999 ? image-frame.raster-bottom-y : image-frame.raster-origin-y + self.bottom-offset * image-frame.height;
                                            private property <length> snapped-top: round(self.logical-top / 1phx) * 1phx;
                                            private property <length> snapped-bottom: round(self.logical-bottom / 1phx) * 1phx;
                                            private property <length> snapped-left: round((image-frame.absolute-position.x + tile.left * image-frame.width) / 1phx) * 1phx;
                                            private property <length> snapped-right: round((image-frame.absolute-position.x + (tile.right > tile.left ? tile.right : 1) * image-frame.width) / 1phx) * 1phx;
                                            x: self.snapped-left - image-frame.absolute-position.x;
                                            y: self.snapped-top - image-frame.absolute-position.y;
                                            width: self.snapped-right - self.snapped-left;
                                            height: max(0px, self.snapped-bottom - self.snapped-top);
                                            image-fit: fill;
                                        }
                                        ReaderImageInteraction {
                                            width: 100%; height: 100%;
                                            accessible-role: button; accessible-label: @tr("Page {} image", index + 1);
                                            accessible-action-default => {
                                                SettingsStyle.keyboard-mode = true;
                                                root.reader-capture-viewport = { x: reader.absolute-position.x / 1px, y: reader.absolute-position.y / 1px, width: reader.width / 1px, height: reader.height / 1px, content-x: reader.content-x / 1px, content-y: reader.content-y / 1px };
                                                root.open-reader-context(index, self.absolute-position.x + self.width / 2, reader.absolute-position.y + reader.height / 2);
                                            }
                                            tapped => { root.toggle-reader-osd(); }
                                            context-requested(x,y) => {
                                                root.reader-capture-viewport = { x: reader.absolute-position.x / 1px, y: reader.absolute-position.y / 1px, width: reader.width / 1px, height: reader.height / 1px, content-x: reader.content-x / 1px, content-y: reader.content-y / 1px };
                                                root.open-reader-context(index,x,y);
                                            }
                                        }
                                    }
                                    if !page.loaded: Text { text: page.error == "" ? @tr("Loading page {}", index + 1) : page.error; color: Theme.current.text_secondary; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            if root.reader-osd: Rectangle {
                                x: 0px; y: 0px; width: parent.width; height: parent.height;
                            Rectangle {
                                y: 0px; width: parent.width; height: root.safe-area-insets.top + 64px; background: Theme.current.nav_rail;
                                HorizontalLayout {
                                    x: root.safe-area-insets.left; y: root.safe-area-insets.top;
                                    width: max(0px, parent.width - root.safe-area-insets.left - root.safe-area-insets.right); height: 64px;
                                    padding: 8px; spacing: 8px;
                                    IconAction { text: @tr("Back to chapters"); icon: @image-url("../../assets/icons/navigation/back.svg"); clicked => { root.navigate(5); } }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { min-width: 0px; text: root.series-title; color: Theme.current.text_bright; overflow: elide; }
                                        Text { min-width: 0px; text: root.position-label; color: Theme.current.text_secondary; font-size: 12px; overflow: elide; }
                                    }
                                    ActionButton { width: 76px; text: @tr("Options"); clicked => { root.show-reader-options = !root.show-reader-options; } }
                                    IconAction { text: @tr("Download chapter"); icon: @image-url("../../assets/icons/navigation/downloads.svg"); clicked => { root.download-chapter(); } }
                                }
                            }
                            if root.show-reader-options: Rectangle {
                                y: root.safe-area-insets.top + 64px; width: parent.width; height: min(120px, max(48px, root.height - root.safe-area-insets.top - root.safe-area-insets.bottom - 176px));
                                background: Theme.current.nav_rail;
                                ScrollView {
                                    x: root.safe-area-insets.left;
                                    width: max(0px, parent.width - root.safe-area-insets.left - root.safe-area-insets.right); height: parent.height;
                                    VerticalLayout {
                                        padding: 8px; spacing: 8px;
                                        ComboBox { min-width: 0px; placeholder-text: @tr("Reading mode"); model: [@tr("Webtoon"), @tr("Left to right"), @tr("Right to left"), @tr("Vertical paging"), @tr("Automatic")]; current-index <=> root.reader-mode-choice; selected(value) => { root.mode-changed(self.current-index); } }
                                        Text {
                                            text: root.reader-mode-choice == 4 ? @tr("Automatic · {}", root.reading-mode == 0 ? @tr("Webtoon") : root.reading-mode == 1 ? @tr("Left to right") : root.reading-mode == 2 ? @tr("Right to left") : @tr("Vertical paging")) : @tr("Manual · saved for this series");
                                            color: Theme.current.text_secondary; font-size: 12px; wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            IconAction { text: @tr("Zoom out"); icon: @image-url("../../assets/icons/navigation/minus.svg"); clicked => { root.zoom = max(0.5, root.zoom - 0.25); } }
                                            Text { min-width: 0px; text: @tr("Zoom {}%", round(root.zoom * 100)); color: Theme.current.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
                                            IconAction { text: @tr("Zoom in"); icon: @image-url("../../assets/icons/navigation/plus.svg"); clicked => { root.zoom = min(3, root.zoom + 0.25); } }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                y: parent.height - 64px; width: parent.width; height: 64px; background: Theme.current.nav_rail;
                                HorizontalLayout {
                                    x: root.safe-area-insets.left;
                                    width: max(0px, parent.width - root.safe-area-insets.left - root.safe-area-insets.right); height: 64px;
                                    padding: 8px; spacing: 6px;
                                    IconAction { text: @tr("Previous chapter"); icon: @image-url("../../assets/icons/navigation/chapter-previous.svg"); enabled: root.can-previous; clicked => { root.chapter-step(-1); } }
                                    IconAction { text: @tr("Previous page"); icon: @image-url("../../assets/icons/navigation/previous.svg"); clicked => { root.page-step(-1); } }
                                    ActionButton { text: @tr("Retry"); clicked => { root.page-step(0); } }
                                    IconAction { text: @tr("Next page"); icon: @image-url("../../assets/icons/navigation/next.svg"); clicked => { root.page-step(1); } }
                                    IconAction { text: @tr("Next chapter"); icon: @image-url("../../assets/icons/navigation/chapter-next.svg"); enabled: root.can-next; clicked => { root.chapter-step(1); } }
                                }
                            }
                            }
                        }
                        if root.section == 5: Rectangle {
                            x: 0px; y: 0px; width: parent.width; height: root.safe-area-insets.top + (root.mobile-ui ? 64px : 76px);
                            // Nova detail.slint: fixed scrim over scrolling art,
                            // with toolbar controls below the system status bar.
                            if root.mobile-ui: detail-status-scrim := Image {
                                x: 0px; y: 0px; width: parent.width; height: root.safe-area-insets.top + 64px;
                                source: @image-url("../../assets/status-bar-scrim.svg"); image-fit: fill;
                                opacity: Theme.status_bar_gradient / 100;
                            }
                            HorizontalLayout {
                                padding-left: root.safe-area-insets.left + (root.mobile-ui ? 10px : 16px);
                                padding-right: root.safe-area-insets.right + (root.mobile-ui ? 10px : 16px);
                                padding-top: root.safe-area-insets.top + (root.mobile-ui ? 10px : 16px);
                                padding-bottom: root.mobile-ui ? 10px : 16px; spacing: root.mobile-ui ? 6px : 12px;
                                BackButton { clicked => { root.go-back(); } }
                                Rectangle { horizontal-stretch: 1; }
                                IconAction { width: 44px; text: @tr("Title options"); icon: @image-url("../../assets/icons/navigation/more.svg"); clicked => { root.open-entry-menu(root.detail-series-key,root.series-title,root.in-library,self.absolute-position.x,self.absolute-position.y + self.height); } }
                            }
                        }
                        more-page := MorePage {
                            // Keep More's retained landing viewport unchanged
                            // when its child pages hide the external bottom bar.
                            width: parent.width; height: parent.height + (Theme.transparent_navbar ? 0px : root.bottom-navigation-height);
                            visible: root.section == 4 || root.section >= 9;
                            section: root.section; narrow: root.mobile-ui;
                            app-version: root.app-version; status: root.status;
                            license-text-chunks: root.license-text-chunks;
                            license-sources: root.license-sources;
                            about-licenses-open <=> root.about-licenses-open;
                            about-scroll-y <=> root.about-scroll-y;
                            about-licenses-scroll-y <=> root.about-licenses-scroll-y;
                            about-back-request: root.about-back-request;
                            update-checks-enabled: root.about-update-checks-enabled;
                            license-source-requested(url) => { root.license-source-requested(url); }
                            category-text <=> root.category-text;
                            image-cache-info: root.image-cache-info;
                            image-cache-status: root.image-cache-status;
                            image-cache-busy: root.image-cache-busy;
                            image-cache-refresh => { root.image-cache-refresh(); }
                            image-cache-clear => { root.image-cache-clear(); }
                            navigate(section) => { root.navigate(section); }
                            install-addon => { root.install-addon(); }
                            local-import(folder) => { root.local-import(folder); }
                            backup(restore) => { root.backup(restore); }
                            add-category(name) => { root.add-category(name); }
                            check-update => { root.check-update(); }
                        }
                    }
                }
                if root.bottom-navigation-height > 0px: MobileNavigation {
                    section: root.section == 5 ? root.detail-origin : root.section;
                    navigate(section) => { root.navigate(section); }
                }
            }
        }
        key-pressed(event) => {
            if root.export-conflict-open {
                if event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace { root.resolve-export-conflict(2); }
                return accept;
            }
            if root.section == 0 && event.modifiers.control && (event.text == "f" || event.text == "F") {
                if !event.repeat { root.focus-library-search(); }
                return accept;
            }
            if root.section == 6 && (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) {
                if !event.repeat {
                    SettingsStyle.keyboard-mode = true;
                    root.open-reader-context(root.current-page, root.width / 2, root.height / 2);
                }
                return accept;
            }
            if event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace {
                root.go-back();
                return accept;
            }
            if root.section == 6 && event.text == Key.RightArrow { root.page-step(root.reading-mode == 2 ? -1 : 1); return accept; }
            if root.section == 6 && event.text == Key.LeftArrow { root.page-step(root.reading-mode == 2 ? 1 : -1); return accept; }
            if root.section == 6 && (event.text == " " || event.text == Key.DownArrow) { root.page-step(1); return accept; }
            return reject;
        }
    }
    if root.section == 6 && !root.reader-context-visible && !root.reader-context-capturing && (root.reader-context-busy || root.reader-context-toast-open): reader-context-toast := Rectangle {
        width: min(440px, max(1px, root.width - root.safe-area-insets.left - root.safe-area-insets.right - 32px));
        height: max(48px, toast-message.preferred-height + 24px);
        x: root.safe-area-insets.left + (root.width - root.safe-area-insets.left - root.safe-area-insets.right - self.width) / 2;
        y: root.height - root.safe-area-insets.bottom - self.height - (root.reader-osd ? 80px : 24px);
        background: Theme.current.popup; border-radius: Theme.card_corner_radius;
        border-width: 1px; border-color: Theme.current.border_medium;
        accessible-role: groupbox;
        accessible-label: root.reader-context-busy ? @tr("Preparing image…") : root.reader-context-status;
        HorizontalLayout {
            padding: 12px; spacing: 10px;
            if root.reader-context-busy: Spinner { width: 20px; height: 20px; accessible-label: @tr("Preparing image…"); }
            toast-message := Text {
                min-width: 0px;
                text: root.reader-context-busy ? @tr("Preparing image…") : root.reader-context-status;
                color: Theme.current.text_bright; font-size: 14px;
                wrap: word-wrap; vertical-alignment: center;
            }
        }
    }
    if root.section == 6 && root.reader-context-visible: ReaderContextMenu {
        width: root.width; height: root.height;
        viewport-left: root.safe-area-insets.left; viewport-top: root.safe-area-insets.top;
        viewport-width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        viewport-height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
        anchor-x: root.reader-context-x; anchor-y: root.reader-context-y;
        busy: root.reader-context-busy;
        picked(action) => { root.reader-context-picked(action); }
        dismissed => { root.close-reader-context(); }
    }
    if root.entry-menu-visible: EntryMenu {
        width: root.width; height: root.height;
        narrow: root.mobile-ui; editing: root.entry-menu-editing;
        title: root.entry-menu-title; in-library: root.entry-menu-library;
        categories: root.entry-categories;
        anchor-x: root.entry-menu-x; anchor-y: root.entry-menu-y;
        safe-bottom: root.safe-area-insets.bottom; safe-left: root.safe-area-insets.left; safe-right: root.safe-area-insets.right;
        picked(action) => { root.entry-menu-picked(action); }
        category-toggled(id) => { root.entry-action(root.entry-menu-key,"category:" + id); }
        dismissed => { root.close-entry-menu(); }
    }
    SaveConflictSheet {
        width: root.width; height: root.height;
        open: root.export-conflict-open;
        file-name: root.export-conflict-name;
        safe-top: root.safe-area-insets.top; safe-bottom: root.safe-area-insets.bottom;
        safe-left: root.safe-area-insets.left; safe-right: root.safe-area-insets.right;
        choice(index) => { root.resolve-export-conflict(index); }
    }
    forward-focus: keyboard;
}
