import { MenuItem } from "chapter-menu.slint";
import { Theme, SettingsStyle } from "@NovaUiShared";
import { ScrollView } from "@NovaUiBase/scrollview.slint";
import { ControlTouchArea } from "@NovaUiBase/control-input.slint";
import { LibraryFilterChip } from "@NovaUiBase/filter-chip.slint";
import { ActionButton, ReaderField, ReaderSelect } from "controls.slint";
import { DownloadGlyph, DownloadIconButton } from "download-controls.slint";

export struct DownloadEntry {
    key: string, series-key: string, title: string, series-title: string,
    source: string, meta: string, read-meta: string, size-label: string,
    poster: image, artwork-key: string, kind: int, state: int,
    expanded: bool, selected: bool, progress: float,
    done-pages: int, total-pages: int, rate-label: string, error: string,
    local-import: bool,
    // Saved rows: closes its title's card (the last chapter shown, or a
    // closed title).
    last: bool,
}

component SavedRow inherits Rectangle {
    in property <DownloadEntry> entry;
    in property <bool> busy;
    callback action(string);
    callback artwork-requested(string);
    in property <length> viewport-top;
    in property <length> viewport-height;
    private property <string> requested-artwork;
    private property <bool> needs-artwork: root.entry.kind == 0 && root.entry.series-key != "" && root.entry.poster.width == 0
        && root.viewport-height > 0px && root.absolute-position.y + root.height > root.viewport-top
        && root.absolute-position.y < root.viewport-top + root.viewport-height
        && root.requested-artwork != root.entry.key + root.entry.artwork-key;
    changed needs-artwork => { if root.needs-artwork { root.requested-artwork = root.entry.key + root.entry.artwork-key; root.artwork-requested(root.entry.series-key); } }
    init => { if root.needs-artwork { root.requested-artwork = root.entry.key + root.entry.artwork-key; root.artwork-requested(root.entry.series-key); } }
    // A title and its open chapters draw as one card, like an Updates group:
    // the title row rounds the top, the row that closes the group the bottom.
    private property <length> corner: Theme.card_corner_radius + 4px;
    min-width: 0px; height: root.entry.kind == 0 ? 116px : 72px;
    border-top-left-radius: root.entry.kind == 0 ? root.corner : 0px;
    border-top-right-radius: root.entry.kind == 0 ? root.corner : 0px;
    border-bottom-left-radius: root.entry.last ? root.corner : 0px;
    border-bottom-right-radius: root.entry.last ? root.corner : 0px;
    clip: true;
    background: touch.feedback-active ? Theme.current.control_hover : Theme.current.card;
    accessible-role: button;
    accessible-label: root.entry.kind == 0 ? root.entry.series-title : root.entry.title;
    accessible-action-default => { if !root.busy { root.action(root.entry.kind == 0 ? "toggle-series" : "open"); } }
    scope := FocusScope {
        enabled: !root.busy;
        changed has-focus => { if self.has-focus { SettingsStyle.reveal_control(root.absolute-position.y, root.height, false); } }
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " {
                if !e.repeat { root.action(root.entry.kind == 0 ? "toggle-series" : "open"); }
                return accept;
            }
            return reject;
        }
    }
    touch := ControlTouchArea {
        enabled: !root.busy; mouse-cursor: pointer;
        clicked => { scope.focus(); root.action(root.entry.kind == 0 ? "toggle-series" : "open"); }
    }
    if root.entry.kind == 0: Rectangle {
        x: 12px; y: 10px; width: 64px; height: 96px; clip: true;
        border-radius: min(Theme.card_corner_radius, 8px); background: Theme.current.home_artwork_placeholder;
        Image { width: 100%; height: 100%; source: root.entry.poster; image-fit: cover; }
    }
    // Chapter rows: a hairline from the title text, the select box under
    // the cover.
    if root.entry.kind == 1: Rectangle { x: 90px; y: 0px; width: root.width - 90px; height: 1px; background: Theme.current.border_soft; }
    if root.entry.kind == 1: DownloadIconButton {
        x: 20px; y: 12px; enabled: !root.busy && !root.entry.local-import;
        label: root.entry.selected ? @tr("Deselect chapter") : @tr("Select chapter");
        glyph: root.entry.selected ? "selected" : "select"; accent: root.entry.selected;
        clicked => { root.action("select"); }
    }
    VerticalLayout {
        x: 90px; y: 0px;
        width: max(1px, root.width - 90px - 64px);
        height: root.height; spacing: 3px; alignment: center;
        Text {
            text: root.entry.kind == 0 ? root.entry.series-title : root.entry.title;
            font-size: root.entry.kind == 0 ? 15px : 14px; font-weight: root.entry.kind == 0 ? 600 : 400;
            color: Theme.current.text_bright; overflow: elide; min-width: 0px;
            wrap: root.entry.kind == 0 ? word-wrap : no-wrap; max-lines: root.entry.kind == 0 ? 2 : 1;
        }
        if root.entry.kind == 0: Text { text: root.entry.source; font-size: 12px; color: Theme.current.text_secondary; overflow: elide; min-width: 0px; }
        Text { text: root.entry.meta + (root.entry.size-label == "" ? "" : " · " + root.entry.size-label); font-size: 12px; color: Theme.current.text_secondary; overflow: elide; min-width: 0px; }
        if root.entry.kind == 1 && root.entry.read-meta != "": Text { text: root.entry.read-meta; font-size: 11px; color: Theme.current.text_secondary; overflow: elide; min-width: 0px; }
    }
    if root.entry.kind == 0: DownloadIconButton {
        x: root.width - 56px; y: (root.height - self.height) / 2; enabled: !root.busy;
        glyph: root.entry.expanded ? "up" : "down";
        label: root.entry.expanded ? @tr("Collapse chapters") : @tr("Expand chapters");
        clicked => { root.action("toggle-series"); }
    }
    if root.entry.kind == 1 && !root.entry.local-import: DownloadIconButton {
        x: root.width - 56px; y: (root.height - self.height) / 2; enabled: !root.busy;
        glyph: "delete"; label: @tr("Delete download"); clicked => { root.action("delete"); }
    }
    if scope.has-focus && SettingsStyle.keyboard-mode: Rectangle { width: 100%; height: 100%; border-radius: root.corner; border-width: 1px; border-color: Theme.current.accent_soft; background: transparent; }
}

component QueueRow inherits Rectangle {
    in property <DownloadEntry> entry;
    in property <bool> busy;
    in property <string> dragged-key;
    in property <length> drag-y;
    in property <length> viewport-top;
    in property <length> viewport-height;
    callback artwork-requested(string);
    callback action(string);
    callback drag-start(string);
    callback drag-motion(length);
    callback drag-end;
    callback drag-cancel;
    callback drag-enter(string);
    private property <bool> running: root.entry.state == 2;
    private property <bool> reorderable: root.entry.state == 1 && root.entry.total-pages > 0;
    private property <bool> failed: root.entry.state == 4 || root.entry.error != "";
    private property <length> text-left: root.reorderable ? 92px : root.running ? 72px : 56px;
    private property <string> requested-artwork;
    private property <bool> needs-artwork: root.entry.series-key != "" && root.entry.poster.width == 0
        && root.viewport-height > 0px && root.absolute-position.y + root.height > root.viewport-top
        && root.absolute-position.y < root.viewport-top + root.viewport-height
        && root.requested-artwork != root.entry.key + root.entry.artwork-key;
    changed needs-artwork => { if root.needs-artwork { root.requested-artwork = root.entry.key + root.entry.artwork-key; root.artwork-requested(root.entry.series-key); } }
    init => { if root.needs-artwork { root.requested-artwork = root.entry.key + root.entry.artwork-key; root.artwork-requested(root.entry.series-key); } }
    private property <bool> drop-hover: root.dragged-key != "" && root.dragged-key != root.entry.key
        && root.reorderable && root.drag-y >= root.absolute-position.y && root.drag-y < root.absolute-position.y + root.height;
    changed drop-hover => { if root.drop-hover { root.drag-enter(root.entry.key); } }
    min-width: 0px; height: root.running ? 176px : root.failed ? 128px : 100px;
    background: Theme.current.card; border-radius: Theme.card_corner_radius + 4px;
    border-width: root.drop-hover || (scope.has-focus && SettingsStyle.keyboard-mode) ? 1px : 0px;
    border-color: Theme.current.accent_soft;
    opacity: root.dragged-key == root.entry.key ? 0.55 : 1;
    scope := FocusScope {
        enabled: !root.busy;
        changed has-focus => { if self.has-focus { SettingsStyle.reveal_control(root.absolute-position.y, root.height, false); } }
        key-pressed(e) => {
            if root.reorderable && (e.text == Key.Return || e.text == " ") {
                if !e.repeat { reorder-menu.show(); }
                return accept;
            }
            if root.reorderable && e.modifiers.control && (e.text == Key.UpArrow || e.text == Key.DownArrow) {
                if !e.repeat { root.action(e.text == Key.UpArrow ? "move-up" : "move-down"); }
                return accept;
            }
            return reject;
        }
    }
    if root.reorderable: Rectangle {
        x: 0px; y: 22px; width: 48px; height: 56px;
        accessible-role: button; accessible-label: @tr("Reorder download. Control+Up moves earlier; Control+Down moves later.");
        accessible-action-default => { if !root.busy { reorder-menu.show(); } }
        DownloadGlyph { x: 12px; y: 16px; glyph: "drag"; stroke: Theme.current.text_secondary; }
        handle := ControlTouchArea {
            enabled: !root.busy; mouse-cursor: move;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { scope.focus(); root.drag-start(root.entry.key); }
                else if e.kind == PointerEventKind.up { root.drag-end(); }
                else if e.kind == PointerEventKind.cancel { root.drag-cancel(); }
            }
            moved => { if self.pressed { root.drag-motion(self.absolute-position.y + self.mouse-y); } }
        }
    }
    reorder-menu := PopupWindow {
        x: 8px; y: 68px; width: min(240px, root.width - 16px); height: 108px;
        Rectangle {
            background: Theme.current.popup; border-width: 1px; border-color: Theme.current.border_soft;
            border-radius: 14px;
            drop-shadow-offset-y: 8px; drop-shadow-blur: 24px; drop-shadow-color: #00000070;
            VerticalLayout {
                padding: 6px; spacing: 0px;
                MenuItem { label: @tr("Move earlier"); icon: "M12 19V5M6 11l6-6 6 6"; live: !root.busy && root.reorderable; activated => { reorder-menu.close(); root.action("move-up"); } }
                MenuItem { label: @tr("Move later"); icon: "M12 5v14M6 13l6 6 6-6"; live: !root.busy && root.reorderable; activated => { reorder-menu.close(); root.action("move-down"); } }
            }
        }
    }
    Rectangle {
        x: root.reorderable ? 48px : 12px; y: 16px;
        width: root.running ? 48px : 36px; height: root.running ? 72px : 54px; clip: true;
        border-radius: 5px; background: Theme.current.control_hover;
        Image { width: 100%; height: 100%; source: root.entry.poster; image-fit: cover; }
    }
    VerticalLayout {
        x: root.text-left; y: 14px;
        width: max(1px, root.width - root.text-left - (root.running ? 12px : 120px));
        height: 72px; spacing: 3px; alignment: start;
        Text { text: root.entry.series-title; font-size: 14px; font-weight: 700; color: Theme.current.text_bright; overflow: elide; min-width: 0px; }
        Text { text: root.entry.title; font-size: 12px; color: Theme.current.text_secondary; overflow: elide; min-width: 0px; }
        Text { text: root.entry.source; font-size: 11px; color: Theme.current.text_secondary; overflow: elide; min-width: 0px; }
        Text {
            text: root.entry.state == 1 && root.entry.total-pages == 0 ? @tr("Preparing chapter…") : root.running ? @tr("{} / {} pages", root.entry.done-pages, root.entry.total-pages)
                : root.entry.state == 3 ? @tr("Paused") : root.entry.state == 4 ? @tr("Needs attention")
                : root.entry.state == 5 ? @tr("Cancelled") : @tr("Queued");
            font-size: 11px; color: root.running ? Theme.current.accent_soft : Theme.current.text_secondary;
            overflow: elide; min-width: 0px;
        }
    }
    if root.running: Rectangle {
        x: 12px; y: 98px; width: max(1px, root.width - 24px); height: 4px;
        border-radius: 2px; background: Theme.current.control_hover;
        Rectangle { x: 0px; y: 0px; width: parent.width * max(0, min(1, root.entry.progress)); height: 4px; border-radius: 2px; background: Theme.current.accent_soft; }
    }
    if root.running: Text {
        x: 12px; y: 112px; width: max(1px, root.width - 128px); height: 44px;
        text: root.entry.rate-label; font-size: 12px; color: Theme.current.text_secondary; wrap: word-wrap;
    }
    if root.entry.error != "" && !root.running: Text {
        x: 12px; y: 98px; width: max(1px, root.width - 24px); height: 20px;
        text: root.entry.error; font-size: 12px; color: Theme.current.accent_soft; overflow: elide;
        accessible-label: root.entry.error;
    }
    DownloadIconButton {
        x: root.width - 112px; y: root.running ? 120px : 24px;
        glyph: root.entry.state == 1 || root.running ? "pause" : root.entry.state == 3 ? "play" : "retry";
        label: root.entry.state == 1 || root.running ? @tr("Pause download") : root.entry.state == 3 ? @tr("Resume download") : @tr("Retry download");
        enabled: !root.busy; accent: true;
        clicked => { root.action(root.entry.state == 1 || root.running ? "pause" : root.entry.state == 3 ? "resume" : "retry"); }
    }
    DownloadIconButton {
        x: root.width - 56px; y: root.running ? 120px : 24px;
        glyph: root.entry.state == 5 ? "delete" : "cancel";
        label: root.entry.state == 5 ? @tr("Delete cancelled download") : @tr("Cancel download"); enabled: !root.busy;
        clicked => { root.action(root.entry.state == 5 ? "delete" : "cancel"); }
    }
}

// Downloaded | Queue as chips with their counts (the label keeps "Queue 3").
component TabChip inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <bool> selected;
    callback picked;
    height: 34px; width: chip-row.preferred-width + 24px;
    border-radius: Theme.button_corner_radius + 2px;
    background: root.selected ? Theme.current.selection_fill : touch.has-hover ? Theme.current.control_hover : Theme.current.card;
    border-width: 1px; border-color: root.selected ? Theme.current.accent : Theme.current.border_soft;
    accessible-role: button; accessible-label: root.label + " " + root.count;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.picked(); }
    chip-row := HorizontalLayout {
        x: 12px; width: self.preferred-width; height: 100%; spacing: 6px;
        Text { text: root.label; font-size: 13px; font-weight: 600; color: Theme.current.text_bright; vertical-alignment: center; }
        Text { text: root.count; font-size: 11px; color: Theme.current.text_secondary; vertical-alignment: center; }
    }
    touch := ControlTouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }
}

// The live queue at the top: the chapter downloading now (the queue's
// first row), overall progress and the bulk controls.
component QueueCard inherits Rectangle {
    in property <DownloadEntry> entry;
    in property <string> summary;
    in property <bool> busy;
    callback action(string);
    height: card.preferred-height;
    border-radius: Theme.card_corner_radius + 4px;
    background: Theme.current.card; border-width: 1px; border-color: Theme.current.border_soft;
    accessible-role: groupbox; accessible-label: @tr("Download queue");
    card := VerticalLayout {
        padding: 14px; spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 40px; height: 60px; clip: true; border-radius: 6px;
                background: Theme.current.home_artwork_placeholder;
                Image { width: 100%; height: 100%; source: root.entry.poster; image-fit: cover; }
            }
            VerticalLayout {
                alignment: center; spacing: 2px; horizontal-stretch: 1; min-width: 0px;
                Text { text: root.entry.series-title; font-size: 14px; font-weight: 600; color: Theme.current.text_bright; overflow: elide; }
                Text {
                    text: root.entry.state == 2 ? root.entry.title + " · " + @tr("{} / {} pages", root.entry.done-pages, root.entry.total-pages) : root.entry.title;
                    font-size: 12px; color: Theme.current.text_secondary; overflow: elide;
                }
            }
            // Bulk controls as icons, so the card stays short on a phone.
            VerticalLayout { alignment: center; DownloadIconButton {
                glyph: "pause"; accent: true; label: @tr("Pause all"); enabled: !root.busy;
                clicked => { root.action("pause-all"); }
            } }
            VerticalLayout { alignment: center; DownloadIconButton {
                glyph: "play"; label: @tr("Resume all"); enabled: !root.busy;
                clicked => { root.action("resume-all"); }
            } }
        }
        if root.entry.state == 2: Rectangle {
            height: 4px; border-radius: 2px; background: Theme.current.progress_track_overlay;
            Rectangle { x: 0px; y: 0px; height: 100%; border-radius: 2px; background: Theme.current.accent; width: parent.width * Math.clamp(root.entry.progress, 0, 1); }
        }
        Text { text: root.summary; font-size: 12px; color: Theme.current.text_secondary; wrap: word-wrap; }
    }
}

export component DownloadsPanel inherits Rectangle {
    in property <[DownloadEntry]> downloaded;
    in property <[DownloadEntry]> queue;
    in property <int> downloaded-count;
    in property <int> queue-count;
    in property <int> selected-count;
    in property <string> summary;
    in property <string> queue-summary;
    in property <string> selected-size;
    in property <bool> busy;
    in-out property <int> active-tab;
    in-out property <string> query;
    in-out property <bool> unread-only;
    in-out property <int> sort;
    callback search-changed(string);
    callback filter-changed(bool, int);
    callback action(string, string);
    callback reorder(string, string);
    callback artwork-requested(string);
    private property <bool> compact: root.width < 920px;
    private property <string> dragged-key;
    private property <string> drop-before;
    private property <length> drag-y: -10000px;
    min-width: 0px;
    VerticalLayout {
        spacing: 14px;
        // On a phone the Queue tab lists the same rows, so the card shows
        // with the downloaded chapters only.
        if root.queue-count > 0 && root.queue.length > 0 && (!root.compact || root.active-tab == 0): QueueCard {
            entry: root.queue[0]; summary: root.queue-summary; busy: root.busy;
            action(which) => { root.action("", which); }
        }
        if root.compact: HorizontalLayout {
            spacing: 6px; alignment: start;
            TabChip { label: @tr("Downloaded"); count: root.downloaded-count; selected: root.active-tab == 0; picked => { root.active-tab = 0; } }
            TabChip { label: @tr("Queue"); count: root.queue-count; selected: root.active-tab == 1; picked => { root.active-tab = 1; } }
        }
        HorizontalLayout {
            spacing: root.compact ? 0px : 12px;
            if !root.compact || root.active-tab == 0: VerticalLayout {
                width: root.compact ? root.width : (root.width - 25px) * 0.64; spacing: 12px;
                if !root.compact: Text { text: @tr("Downloaded"); font-size: 17px; font-weight: 700; color: Theme.current.text_bright; }
                Text { text: root.summary; font-size: 12px; color: Theme.current.text_secondary; wrap: word-wrap; }
                ReaderField {
                    text <=> root.query; placeholder-text: @tr("Search titles or chapters");
                    edited(value) => { root.search-changed(value); }
                    accepted(value) => { root.search-changed(value); }
                }
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout { alignment: center; LibraryFilterChip {
                        tonal: true; chip-height: 34px; keyboard-focusable: true; label: @tr("All"); selected: !root.unread-only;
                        picked => { root.unread-only = false; root.filter-changed(false, root.sort); }
                        accessible-action-default => { root.unread-only = false; root.filter-changed(false, root.sort); }
                    } }
                    VerticalLayout { alignment: center; LibraryFilterChip {
                        tonal: true; chip-height: 34px; keyboard-focusable: true; label: @tr("Unread"); selected: root.unread-only;
                        picked => { root.unread-only = true; root.filter-changed(true, root.sort); }
                        accessible-action-default => { root.unread-only = true; root.filter-changed(true, root.sort); }
                    } }
                    Rectangle { horizontal-stretch: 1; }
                    ReaderSelect {
                        width: 150px; horizontal-stretch: 0;
                        model: [@tr("By title"), @tr("By size")];
                        current-index <=> root.sort; placeholder-text: @tr("Sort downloads");
                        selected(value) => { root.filter-changed(root.unread-only, self.current-index); }
                    }
                }
                saved-scroll := ScrollView {
                    min-height: 80px; vertical-stretch: 1; content-width: self.visible-width;
                    mouse-drag-pan-enabled: true;
                    VerticalLayout {
                        spacing: 0px; padding-bottom: 12px; alignment: start;
                        if root.downloaded.length == 0: Text {
                            text: root.busy ? @tr("Updating downloads…") : root.query != "" || root.unread-only ? @tr("No matching chapters. Try another search or show all chapters.") : @tr("Your saved chapters will appear here. Download a chapter from its series page to read offline.");
                            wrap: word-wrap; color: Theme.current.text_secondary; font-size: 14px;
                        }
                        // Cards sit 8px apart; a title's chapters join its card.
                        for entry[index] in root.downloaded: VerticalLayout {
                            padding-top: entry.kind == 0 && index > 0 ? 8px : 0px;
                            SavedRow {
                                entry: entry; busy: root.busy;
                                viewport-top: saved-scroll.absolute-position.y; viewport-height: saved-scroll.height;
                                action(which) => { root.action(entry.key, which); }
                                artwork-requested(key) => { root.artwork-requested(key); }
                            }
                        }
                    }
                }
                if root.selected-count > 0: VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        Text { text: @tr("{} selected", root.selected-count); font-size: 14px; color: Theme.current.text_bright; vertical-alignment: center; }
                        DownloadIconButton { glyph: "cancel"; label: @tr("Clear selection"); enabled: !root.busy; clicked => { root.action("", "clear-selection"); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        ActionButton { text: @tr("Select all"); enabled: !root.busy; clicked => { root.action("", "select-all"); } }
                        ActionButton { text: @tr("Delete {}", root.selected-size); accent: true; enabled: !root.busy; clicked => { root.action("", "delete-selected"); } }
                    }
                }
                if root.selected-count == 0 && root.downloaded-count > 0: ActionButton {
                    text: @tr("Select all chapters"); enabled: !root.busy;
                    clicked => { root.action("", "select-all"); }
                }
            }
            if !root.compact: Rectangle { width: 1px; background: Theme.current.border_soft; }
            if !root.compact || root.active-tab == 1: VerticalLayout {
                width: root.compact ? root.width : max(280px, (root.width - 25px) * 0.36); spacing: 12px;
                if !root.compact: Text { text: @tr("Queue {}", root.queue-count); font-size: 17px; font-weight: 700; color: Theme.current.text_bright; }
                Text { text: root.queue-summary; font-size: 12px; color: Theme.current.text_secondary; wrap: word-wrap; }
                queue-scroll := ScrollView {
                    min-height: 80px; vertical-stretch: 1; content-width: self.visible-width;
                    mouse-drag-pan-enabled: root.dragged-key == "";
                    VerticalLayout {
                        spacing: 8px; alignment: start;
                        if root.queue.length == 0: Text {
                            text: @tr("Your queue is clear. New chapter downloads will appear here.");
                            wrap: word-wrap; color: Theme.current.text_secondary; font-size: 14px;
                        }
                        for entry in root.queue: QueueRow {
                            entry: entry; busy: root.busy; dragged-key: root.dragged-key; drag-y: root.drag-y;
                            viewport-top: queue-scroll.absolute-position.y; viewport-height: queue-scroll.height;
                            artwork-requested(key) => { root.artwork-requested(key); }
                            action(which) => { root.action(entry.key, which); }
                            drag-start(key) => { root.dragged-key = key; root.drop-before = key; }
                            drag-motion(y) => { root.drag-y = y; }
                            drag-enter(key) => { root.drop-before = key; }
                            drag-end => { if root.dragged-key != "" && root.drop-before != root.dragged-key { root.reorder(root.dragged-key, root.drop-before); } root.dragged-key = ""; root.drag-y = -10000px; }
                            drag-cancel => { root.dragged-key = ""; root.drag-y = -10000px; }
                        }
                        Rectangle {
                            height: root.dragged-key == "" ? 8px : 48px;
                            private property <bool> drop-hover: root.dragged-key != "" && root.drag-y >= self.absolute-position.y && root.drag-y < self.absolute-position.y + self.height;
                            changed drop-hover => { if self.drop-hover { root.drop-before = ""; } }
                            background: self.drop-hover ? Theme.current.control_hover : transparent;
                            if root.dragged-key != "": Text { text: @tr("Move to end"); color: Theme.current.text_secondary; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}
