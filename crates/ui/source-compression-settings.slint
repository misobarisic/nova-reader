// Addon-scoped compression using the same Nova Kit controls as global settings.
import { Dropdown } from "@NovaUiBase/dropdown.slint";
import { InterfaceStyle } from "@NovaUiShared";
import { SettingsCard, SectionHeader } from "@NovaUiBase/settings-controls.slint";
import { CacheCompressionToggle, CacheQualityControl } from "@NovaUiBase/cache-settings-controls.slint";
import { SettingsRow } from "settings-row.slint";

export global SourceCompressionSettings {
    in-out property <string> source-id;
    in-out property <bool> use-global: true;
    in-out property <bool> cache-enabled: true;
    in-out property <int> cache-format: 1;
    in-out property <float> cache-quality: 85;
    in-out property <bool> cache-jxl-lossless-jpeg: false;
    in-out property <bool> cache-lossless-inputs: false;
    in-out property <bool> downloads-enabled: false;
    in-out property <int> downloads-format: 1;
    in-out property <float> downloads-quality: 85;
    in-out property <bool> downloads-jxl-lossless-jpeg: false;
    in-out property <bool> downloads-lossless-inputs: false;
    callback settings-changed(string, int);
}

export component SourceCompressionSettingsPanel inherits VerticalLayout {
    in property <bool> interactive: true;
    spacing: 16px; alignment: start;
    SectionHeader { label: @tr("Image compression"); }
    SettingsCard {
        SettingsRow {
            row-title: @tr("Use global compression settings");
            row-desc: @tr("Follow global Cache settings for this addon. Turn off to choose whether and how its cached images and chapter downloads are compressed.");
            CacheCompressionToggle {
                name: @tr("Use global compression settings");
                busy: !root.interactive;
                checked <=> SourceCompressionSettings.use-global;
                toggled => { SourceCompressionSettings.settings-changed("use_global", self.checked ? 1 : 0); }
            }
        }
    }
    if !SourceCompressionSettings.use-global: VerticalLayout {
        spacing: 16px; alignment: start;
    SectionHeader { label: @tr("Cache compression"); }
    SettingsCard {
        SettingsRow {
            row-title: @tr("Compress cached images");
            row-desc: @tr("Compress new temporary chapter pages and artwork. Existing files stay unchanged; unsupported images keep their original encoding.");
            CacheCompressionToggle {
                name: @tr("Compress cached images");
                disk-enabled: true; busy: !root.interactive;
                checked <=> SourceCompressionSettings.cache-enabled;
                toggled => { SourceCompressionSettings.settings-changed("cache_enabled", self.checked ? 1 : 0); }
            }
        }
        cache_format_row := SettingsRow {
            row-title: @tr("Cache format"); row-desc: @tr("JPEG, WebP, AVIF or JPEG XL for newly cached images.");
            cache_format := Dropdown {
                width: Math.min(252px, Math.max(0px, root.width - 32px)); roomy: true;
                model: [@tr("JPEG"), @tr("WebP"), @tr("AVIF"), @tr("JPEG XL")];
                enabled: root.interactive && SourceCompressionSettings.cache-enabled;
                current-index <=> SourceCompressionSettings.cache-format;
                selected(i) => { SourceCompressionSettings.settings-changed("cache_format", self.current-index); }
            }
        }
        cache_quality_row := SettingsRow {
            row-title: @tr("Cache quality"); row-desc: @tr("Higher values retain more detail and use more disk space.");
            CacheQualityControl {
                width: Math.min(InterfaceStyle.tv ? 320px : 252px, Math.max(0px, root.width - 32px));
                disk-enabled: true; compression-enabled: SourceCompressionSettings.cache-enabled;
                busy: !root.interactive;
                name: @tr("Cache quality"); increase-label: @tr("Increase cache quality"); decrease-label: @tr("Decrease cache quality");
                value <=> SourceCompressionSettings.cache-quality;
                changed(v) => { SourceCompressionSettings.settings-changed("cache_quality", Math.round(v)); }
            }
        }
        if SourceCompressionSettings.cache-format == 1 || SourceCompressionSettings.cache-format == 3: cache_lossless_row := SettingsRow {
            row-title: @tr("Lossless encoding for lossless inputs");
            row-desc: @tr("Preserve pixels from lossless PNG and WebP inputs. Lossy and unrecognized inputs use the selected quality. Unresized high-depth PNGs keep their original encoding.");
            CacheCompressionToggle {
                name: @tr("Lossless encoding for lossless inputs");
                busy: !root.interactive || !SourceCompressionSettings.cache-enabled;
                checked <=> SourceCompressionSettings.cache-lossless-inputs;
                toggled => { SourceCompressionSettings.settings-changed("cache_lossless_inputs", self.checked ? 1 : 0); }
            }
        }
        if SourceCompressionSettings.cache-format == 3: cache_transcode_row := SettingsRow {
            row-title: @tr("Losslessly transcode JPEG");
            row-desc: @tr("Preserve original JPEG data when no resize is needed. Other images follow the cache compression settings.");
            CacheCompressionToggle {
                name: @tr("Losslessly transcode cache JPEG");
                busy: !root.interactive || !SourceCompressionSettings.cache-enabled;
                checked <=> SourceCompressionSettings.cache-jxl-lossless-jpeg;
                toggled => { SourceCompressionSettings.settings-changed("cache_jxl_lossless_jpeg", self.checked ? 1 : 0); }
            }
        }
    }
    SectionHeader { label: @tr("Download compression"); }
    SettingsCard {
        SettingsRow {
            row-title: @tr("Compress chapter downloads");
            row-desc: @tr("Re-encode new chapter pages at their original dimensions before saving. Existing downloads stay unchanged; unsupported images keep their original encoding.");
            CacheCompressionToggle {
                name: @tr("Compress chapter downloads");
                busy: !root.interactive; checked <=> SourceCompressionSettings.downloads-enabled;
                toggled => { SourceCompressionSettings.settings-changed("downloads_enabled", self.checked ? 1 : 0); }
            }
        }
        downloads_format_row := SettingsRow {
            row-title: @tr("Download format"); row-desc: @tr("JPEG, WebP, AVIF or JPEG XL for new offline chapter pages.");
            downloads_format := Dropdown {
                width: Math.min(252px, Math.max(0px, root.width - 32px)); roomy: true;
                model: [@tr("JPEG"), @tr("WebP"), @tr("AVIF"), @tr("JPEG XL")];
                enabled: root.interactive && SourceCompressionSettings.downloads-enabled;
                current-index <=> SourceCompressionSettings.downloads-format;
                selected(i) => { SourceCompressionSettings.settings-changed("downloads_format", self.current-index); }
            }
        }
        downloads_quality_row := SettingsRow {
            row-title: @tr("Download quality"); row-desc: @tr("Higher values retain more detail and use more disk space.");
            CacheQualityControl {
                width: Math.min(InterfaceStyle.tv ? 320px : 252px, Math.max(0px, root.width - 32px));
                busy: !root.interactive; compression-enabled: SourceCompressionSettings.downloads-enabled;
                name: @tr("Download quality"); increase-label: @tr("Increase download quality"); decrease-label: @tr("Decrease download quality");
                value <=> SourceCompressionSettings.downloads-quality;
                changed(v) => { SourceCompressionSettings.settings-changed("downloads_quality", Math.round(v)); }
            }
        }
        if SourceCompressionSettings.downloads-format == 1 || SourceCompressionSettings.downloads-format == 3: downloads_lossless_row := SettingsRow {
            row-title: @tr("Lossless encoding for lossless inputs");
            row-desc: @tr("Preserve pixels from lossless PNG and WebP inputs. Lossy and unrecognized inputs use the selected quality. High-depth PNGs keep their original encoding.");
            CacheCompressionToggle {
                name: @tr("Lossless encoding for lossless download inputs");
                busy: !root.interactive || !SourceCompressionSettings.downloads-enabled;
                checked <=> SourceCompressionSettings.downloads-lossless-inputs;
                toggled => { SourceCompressionSettings.settings-changed("downloads_lossless_inputs", self.checked ? 1 : 0); }
            }
        }
        if SourceCompressionSettings.downloads-format == 3: downloads_transcode_row := SettingsRow {
            row-title: @tr("Losslessly transcode JPEG");
            row-desc: @tr("Preserve original JPEG data when no resize is needed. Other images and resized JPEGs use the selected quality.");
            CacheCompressionToggle {
                name: @tr("Losslessly transcode download JPEG");
                busy: !root.interactive || !SourceCompressionSettings.downloads-enabled;
                checked <=> SourceCompressionSettings.downloads-jxl-lossless-jpeg;
                toggled => { SourceCompressionSettings.settings-changed("downloads_jxl_lossless_jpeg", self.checked ? 1 : 0); }
            }
        }
    }    }
}
