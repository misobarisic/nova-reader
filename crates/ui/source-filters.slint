import { Theme } from "@NovaUiShared";
import { SettingsCard, ToggleSwitch } from "@NovaUiBase/settings-controls.slint";
import { SettingRow } from "media-models.slint";
import { SettingsRow } from "settings-row.slint";
import { ActionButton, ReaderField, ReaderSelect } from "controls.slint";

export component SourceFilterPanel inherits VerticalLayout {
    min-width: 0px;
    in property <[SettingRow]> settings;
    in property <string> notice;
    callback changed(string, string);
    callback selection-changed(string, int);
    callback apply;
    spacing: 12px; alignment: start; vertical-stretch: 0;

    if root.notice != "": Text {
        min-width: 0px; text: root.notice; wrap: word-wrap;
        color: Theme.current.text_secondary; font-size: 14px;
    }
    if root.settings.length > 0: SettingsCard {
        min-width: 0px;
        for setting in root.settings: SettingsRow {
            row-title: setting.name;
            if setting.kind == "select": ReaderSelect {
                width: 180px; model: setting.options;
                current-index: setting.selected; placeholder-text: setting.name;
                selected(_) => { root.selection-changed(setting.key, self.current-index); }
            }
            if setting.kind == "text": ReaderField {
                width: 180px; text: setting.value; placeholder-text: setting.name;
                edited(value) => { root.changed(setting.key, value); }
            }
            if setting.kind == "bool": ToggleSwitch {
                name: setting.name; checked: setting.checked;
                accessible-action-default => {
                    self.checked = !self.checked;
                    root.changed(setting.key, self.checked ? "true" : "false");
                }
                toggled => { root.changed(setting.key, self.checked ? "true" : "false"); }
            }
        }
    }
    if root.settings.length == 0: Text {
        min-width: 0px; text: @tr("This source has no browse filters.");
        color: Theme.current.text_secondary; font-size: 14px; wrap: word-wrap;
    }
    ActionButton { text: @tr("Apply filters"); accent: true; clicked => { root.apply(); } }
}
