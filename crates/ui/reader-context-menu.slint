import { ControlTouchArea } from "@NovaUiBase/control-input.slint";
import { Theme, SettingsStyle } from "@NovaUiShared";
import { Spinner } from "std-widgets.slint";

// TouchArea remains inside the reader's Flickable: a pan cancels its pointer
// grab, while only a stationary press can become an image context request.
export component ReaderImageInteraction inherits ControlTouchArea {
    in property <bool> context-enabled: true;
    in property <bool> long-press-enabled: true;
    in property <bool> double-tap-enabled: false;
    callback tapped;
    callback positioned-tap(length, length);
    callback double-tapped(length, length);
    callback context-requested(length, length);
    private property <bool> suppress-tap;
    private property <bool> dragged;
    private property <bool> pending-tap;
    private property <length> pending-window-x;
    private property <length> pending-window-y;
    private property <length> press-window-x;
    private property <length> press-window-y;
    mouse-cursor: pointer;
    function cancel-pending() { single-tap.stop(); root.pending-tap = false; }
    function emit-single(x: length, y: length) {
        root.tapped();
        root.positioned-tap(x, y);
    }
    clicked => {
        if root.suppress-tap || root.dragged { return; }
        let x = root.absolute-position.x + root.mouse-x;
        let y = root.absolute-position.y + root.mouse-y;
        if !root.double-tap-enabled {
            root.emit-single(x, y);
        } else if root.pending-tap && Math.max(Math.abs(x - root.pending-window-x), Math.abs(y - root.pending-window-y)) <= 24px {
            root.cancel-pending();
            root.double-tapped(x, y);
        } else {
            // Distant clicks remain two independent taps. Wait until release
            // before publishing either, so a second gesture can still pan.
            if root.pending-tap { root.emit-single(root.pending-window-x, root.pending-window-y); }
            root.pending-tap = true;
            root.pending-window-x = x;
            root.pending-window-y = y;
            single-tap.start();
        }
    }
    pointer-event(event) => {
        if event.kind == PointerEventKind.down {
            root.dragged = false;
            root.suppress-tap = event.button != PointerEventButton.left;
            root.press-window-x = root.absolute-position.x + root.mouse-x;
            root.press-window-y = root.absolute-position.y + root.mouse-y;
            hold.stop();
            // Pause the first tap while the second press establishes whether
            // it is a double tap, a hold, or a scroll gesture.
            single-tap.stop();
            if event.button != PointerEventButton.left { root.cancel-pending(); }
            if event.button == PointerEventButton.left && root.context-enabled && root.long-press-enabled { hold.start(); }
        } else if event.kind == PointerEventKind.up {
            hold.stop();
            if event.button == PointerEventButton.right && !root.dragged && root.context-enabled {
                root.cancel-pending();
                root.suppress-tap = true;
                SettingsStyle.keyboard-mode = false;
                root.context-requested(root.absolute-position.x + root.mouse-x, root.absolute-position.y + root.mouse-y);
            }
        } else if event.kind == PointerEventKind.move && event.touch-finger-id != 0 && root.pending-tap {
            // Flickable can observe a touch move before it delivers its delayed
            // second press. Discard the old tap as soon as that touch pans.
            if Math.max(Math.abs(root.absolute-position.x + root.mouse-x - root.pending-window-x), Math.abs(root.absolute-position.y + root.mouse-y - root.pending-window-y)) > 12px {
                root.cancel-pending();
            }
        } else if event.kind == PointerEventKind.cancel {
            hold.stop(); root.cancel-pending();
            root.dragged = true; root.suppress-tap = true;
        }
    }
    moved => {
        if root.pressed && Math.abs(root.absolute-position.x + root.mouse-x - root.press-window-x)
            + Math.abs(root.absolute-position.y + root.mouse-y - root.press-window-y) > 12px {
            hold.stop(); root.cancel-pending();
            root.dragged = true; root.suppress-tap = true;
        }
    }
    changed enabled => { if !root.enabled { hold.stop(); root.cancel-pending(); } }
    changed double-tap-enabled => { root.cancel-pending(); }
    changed long-press-enabled => { if !root.long-press-enabled { hold.stop(); } }
    changed context-enabled => { if !root.context-enabled { hold.stop(); } }
    single-tap := Timer {
        interval: 250ms; running: false;
        triggered => {
            self.stop();
            if root.pending-tap {
                root.pending-tap = false;
                root.emit-single(root.pending-window-x, root.pending-window-y);
            }
        }
    }
    hold := Timer {
        interval: 600ms; running: false;
        triggered => {
            self.stop();
            if root.pressed && !root.dragged && root.context-enabled && root.long-press-enabled {
                root.cancel-pending();
                root.suppress-tap = true;
                SettingsStyle.keyboard-mode = false;
                root.context-requested(root.absolute-position.x + root.mouse-x, root.absolute-position.y + root.mouse-y);
            }
        }
    }
}

struct ReaderImageAction { label: string, id: string, icon: int }

export component ReaderContextMenu inherits Rectangle {
    in property <length> viewport-left;
    in property <length> viewport-top;
    in property <length> viewport-width;
    in property <length> viewport-height;
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <bool> busy;
    in property <bool> simple-screencaps: true;
    callback picked(string);
    callback dismissed;
    private property <int> selected: 0;
    private property <[ReaderImageAction]> actions: root.simple-screencaps ? [
        { label: @tr("Save image"), id: "save-image", icon: 0 },
        { label: @tr("Save screencap"), id: "save-screencap", icon: 1 },
        { label: @tr("Copy image to clipboard"), id: "copy-image", icon: 2 },
        { label: @tr("Copy screencap"), id: "copy-screencap", icon: 3 },
        { label: @tr("Save screencap (simple)"), id: "save-screencap-simple", icon: 1 },
        { label: @tr("Copy screencap (simple)"), id: "copy-screencap-simple", icon: 3 },
    ] : [
        { label: @tr("Save image"), id: "save-image", icon: 0 },
        { label: @tr("Save screencap"), id: "save-screencap", icon: 1 },
        { label: @tr("Copy image to clipboard"), id: "copy-image", icon: 2 },
        { label: @tr("Copy screencap"), id: "copy-screencap", icon: 3 },
    ];
    private property <length> menu-content-height: 16px + root.actions.length * 54px + 9px;
    changed simple-screencaps => { root.selected = 0; }
    init => { scope.focus(); }
    function reveal-selected() {
        let top = 8px + root.selected * 54px + (root.selected >= 2 ? 9px : 0px);
        if top < -menu-scroll.content-y { menu-scroll.content-y = -top; }
        else if top + 54px > -menu-scroll.content-y + menu-scroll.height {
            menu-scroll.content-y = menu-scroll.height - top - 54px;
        }
    }
    TouchArea {
        width: 100%; height: 100%;
        clicked => { root.dismissed(); }
    }
    menu-panel := Rectangle {
        width: min(340px, max(1px, root.viewport-width - 24px));
        height: min(root.menu-content-height, max(1px, root.viewport-height - 24px));
        x: Math.clamp(root.anchor-x, root.viewport-left + 12px,
            root.viewport-left + max(12px, root.viewport-width - self.width - 12px));
        y: Math.clamp(root.anchor-y, root.viewport-top + 12px,
            root.viewport-top + max(12px, root.viewport-height - self.height - 12px));
        background: Theme.current.popup;
        border-radius: max(12px, Theme.card_corner_radius);
        border-width: 1px; border-color: Theme.current.border_medium;
        drop-shadow-offset-y: 6px; drop-shadow-blur: 20px; drop-shadow-color: #00000060;
        clip: true;
        accessible-role: groupbox; accessible-label: @tr("Image actions");
        TouchArea { width: 100%; height: 100%; }
        menu-scroll := Flickable {
            width: 100%; height: 100%;
            content-width: self.width; content-height: root.menu-content-height;
            interactive: self.height < self.content-height;
            for action[index] in root.actions: Rectangle {
                x: 8px; y: 8px + index * 54px + (index >= 2 ? 9px : 0px);
                width: max(1px, menu-scroll.width - 16px); height: 54px;
                border-radius: max(6px, min(12px, Theme.button_corner_radius));
                background: !root.busy && (touch.feedback-active || (scope.has-focus && SettingsStyle.keyboard-mode && root.selected == index))
                    ? Theme.current.settings_control_hover : transparent;
                opacity: root.busy ? 0.45 : 1;
                accessible-role: button; accessible-label: action.label;
                accessible-enabled: !root.busy;
                accessible-action-default => { if !root.busy { root.picked(action.id); } }
                Path {
                    x: 14px; y: 17px; width: 20px; height: 20px;
                    viewbox-width: 24; viewbox-height: 24;
                    stroke: Theme.current.accent_soft; stroke-width: 1.5px; fill: transparent;
                    commands: action.icon == 0 ? "M4 4h11l5 4v12H4zM15 4v4h5M7 17l4-5 3 3 2-2 3 4"
                        : action.icon == 1 ? "M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5M12 8v8M9 13l3 3 3-3"
                        : action.icon == 2 ? "M8 8h12v12H8zM4 16V4h12M10 17l3-4 3 3 2-2 2 3"
                        : "M9 5H5v16h15V5h-4M9 3h7v4H9zM8 11h3M14 11h3M8 15h3M14 15h3";
                }
                Text {
                    x: 48px; y: 0px; width: max(1px, parent.width - 60px); height: 100%;
                    text: action.label; color: Theme.current.text_bright;
                    font-size: 14px; wrap: word-wrap; vertical-alignment: center;
                }
                if root.busy && index == 0: Spinner {
                    x: parent.width - 30px; y: 17px; width: 20px; height: 20px;
                    accessible-label: @tr("Preparing image…");
                }
                touch := ControlTouchArea {
                    enabled: !root.busy; mouse-cursor: pointer;
                    clicked => { root.picked(action.id); }
                    moved => { root.selected = index; SettingsStyle.keyboard-mode = false; }
                }
            }
            Rectangle {
                x: 16px; y: 120px; width: max(1px, parent.width - 32px); height: 1px;
                background: Theme.current.border_medium;
            }
        }
    }
    scope := FocusScope {
        // Keyboard ownership must not cover pointer targets in the panel.
        width: 0px; height: 0px;
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Back || event.text == Key.Backspace || event.text == Key.Menu {
                root.dismissed(); return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Tab {
                SettingsStyle.keyboard-mode = true;
                root.selected = Math.mod(root.selected + (event.text == Key.UpArrow || (event.text == Key.Tab && event.modifiers.shift) ? root.actions.length - 1 : 1), root.actions.length);
                root.reveal-selected(); return accept;
            }
            if event.text == Key.Return || event.text == " " {
                if !event.repeat && !root.busy { root.picked(root.actions[root.selected].id); }
                return accept;
            }
            // Page navigation must never run underneath the open menu.
            return accept;
        }
    }
    forward-focus: scope;
}
