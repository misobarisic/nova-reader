// The file-exists question when saving: Overwrite, Add number or cancel (2).
// Preparing bytes never chooses a destructive destination: only these explicit
// actions reach the export worker.
import { ChoiceDialog } from "@NovaUiBase/choice-dialog.slint";

export component SaveConflictSheet inherits ChoiceDialog {
    in property <string> file-name;
    prompt: @tr("File already exists: {}", root.file-name);
    labels: [@tr("Overwrite"), @tr("Add number")];
    danger-count: 1;
}
