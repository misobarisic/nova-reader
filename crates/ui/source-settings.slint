// Addon settings own a raw Flickable so horizontal sliders retain gestures.
import { Theme, SettingsStyle, SliderGesture } from "@NovaUiShared";
import { Spinner } from "std-widgets.slint";
import { ReaderField as LineEdit, ReaderSelect as ComboBox, ReaderToggle as CheckBox } from "controls.slint";
import { SettingRow } from "@NovaUiShared";
import { PageHeader } from "page-header.slint";
import { SettingsSync } from "@NovaUiShared";
import { SourceCompressionSettingsPanel } from "source-compression-settings.slint";

export component SourceSettingsPage inherits Flickable {
    in property <string> heading;
    in property <string> caption;
    in property <string> status;
    in property <bool> narrow;
    in property <bool> busy;
    in property <[SettingRow]> catalogues;
    in property <[SettingRow]> settings;
    callback back();
    callback catalogue-changed(string, bool);
    callback setting-changed(string, string);
    interactive: !SliderGesture.active;
    mouse-drag-pan-enabled: !SliderGesture.hovered;
    content-width: self.width;
    content-height: max(self.height, source-settings-content.preferred-height);
    private property <int> control-focus-request: SettingsStyle.focus-request;
    changed control-focus-request => {
        if SettingsStyle.keyboard-mode {
            let top = SettingsStyle.focus-y - self.absolute-position.y;
            if top < 0px { self.content-y -= top; }
            else if top + SettingsStyle.focus-height > self.height {
                self.content-y -= top + SettingsStyle.focus-height - self.height;
            }
        }
    }
    source-settings-content := VerticalLayout {
        x: 0px; y: 0px; width: root.width; height: self.preferred-height; min-width: 0px;
        padding: 18px; spacing: 16px; alignment: start;
        PageHeader { title: root.heading; subtitle: root.caption; narrow: root.narrow; show-back: true; back => { root.back(); } }
        if root.status != "": Rectangle {
            min-height: status-text.preferred-height + 24px;
            background: Theme.current.selection_wash; border-radius: 8px;
            status-text := Text { text: root.status; color: Theme.current.text_settings; wrap: word-wrap; x: 12px; y: 12px; width: max(0px, parent.width - 24px); }
        }
        if root.busy: HorizontalLayout {
            Spinner { width: 24px; height: 24px; }
            Text { min-width: 0px; text: @tr("Loading…"); color: Theme.current.text_secondary; }
        }
        SourceCompressionSettingsPanel { interactive: !root.busy; }
        if root.catalogues.length > 0: Text { text: @tr("Catalogues"); color: Theme.current.text_bright; font-size: 18px; font-weight: 600; }
        if root.catalogues.length > 0 && SettingsSync.enabled: Text {
            text: @tr("Catalogue switches sync with this addon. Source permissions and credentials stay on this device.");
            color: Theme.current.text_secondary; wrap: word-wrap; min-width: 0px;
        }
        for catalogue in root.catalogues: CheckBox {
            text: catalogue.name; checked: catalogue.checked;
            toggled => { root.catalogue-changed(catalogue.key, self.checked); }
        }
        for setting in root.settings: VerticalLayout {
            spacing: 8px;
            if SettingsSync.enabled: Text {
                text: setting.kind == "secret" ? @tr("This device") : @tr("Synced with this addon");
                color: Theme.current.text_secondary; font-size: 11px; wrap: word-wrap; min-width: 0px;
            }
            if setting.kind != "bool": Text { min-width: 0px; text: setting.name; color: Theme.current.text_bright; wrap: word-wrap; }
            if setting.kind == "bool": CheckBox { text: setting.name; checked: setting.checked; toggled => { root.setting-changed(setting.key, self.checked ? "true" : "false"); } }
            if setting.kind == "text" || setting.kind == "secret": LineEdit { accessible-label: setting.name; min-width: 0px; text: setting.value; input-type: setting.kind == "secret" ? InputType.password : InputType.text; placeholder-text: setting.kind == "secret" ? (setting.checked ? @tr("Saved. Enter a new secret to replace it") : @tr("Not set")) : ""; accepted => { root.setting-changed(setting.key, self.text); } }
            if setting.kind == "select": ComboBox { placeholder-text: setting.name; min-width: 0px; model: setting.options; current-index: setting.selected; selected(value) => { root.setting-changed(setting.key, value); } }
        }
        if root.settings.length > 0: Text { min-width: 0px; text: @tr("Text fields save when you press Enter. Secrets are stored on this device and are never synced. A full backup saves them in plain text."); color: Theme.current.text_secondary; wrap: word-wrap; }
    }
}
