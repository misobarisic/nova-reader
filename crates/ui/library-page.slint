// Header overlay, horizontal category rail and native scroll adapted directly
// from Nova crates/ui/library.slint; Reader owns its models and native controls.
import { Theme, SettingsStyle, Anim, InterfaceStyle } from "@NovaUiShared";
import { ControlTouchArea } from "@NovaUiBase/control-input.slint";
import { LibraryScroll } from "@NovaUiBase/library-scroll.slint";
import { LibraryFilterChip } from "@NovaUiBase/filter-chip.slint";
import { Spinner } from "std-widgets.slint";
import { ItemRow } from "media-models.slint";
import { PageHeader } from "page-header.slint";
import { IconAction } from "controls.slint";
import { Appearance } from "appearance.slint";
import { SeriesGrid, LibraryViewSwitch } from "library-cards.slint";
import { LibrarySearchReveal } from "library-search.slint";

struct SortChoice { label: string, code: int }

// One sort icon; ascending flips it vertically.
component SortGlyph inherits Path {
    in property <bool> descending: true;
    viewbox-width: 24; viewbox-height: 24; fill: transparent; stroke-width: 1.8px;
    commands: root.descending ? "M4 6h10M4 12h7M4 18h4M18 5v14M15 16l3 3 3-3" : "M4 18h10M4 12h7M4 6h4M18 19V5M15 8l3-3 3 3";
}

component SortMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <bool> focused;
    in property <bool> live: true;
    callback activated;
    height: 44px;
    border-radius: min(Theme.button_corner_radius, 10px);
    background: (touch.has-hover || root.focused) && root.live ? Theme.current.control_hover : transparent;
    border-width: root.focused && SettingsStyle.keyboard-mode ? 2px : 0px; border-color: Theme.current.focus_ring;
    accessible-role: radio-button; accessible-label: root.label;
    accessible-checkable: true; accessible-checked: root.checked; accessible-enabled: root.live;
    accessible-action-default => { if root.live { root.activated(); } }
    Text {
        x: 12px; width: parent.width - 48px; height: 100%; text: root.label; overflow: elide;
        font-size: 14px; vertical-alignment: center;
        color: root.checked ? Theme.current.text_selected : Theme.current.text_bright;
    }
    if root.checked: Path {
        x: parent.width - 32px; y: 12px; width: 20px; height: 20px;
        viewbox-width: 24; viewbox-height: 24; fill: transparent; stroke-width: 2px;
        stroke: Theme.current.accent_soft; commands: "M5 12.5l4.5 4.5L19 7.5";
    }
    touch := ControlTouchArea { enabled: root.live; mouse-cursor: pointer; clicked => { root.activated(); } }
}

// The sort menu: grows from its button like the reader's other menus.
// Picking applies and closes; Escape, Back or a tap outside close unchanged.
component LibrarySortMenu inherits Rectangle {
    in property <int> sort;
    in property <bool> descending;
    in property <length> anchor-x;
    in property <length> anchor-y;
    callback picked-sort(int);
    callback picked-direction(bool);
    callback closed;
    private property <[SortChoice]> choices: [
        { label: @tr("Last read"), code: 3 },
        { label: @tr("Recently added"), code: 0 },
        { label: @tr("Title"), code: 1 },
        { label: @tr("Unread chapters"), code: 2 },
        { label: @tr("Latest chapter"), code: 4 },
    ];
    private property <bool> shown: false;
    private property <bool> motion: Anim.enabled && Anim.player;
    private property <float> scale-progress: 0;
    private property <float> fade-progress: 0;
    animate scale-progress { duration: root.motion ? (root.shown ? Anim.player_slide : Anim.player_fast) : 0ms; easing: ease-out; }
    animate fade-progress { duration: root.motion ? Anim.player_fast : 0ms; easing: ease-out; }
    changed motion => { root.scale-progress = root.shown ? 1 : 0; root.fade-progress = root.shown ? 1 : 0; }
    // Keyboard selection over the five sorts and two directions.
    private property <int> focus-index: 0;
    init => { reveal.start(); }
    reveal := Timer {
        interval: 1ms; running: false;
        triggered => { self.stop(); root.shown = true; root.scale-progress = 1; root.fade-progress = 1; key.focus(); }
    }
    function dismiss() {
        if !root.shown { return; }
        root.shown = false; root.scale-progress = 0; root.fade-progress = 0;
        finish.start();
    }
    finish := Timer {
        interval: root.motion ? max(1ms, Anim.player_fast) : 1ms; running: false;
        triggered => { self.stop(); root.closed(); }
    }
    function activate(index: int) {
        if index < 5 { root.picked-sort(root.choices[index].code); }
        else { root.picked-direction(index == 5); }
        root.dismiss();
    }
    key := FocusScope {
        key-pressed(e) => {
            if !root.shown { return reject; }
            if e.text == Key.Escape || e.text == Key.Back { root.dismiss(); return accept; }
            if e.text == Key.DownArrow || e.text == Key.UpArrow {
                SettingsStyle.keyboard-mode = true;
                root.focus-index = Math.mod(root.focus-index + (e.text == Key.UpArrow ? 6 : 1), 7);
                return accept;
            }
            if (e.text == Key.Return || e.text == " ") && !e.repeat { root.activate(root.focus-index); return accept; }
            return accept;
        }
        TouchArea { enabled: root.shown; clicked => { root.dismiss(); } }
        panel := Rectangle {
            width: min(240px, max(1px, root.width - 16px));
            height: content.preferred-height;
            x: Math.clamp(root.anchor-x, 8px, max(8px, root.width - self.width - 8px));
            y: Math.clamp(root.anchor-y, 8px, max(8px, root.height - self.height - 8px));
            background: Theme.current.popup;
            border-radius: Theme.card_corner_radius;
            border-width: 1px; border-color: Theme.current.border_medium;
            drop-shadow-offset-y: 8px; drop-shadow-blur: 24px; drop-shadow-color: Theme.current.scrim_shadow;
            clip: true;
            opacity: root.fade-progress;
            transform-scale: 0.86 + 0.14 * root.scale-progress;
            transform-origin: { x: 0px, y: 0px };
            accessible-role: groupbox; accessible-label: @tr("Sort library");
            TouchArea { enabled: root.shown; }
            content := VerticalLayout {
                padding: 6px; spacing: 0px;
                Text {
                    text: @tr("Sort by"); color: Theme.current.text_muted; font-size: 12px; font-weight: 600;
                    height: 28px; vertical-alignment: center;
                }
                for choice[i] in root.choices: SortMenuItem {
                    label: choice.label; checked: root.sort == choice.code;
                    focused: root.focus-index == i && key.has-focus; live: root.shown;
                    activated => { root.activate(i); }
                }
                Rectangle { height: 9px; Rectangle { y: 4px; height: 1px; background: Theme.current.border_medium; } }
                SortMenuItem {
                    label: @tr("Descending"); checked: root.descending;
                    focused: root.focus-index == 5 && key.has-focus; live: root.shown;
                    activated => { root.activate(5); }
                }
                SortMenuItem {
                    label: @tr("Ascending"); checked: !root.descending;
                    focused: root.focus-index == 6 && key.has-focus; live: root.shown;
                    activated => { root.activate(6); }
                }
            }
        }
    }
}

export component LibraryPage inherits Rectangle {
    in property <[ItemRow]> items;
    in property <[string]> categories;
    // Titles per category, parallel to `categories`.
    in property <[int]> category-counts;
    // "N titles" beside the heading.
    in property <string> count-label;
    in property <int> category-index;
    in property <string> heading;
    in property <string> caption;
    in property <string> status;
    in property <bool> busy;
    in property <bool> narrow;
    in property <bool> list-view;
    in property <int> min-cols: 2;
    in property <bool> touch-menus;
    in property <length> bottom-padding;
    in property <bool> search-open;
    in property <int> search-focus-request;
    in-out property <string> query;
    in-out property <length> scroll-y;
    in property <int> restore-index: -1;
    in property <float> restore-fraction;
    in property <int> restore-serial;
    callback category-selected(int);
    callback sort-changed();
    callback search(string);
    callback close-search();
    callback toggle-search();
    callback submitted();
    callback picked(int);
    callback context-requested(string,string,bool,length,length);
    callback request-artwork(int,int);
    callback viewport-changed(string,float,float);
    callback checkpoint();

    background: Theme.current.artwork_canvas;
    clip: true;
    // Sort: each code has a natural direction (Title A→Z, the rest newest or
    // most first); the stored flag reverses it.
    private property <int> sort: Appearance.library-sort;
    private property <bool> descending: root.sort == 1 ? Appearance.library-sort-reversed : !Appearance.library-sort-reversed;
    private property <string> sort-name: root.sort == 3 ? @tr("Last read") : root.sort == 1 ? @tr("Title")
        : root.sort == 2 ? @tr("Unread chapters") : root.sort == 4 ? @tr("Latest chapter") : @tr("Recently added");
    private property <bool> sort-menu-open;
    private property <length> sort-menu-x;
    private property <length> sort-menu-y;
    function pick-sort(code: int) {
        root.remember-position();
        Appearance.setting-changed("library_sort", code);
        root.sort-changed();
    }
    function pick-direction(descending: bool) {
        root.remember-position();
        let reversed = root.sort == 1 ? descending : !descending;
        Appearance.setting-changed("library_sort_reversed", reversed ? 1 : 0);
        root.sort-changed();
    }
    function open-sort-menu() {
        // The menu grows from the button's lower-left corner.
        root.sort-menu-x = sort-button.absolute-position.x - root.absolute-position.x;
        root.sort-menu-y = sort-button.absolute-position.y - root.absolute-position.y + sort-button.height + 4px;
        root.sort-menu-open = true;
    }
    // Nova scrolls only the hero away. The live controls are a sibling overlay,
    // so dragging or overscrolling the grid never pans the category strip.
    private property <length> header-shift: max(-library-hero.height - 14px, min(0px, root.scroll-y));
    private property <length> header-cover: library-header.height + root.header-shift;
    private property <length> grid-top: library-header.height + 8px;
    private property <bool> filtered: root.query != "" || root.category-index != 0;
    private property <bool> restoring: true;
    private property <int> restore-pass: 0;
    private property <int> pending-index: -1;
    private property <float> pending-fraction;
    private property <length> pending-y;
    private property <int> remembered-index: -1;
    private property <float> remembered-fraction;
    private property <length> remembered-y;
    private property <int> control-focus-request: SettingsStyle.focus-request;
    changed control-focus-request => {
        if SettingsStyle.keyboard-mode && !root.restoring {
            let top = SettingsStyle.focus-y - lib-scroll.absolute-position.y;
            if top < root.header-cover { lib-scroll.content-y += root.header-cover - top; }
            else if top + SettingsStyle.focus-height > lib-scroll.visible-height {
                lib-scroll.content-y -= top + SettingsStyle.focus-height - lib-scroll.visible-height;
            }
        }
    }
    function bounded(y: length) -> length {
        return Math.clamp(y, min(0px, lib-scroll.visible-height - lib-scroll.content-height), 0px);
    }
    public function remember-position() {
        if root.restoring { return; }
        let relative = root.header-cover - lib-scroll.content-y - root.grid-top - 4px;
        root.remembered-y = root.bounded(lib-scroll.content-y);
        root.remembered-index = -1;
        root.remembered-fraction = 0;
        if root.items.length > 0 && relative >= 0px && root.header-cover < lib-scroll.visible-height && relative < library-grid.height {
            let row = max(0, Math.floor(relative / library-grid.row-stride));
            root.remembered-index = min(root.items.length - 1, row * library-grid.columns);
            root.remembered-fraction = Math.clamp((relative - row * library-grid.row-stride) / library-grid.row-stride, 0, 1);
            root.viewport-changed(root.items[root.remembered-index].series-key, root.remembered-fraction, root.remembered-y / 1px);
        } else { root.viewport-changed("", 0, root.remembered-y / 1px); }
    }
    function defer-restore(index: int, fraction: float, y: length) {
        root.restoring = true;
        root.restore-pass = 0;
        root.pending-index = index;
        root.pending-fraction = fraction;
        root.pending-y = y;
        checkpoint-timer.stop();
        restore-timer.stop(); restore-timer.start();
    }
    changed restore-serial => { root.defer-restore(root.restore-index, root.restore-fraction, root.scroll-y); }
    changed width => { if !root.restoring { root.defer-restore(root.remembered-index, root.remembered-fraction, root.remembered-y); } }
    changed height => { if !root.restoring { root.defer-restore(root.remembered-index, root.remembered-fraction, root.remembered-y); } }
    init => { root.defer-restore(root.restore-index, root.restore-fraction, root.scroll-y); }
    restore-timer := Timer {
        interval: 16ms; running: false;
        triggered => {
            self.stop();
            if root.pending-index >= 0 && root.pending-index < root.items.length {
                let pinned-cover = library-header.height - library-hero.height - 14px;
                lib-scroll.content-y = root.bounded(pinned-cover - root.grid-top - 4px
                    - (Math.floor(root.pending-index / library-grid.columns) + Math.clamp(root.pending-fraction, 0, 1)) * library-grid.row-stride);
            } else { lib-scroll.content-y = root.bounded(root.pending-y); }
            lib-scroll.stop();
            // Two layout turns settle model dimensions and the native offset.
            if root.restore-pass < 2 { root.restore-pass += 1; self.start(); }
            else { root.restoring = false; root.remember-position(); }
        }
    }
    checkpoint-timer := Timer { interval: 250ms; running: false; triggered => { self.stop(); if !root.restoring { root.checkpoint(); } } }
    function pick-category(index: int) {
        root.remember-position(); root.checkpoint();
        lib-scroll.stop();
        root.category-selected(index);
    }
    private property <length> selected-filter-left;
    private property <length> selected-filter-width;
    function reveal-filter(left: length, w: length) {
        root.selected-filter-left = left;
        root.selected-filter-width = w;
        let min-x = min(0px, filter-rail.width - filter-rail.content-width);
        filter-rail.content-x = max(min-x, min(0px, filter-rail.content-x));
        if left < -filter-rail.content-x { filter-rail.content-x = -left; }
        else if left + w > -filter-rail.content-x + filter-rail.width {
            filter-rail.content-x = max(filter-rail.width - filter-rail.content-width, filter-rail.width - left - w);
        }
    }
    library-body := Rectangle {
        x: 18px; y: 18px;
        width: max(1px, parent.width - 36px); height: max(1px, parent.height - 18px);
        clip: true;
        lib-scroll := LibraryScroll {
            width: 100%; height: 100%;
            content-height: library-content.preferred-height;
            content-y <=> root.scroll-y;
            changed content-y => {
                if !root.restoring { root.remember-position(); checkpoint-timer.stop(); checkpoint-timer.start(); }
            }
            library-content := VerticalLayout {
                width: 100%; spacing: 16px; alignment: start;
                padding-top: root.grid-top;
                padding-bottom: 18px + root.bottom-padding;
                library-grid := SeriesGrid {
                    items: root.items; list-view: root.list-view; library-style: true;
                    min-cols: root.min-cols; context-enabled: true;
                    viewport-top: lib-scroll.absolute-position.y + root.header-cover;
                    viewport-height: max(0px, lib-scroll.visible-height - root.header-cover);
                    changed columns => { if !root.restoring { root.defer-restore(root.remembered-index, root.remembered-fraction, root.remembered-y); } }
                    changed row-stride => { if !root.restoring { root.defer-restore(root.remembered-index, root.remembered-fraction, root.remembered-y); } }
                    picked(i) => { root.remember-position(); root.checkpoint(); root.picked(i); }
                    context-requested(key,title,in-library,x,y) => { root.context-requested(key,title,in-library,x,y); }
                    request-artwork(first,last) => { root.request-artwork(first,last); }
                }
                if root.status != "": Rectangle {
                    min-height: status-text.preferred-height + 24px;
                    background: Theme.current.selection_wash; border-radius: Theme.card_corner_radius;
                    status-text := Text { text: root.status; color: Theme.current.text_settings; wrap: word-wrap; x: 12px; y: 12px; width: max(0px, parent.width - 24px); }
                }
                if root.busy: HorizontalLayout {
                    Spinner { width: 24px; height: 24px; }
                    Text { min-width: 0px; text: @tr("Loading…"); color: Theme.current.text_secondary; }
                }
                if root.items.length == 0 && !root.busy: Rectangle {
                    min-height: 220px;
                    VerticalLayout {
                        alignment: center; spacing: 12px;
                        Rectangle {
                            height: 56px;
                            Image { source: @image-url("../../assets/icons/navigation/library.svg"); width: 48px; height: 48px; x: (parent.width - self.width) / 2; y: 4px; image-fit: contain; colorize: Theme.current.text_muted; }
                        }
                        // A search or category with no matches is not an empty library.
                        Text { min-width: 0px; text: root.filtered ? @tr("No titles match") : @tr("Your next story starts here"); color: Theme.current.text_bright; font-size: 19px; wrap: word-wrap; horizontal-alignment: center; }
                        Text { min-width: 0px; text: root.filtered ? @tr("Try a different search or category.") : @tr("Install a source in Browse, or import a local chapter in More."); color: Theme.current.text_secondary; wrap: word-wrap; horizontal-alignment: center; }
                    }
                }
            }
        }
        // Nova's fixed viewport paints the live header over its placeholder.
        library-header := Rectangle {
            y: root.header-shift; width: 100%; height: library-toolbar.preferred-height;
            background: Theme.current.artwork_canvas;
            TouchArea {}
            library-toolbar := VerticalLayout {
                width: 100%; spacing: 14px;
                library-hero := VerticalLayout {
                    vertical-stretch: 0; spacing: 14px;
                    // "Library  N titles" on one baseline, search at the end.
                    HorizontalLayout {
                        spacing: 10px; height: 52px;
                        library-heading := Text {
                            text: root.heading; color: Theme.current.text_bright;
                            font-size: InterfaceStyle.tv ? 42px : (root.narrow ? 28px : 32px); font-weight: 700;
                            vertical-alignment: center; accessible-role: text;
                        }
                        if root.count-label != "": Text {
                            horizontal-stretch: 1; min-width: 0px; overflow: elide;
                            text: root.count-label; color: Theme.current.text_muted; font-size: 14px;
                            vertical-alignment: center; y: 5px;
                        }
                        if root.count-label == "": Rectangle { horizontal-stretch: 1; }
                        IconAction {
                            width: 44px; height: 44px; y: 4px;
                            text: root.search-open ? @tr("Close library search") : @tr("Search library");
                            icon: root.search-open ? @image-url("../../assets/icons/navigation/close.svg") : @image-url("../../assets/icons/navigation/search.svg");
                            clicked => { root.toggle-search(); }
                        }
                    }
                }
                library-controls := Rectangle {
                    height: library-search.height + library-filter-and-sort.height;
                    library-search := LibrarySearchReveal {
                        x: 0px; y: root.narrow ? library-filter-and-sort.height : 0px;
                        width: 100%; open: root.search-open; query <=> root.query;
                        viewport-height: lib-scroll.visible-height; focus-request: root.search-focus-request;
                        reveal-requested => {
                            let top = library-search.absolute-position.y - lib-scroll.absolute-position.y;
                            if top < 0px { lib-scroll.content-y -= top; }
                            else if top + 44px > lib-scroll.visible-height { lib-scroll.content-y -= top + 44px - lib-scroll.visible-height; }
                        }
                        close-requested => { root.close-search(); }
                        search(query) => { root.search(query); }
                        submitted => { root.submitted(); }
                    }
                    library-filter-and-sort := VerticalLayout {
                        y: root.narrow ? 0px : library-search.height;
                        width: 100%; height: self.preferred-height; spacing: 14px;
                        filter-rail := Flickable {
                            visible: root.categories.length > 0;
                            height: root.categories.length > 0 ? 44px : 0px; vertical-stretch: 0;
                            content-width: filter-chips.preferred-width; content-height: self.height;
                            // The rail has one horizontal axis. Native overshoot
                            // must never pull a category above/below its lane.
                            content-y: 0px;
                            changed content-y => { if self.content-y != 0px { self.content-y = 0px; } }
                            changed width => { root.reveal-filter(root.selected-filter-left, root.selected-filter-width); }
                            changed content-width => { root.reveal-filter(root.selected-filter-left, root.selected-filter-width); }
                            filter-chips := HorizontalLayout {
                                spacing: 8px; alignment: start;
                                for category[i] in root.categories: LibraryFilterChip {
                                    y: 4px;
                                    touch_feedback: root.touch-menus; keyboard-focusable: true;
                                    tonal: true; chip-height: 36px;
                                    count: i < root.category-counts.length ? root.category-counts[i] : "";
                                    label: category; selected: i == root.category-index;
                                    picked => { root.pick-category(i); }
                                    accessible-action-default => { root.pick-category(i); }
                                    reveal(left,w) => { root.reveal-filter(left,w); }
                                }
                            }
                        }
                        // Sort on the left, view switch on the right.
                        HorizontalLayout {
                            height: 44px; vertical-stretch: 0; spacing: 10px;
                            sort-button := Rectangle {
                                width: min(sort-label.preferred-width + 48px, 220px); height: 34px; y: 5px;
                                border-radius: min(Theme.button_corner_radius, self.height / 2);
                                border-width: sort-key.has-focus ? 2px : 1px;
                                border-color: sort-key.has-focus ? Theme.current.focus_ring : Theme.current.border_subtle;
                                background: sort-touch.has-hover ? Theme.current.control_hover : Theme.current.hover_subtle;
                                accessible-role: button;
                                accessible-label: @tr("Sort: {0}, {1}", root.sort-name, root.descending ? @tr("descending") : @tr("ascending"));
                                accessible-action-default => { root.open-sort-menu(); }
                                sort-icon := SortGlyph {
                                    x: 12px; y: 8px; width: 18px; height: 18px;
                                    descending: root.descending; stroke: Theme.current.text_secondary;
                                }
                                sort-label := Text {
                                    x: 36px; width: parent.width - 48px; height: 100%;
                                    text: root.sort-name; color: Theme.current.text_secondary; font-size: 13px;
                                    vertical-alignment: center; overflow: elide;
                                }
                                sort-key := FocusScope {
                                    y: -5px; height: 44px;
                                    key-pressed(e) => { if (e.text == Key.Return || e.text == " ") && !e.repeat { root.open-sort-menu(); return accept; } return reject; }
                                }
                                sort-touch := TouchArea { y: -5px; height: 44px; mouse-cursor: pointer; clicked => { root.open-sort-menu(); } }
                            }
                            Rectangle { min-width: 0px; horizontal-stretch: 1; }
                            LibraryViewSwitch { y: 5px; list-view: root.list-view; picked(list) => { root.remember-position(); Appearance.setting-changed("library_list_view", list ? 1 : 0); } }
                        }
                    }
                }
            }
        }
    }
    if root.sort-menu-open: LibrarySortMenu {
        width: root.width; height: root.height;
        sort: root.sort; descending: root.descending;
        anchor-x: root.sort-menu-x; anchor-y: root.sort-menu-y;
        picked-sort(code) => { root.pick-sort(code); }
        picked-direction(descending) => { root.pick-direction(descending); }
        closed => { root.sort-menu-open = false; sort-key.focus(); }
    }
}
