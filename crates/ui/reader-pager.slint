// Paged artwork follows the pointer, then settles onto the adjacent page.
// Image interactions retain tap/hold ownership; zoomed artwork pans instead.
export component ReaderPagerMotion inherits Rectangle {
    in property <bool> enabled;
    in property <bool> animate: true;
    in property <int> mode;
    in property <int> page;
    in property <bool> can-previous;
    in property <bool> can-next;
    in property <length> viewport-width;
    in property <length> viewport-height;
    out property <length> offset-x;
    out property <length> offset-y;
    private property <bool> dragging;
    private property <bool> settling;
    private property <int> pending-step;
    private property <bool> wheel-blocked;
    // The page step is committed on release; this keeps the leftover slide
    // animation from being snapped to zero by the resulting page change.
    private property <bool> committed;
    callback step(int);
    width: 0px; height: 0px;

    function allowed(step: int) -> bool {
        return step > 0 ? root.can-next : root.can-previous;
    }
    function direction(delta: length) -> int {
        return (delta < 0px ? 1 : -1) * (root.mode == 2 ? -1 : 1);
    }
    public function cancel() {
        settle.stop(); root.settling = false; root.dragging = false; root.committed = false;
        root.pending-step = 0; root.offset-x = 0px; root.offset-y = 0px;
    }
    public function moved(dx: length, dy: length) {
        if !root.enabled || root.settling { return; }
        let delta = root.mode == 3 ? dy : dx;
        let cross = root.mode == 3 ? dx : dy;
        if !root.dragging && (abs(delta) < 12px || abs(delta) < abs(cross) * 1.2) { return; }
        root.dragging = true;
        let extent = root.mode == 3 ? root.viewport-height : root.viewport-width;
        let displacement = clamp(delta, -extent, extent) * (root.allowed(root.direction(delta)) ? 1 : 0.2);
        if root.mode == 3 { root.offset-y = displacement; }
        else { root.offset-x = displacement; }
    }
    public function released(dx: length, dy: length) {
        if !root.enabled || !root.dragging || root.settling { return; }
        let delta = root.mode == 3 ? dy : dx;
        let cross = root.mode == 3 ? dx : dy;
        let extent = root.mode == 3 ? root.viewport-height : root.viewport-width;
        let direction = root.direction(delta);
        root.pending-step = abs(delta) >= min(96px, extent * 0.18) && abs(delta) > abs(cross) * 1.2 && root.allowed(direction) ? direction : 0;
        root.dragging = false; root.settling = true;
        if root.pending-step == 0 {
            if root.mode == 3 { root.offset-y = 0px; } else { root.offset-x = 0px; }
            settle.start();
            return;
        }
        // Commit now so leaving the reader inside the settle window cannot lose
        // the page. Re-express the drag offset against the new page, then slide.
        let step = root.pending-step;
        root.pending-step = 0; root.committed = true;
        let shift = extent * step * (root.mode == 2 ? -1 : 1);
        root.settling = false;
        if root.mode == 3 { root.offset-y += shift; } else { root.offset-x += shift; }
        root.settling = true;
        root.step(step);
        if root.mode == 3 { root.offset-y = 0px; } else { root.offset-x = 0px; }
        settle.start();
    }
    public function wheel(dx: length, dy: length) {
        if !root.enabled || root.settling || root.wheel-blocked { return; }
        let delta = root.mode == 3 || abs(dy) > abs(dx) ? dy : dx;
        if abs(delta) < 1px { return; }
        // Vertical wheels advance reading order; horizontal tracks follow the
        // physical gallery direction, including RTL.
        let direction = root.mode != 3 && abs(dx) >= abs(dy) ? root.direction(delta) : (delta < 0px ? 1 : -1);
        if !root.allowed(direction) { return; }
        root.wheel-blocked = true; wheel-delay.start(); root.step(direction);
    }
    changed enabled => { if !root.enabled { root.cancel(); } }
    changed mode => { root.cancel(); }
    changed page => { if !root.committed { root.cancel(); } }
    animate offset-x { duration: root.settling && root.animate ? 160ms : 0ms; easing: ease-out; }
    animate offset-y { duration: root.settling && root.animate ? 160ms : 0ms; easing: ease-out; }
    settle := Timer {
        interval: root.animate ? 160ms : 1ms;
        triggered => {
            self.stop();
            let step = root.pending-step;
            root.cancel();
            if step != 0 { root.step(step); }
        }
    }
    wheel-delay := Timer { interval: 200ms; triggered => { self.stop(); root.wheel-blocked = false; } }
}
