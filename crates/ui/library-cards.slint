// Poster/list geometry and painting adapted from Nova b69a1e5 library.slint.
import { Theme, Anim, SettingsStyle, ControlInput } from "@NovaUiShared";
import { FeedbackProgress } from "@NovaUiBase/feedback-motion.slint";
import { ItemRow } from "@NovaUiShared";
import { ReaderImageInteraction } from "reader-context-menu.slint";
import { DownloadGlyph } from "download-controls.slint";

// The unread count, or "+N" in accent for chapters new since the last visit.
component CountBadge inherits Rectangle {
    in property <ItemRow> card;
    private property <int> unread: max(0, root.card.total - root.card.completed);
    private property <bool> fresh: root.card.new-count > 0;
    visible: root.fresh || root.unread > 0;
    width: badge-text.preferred-width + 14px; height: 20px;
    border-radius: min(Theme.button_corner_radius, self.height / 2);
    background: root.fresh ? Theme.current.accent : Theme.current.hero_control;
    border-width: root.fresh ? 0px : 1px; border-color: Theme.current.border_overlay;
    accessible-role: text;
    accessible-label: root.fresh ? @tr("{} new chapters", root.card.new-count) : @tr("{} unread", root.unread);
    badge-text := Text {
        text: root.fresh ? "+" + root.card.new-count : root.unread;
        color: root.fresh ? Theme.current.on_accent : Theme.current.text_bright;
        font-size: 11px; font-weight: 700;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

export component LibraryViewSwitch inherits Rectangle {
    in property <bool> list-view;
    callback picked(bool);
    // 34px visible; each segment's touch and focus area spans 44px.
    width: 80px; height: 34px;
    border-radius: min(Theme.button_corner_radius, self.height / 2);
    border-width: 1px; border-color: Theme.current.border_subtle;
    background: Theme.current.hover_subtle;
    for mode in [false, true]: Rectangle {
        x: mode ? 40px : 0px; width: 40px; height: 34px;
        border-radius: root.border-radius;
        feedback := FeedbackProgress { active: root.list-view == mode; }
        background: Theme.current.selection_wash.mix(transparent, feedback.value);
        border-width: scope.has-focus ? 2px : 0px; border-color: Theme.current.focus_ring;
        accessible-role: button; accessible-label: mode ? @tr("List view") : @tr("Grid view");
        accessible-checkable: true; accessible-checked: root.list-view == mode;
        accessible-action-default => { root.picked(mode); }
        Path {
            x: 11px; y: 8px; width: 18px; height: 18px;
            viewbox-width: 24; viewbox-height: 24;
            commands: mode ? "M3 4h3v3H3zm5 0h13v3H8zM3 10h3v3H3zm5 0h13v3H8zM3 16h3v3H3zm5 0h13v3H8z" : "M3 3h7v7H3zm11 0h7v7h-7zM3 14h7v7H3zm11 0h7v7h-7z";
            fill: Theme.current.accent_vivid.mix(Theme.current.text_hint, feedback.value);
        }
        scope := FocusScope {
            y: -5px; height: 44px;
            key-pressed(e) => { if e.text == Key.Return || e.text == " " { if !e.repeat { root.picked(mode); } return accept; } return reject; }
        }
        TouchArea { y: -5px; height: 44px; mouse-cursor: pointer; clicked => { root.picked(mode); } }
    }
}

component InLibraryPill inherits Rectangle {
    height: 22px; width: in-library-text.preferred-width + 24px;
    border-radius: min(Theme.button_corner_radius, self.height / 2); background: Theme.current.accent;
    accessible-role: text; accessible-label: @tr("In library");
    Path {
        x: 7px; y: 5px; width: 11px; height: 11px; viewbox-width: 24; viewbox-height: 24;
        fill: transparent; stroke: Theme.current.on_accent; stroke-width: 3px; commands: "M5 12l5 5 9-10";
    }
    in-library-text := Text { x: 20px; height: 100%; text: @tr("In library"); font-size: 10px; font-weight: 700; color: Theme.current.on_accent; vertical-alignment: center; }
}

export component LibraryCard inherits Rectangle {
    in property <ItemRow> card;
    in property <bool> list-view;
    // The library's own look (no card frame, cover badges, detail line);
    // Browse and other grids keep the framed card.
    in property <bool> library-style;
    // Browse's catalogue: an "In library" pill replaces the unread badge.
    in property <bool> in-library-badge;
    in property <bool> context-enabled;
    in property <bool> overlay-caption;
    callback picked;
    callback context-requested(length,length);
    accessible-role: button; accessible-label: root.card.title;
    accessible-action-default => { root.picked(); }
    private property <length> poster-height: root.list-view ? root.height - 2px : root.width * 3 / 2;
    background: transparent;
    private property <bool> lifted: hover.has-hover && !hover.pressed && !ControlInput.touch-feedback && Anim.enabled && Anim.hover;
    private property <bool> partly-read: root.card.completed > 0 && root.card.completed < root.card.total;
    // ----------------------------------------------------- library grid card
    if root.library-style && !root.list-view: library-lift := Rectangle {
        width: 100%; height: 100%;
        y: root.lifted ? -4px : 0px;
        animate y { duration: Anim.hover_fast; easing: ease-out; }
        // Explicit position: an unpositioned child is centred in the card.
        cover-art := Rectangle {
            x: 0px; y: 0px; width: 100%; height: root.width * 3 / 2;
            border-radius: Theme.card_corner_radius; clip: true;
            background: Theme.current.home_artwork_placeholder;
            border-width: scope.has-focus ? 2px : 0px; border-color: Theme.current.focus_ring;
            drop-shadow-offset-y: 4px; drop-shadow-blur: 12px; drop-shadow-color: Theme.current.scrim_shadow;
            if root.card.poster.width > 0: Image { source: root.card.poster; image-fit: cover; width: 100%; height: 100%; }
            if root.card.poster.width == 0: Image {
                source: @image-url("../../assets/icons/navigation/library.svg"); image-fit: contain;
                width: 36px; height: 36px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                colorize: Theme.current.text_muted;
            }
            if !root.in-library-badge: CountBadge { x: 6px; y: 6px; card: root.card; }
            if root.in-library-badge && root.card.bookmarked: InLibraryPill { x: 6px; y: 6px; }
            if root.card.downloaded-count > 0: Rectangle {
                x: parent.width - self.width - 6px; y: 6px; width: 22px; height: 22px;
                border-radius: min(Theme.button_corner_radius, self.height / 2);
                background: Theme.current.hero_control;
                accessible-role: text; accessible-label: @tr("Downloaded");
                DownloadGlyph {
                    x: 4px; y: 4px; width: 14px; height: 14px; glyph: "download";
                    stroke: Theme.current.accent_soft; stroke-width: 2px;
                }
            }
            // Title and detail sit on the cover over a dark fade, so every
            // cover reads the same whatever its colours.
            Rectangle {
                x: 0px; y: parent.height - self.height; width: 100%;
                height: min(parent.height, caption.preferred-height + 36px);
                background: @linear-gradient(180deg, #00000000 0%, #000000b3 55%, #000000e0 100%);
            }
            caption := VerticalLayout {
                x: 8px; y: parent.height - self.height - 8px; width: parent.width - 16px; height: self.preferred-height;
                spacing: 2px; alignment: end;
                Text {
                    text: root.card.title; color: #ffffff;
                    font-size: 13px; font-weight: 600; wrap: word-wrap; max-lines: 2; overflow: elide; min-width: 0px;
                }
                if root.card.detail != "": Text {
                    text: root.card.detail; font-size: 11px; overflow: elide; min-width: 0px;
                    color: root.card.detail-success ? Theme.current.scope_synced_text : #ffffffb8;
                }
            }
            if root.partly-read: cover_progress_track := Rectangle {
                y: parent.height - 3px; height: 3px; width: 100%;
                background: Theme.current.progress_track_overlay;
                accessible-role: progress-indicator; accessible-label: @tr("Reading progress");
                accessible-value: Math.round(root.card.completed * 100 / root.card.total) + "%";
                cover_progress_fill := Rectangle {
                    x: 0px; y: 0px; height: 100%; background: Theme.current.progress_fill;
                    width: parent.width * root.card.completed / root.card.total;
                }
            }
        }
    }
    // ------------------------------------------------------ library list row
    if root.library-style && root.list-view: Rectangle {
        width: 100%; height: 100%;
        border-radius: Theme.card_corner_radius;
        background: hover.has-hover || scope.has-focus ? Theme.current.control_hover : transparent;
        border-width: scope.has-focus ? 2px : 0px; border-color: Theme.current.focus_ring;
        Rectangle {
            x: 8px; y: (parent.height - self.height) / 2; width: 52px; height: 78px;
            border-radius: Theme.card_corner_radius; clip: true;
            background: Theme.current.home_artwork_placeholder;
            if root.card.poster.width > 0: Image { source: root.card.poster; image-fit: cover; width: 100%; height: 100%; }
        }
        VerticalLayout {
            x: 72px; width: max(1px, parent.width - self.x - 12px - (list-badge.visible ? list-badge.width + 10px : 0px));
            alignment: center; spacing: 4px;
            Text { text: root.card.title; color: Theme.current.text_home_title; font-size: 15px; font-weight: 600; overflow: elide; min-width: 0px; }
            if root.card.list-detail != "": Text { text: root.card.list-detail; color: Theme.current.text_muted; font-size: 12px; overflow: elide; min-width: 0px; }
            if root.partly-read: Rectangle {
                height: 7px;
                row_progress_track := Rectangle {
                    y: 4px; height: 3px; background: Theme.current.progress_track_overlay;
                    accessible-role: progress-indicator; accessible-label: @tr("Reading progress");
                    accessible-value: Math.round(root.card.completed * 100 / root.card.total) + "%";
                    row_progress_fill := Rectangle { x: 0px; y: 0px; height: 100%; background: Theme.current.progress_fill; width: parent.width * root.card.completed / root.card.total; }
                }
            }
            if !root.partly-read && root.card.detail != "": Text {
                text: root.card.detail; font-size: 12px; overflow: elide; min-width: 0px;
                color: root.card.detail-success ? Theme.current.scope_synced_text : Theme.current.text_muted;
            }
        }
        list-badge := CountBadge { x: parent.width - self.width - 12px; y: (parent.height - self.height) / 2; card: root.card; visible: !root.in-library-badge; }
        if root.in-library-badge && root.card.bookmarked: InLibraryPill { x: parent.width - self.width - 12px; y: (parent.height - self.height) / 2; }
    }
    // ------------------------------------------------ framed card elsewhere
    if !root.library-style: lift := Rectangle {
        width: 100%; height: 100%;
        background: Theme.current.card; border-radius: Theme.card_corner_radius;
        border-width: scope.has-focus ? 2px : 1px;
        border-color: scope.has-focus ? Theme.current.accent : Theme.current.border_card;
        clip: true;
        y: hover.has-hover && !hover.pressed && !ControlInput.touch-feedback && Anim.enabled && Anim.hover ? -4px : 0px;
        animate y { duration: Anim.hover_fast; easing: ease-out; }
        Rectangle {
            x: 1px; y: 1px;
            width: root.list-view ? 92px : parent.width - 2px;
            height: root.poster-height;
            border-radius: max(0px, Theme.card_corner_radius - 1px);
            background: Theme.current.home_artwork_placeholder; clip: true;
            if root.card.poster.width > 0: Image { source: root.card.poster; image-fit: cover; width: 100%; height: 100%; }
            if root.card.poster.width == 0: Image {
                source: @image-url("../../assets/icons/navigation/library.svg"); image-fit: contain;
                width: 36px; height: 36px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                colorize: Theme.current.text_muted;
            }
            if !root.list-view: Rectangle { y: parent.height - 70px; height: 70px; width: 100%; background: @linear-gradient(180deg, transparent, Theme.current.card); }
        }
        if root.card.completed > 0 && root.card.total > 0 && !root.overlay-caption: HorizontalLayout {
            x: root.list-view ? 104px : 9px;
            y: root.list-view ? parent.height - 26px : root.poster-height - 25px;
            width: max(1px, parent.width - self.x - 9px); height: 18px; spacing: root.width > 100px ? 8px : 4px;
            Rectangle {
                horizontal-stretch: 1; min-width: 1px; height: 100%;
                library_progress_track := Rectangle {
                    y: (parent.height - self.height) / 2; width: 100%; height: 6px; border-radius: self.height / 2;
                    background: Theme.current.progress_track_overlay;
                    // Nova library.slint: anchor the fill explicitly. A smaller
                    // unpositioned child is centered by Slint's default layout.
                    library_progress_fill := Rectangle {
                        x: 0px; y: 0px;
                        width: parent.width * Math.min(1, root.card.completed * 1.0 / root.card.total);
                        height: 100%; border-radius: self.height / 2;
                        background: Theme.current.progress_fill;
                    }
                }
            }
            Text { text: root.card.completed + " / " + root.card.total; min-width: 0px; max-width: parent.width * 0.65; overflow: elide; color: Theme.current.text_primary; font-size: 11px; vertical-alignment: center; }
        }
        VerticalLayout {
            x: root.list-view ? 104px : 9px;
            y: root.list-view ? 14px : root.overlay-caption ? root.poster-height - 54px : root.poster-height + 6px;
            width: max(1px, parent.width - self.x - 9px); height: root.list-view ? 70px : 60px;
            spacing: 4px; alignment: start;
            Text { text: root.card.title; color: Theme.current.text_home_title; font-size: root.list-view ? 15px : 13px; font-weight: 600; overflow: elide; min-width: 0px; max-lines: root.overlay-caption && !root.list-view ? 2 : 1; wrap: word-wrap; }
            if !root.overlay-caption || root.list-view: Text { text: root.card.badge; color: Theme.current.text_home_metadata; font-size: 11px; overflow: elide; min-width: 0px; }
            if root.card.subtitle != "" && (!root.overlay-caption || root.list-view): Text { text: root.card.subtitle; color: Theme.current.text_download; font-size: 11px; font-weight: 600; overflow: elide; min-width: 0px; }
        }
    }
    scope := FocusScope {
        changed has-focus => { if self.has-focus { SettingsStyle.reveal_control(root.absolute-position.y, root.height, false); } }
        key-pressed(e) => {
            if root.context-enabled && (e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift)) { if !e.repeat { SettingsStyle.keyboard-mode = true; root.context-requested(root.absolute-position.x + root.width / 2,root.absolute-position.y + root.height / 2); } return accept; }
            if e.text == Key.Return || e.text == " " { if !e.repeat { root.picked(); } return accept; } return reject;
        }
    }
    hover := ReaderImageInteraction {
        context-enabled: root.context-enabled;
        tapped => { root.picked(); }
        context-requested(x,y) => { root.context-requested(x,y); }
    }
}

export component SeriesGrid inherits Rectangle {
    min-width: 0px;
    in property <[ItemRow]> items;
    in property <bool> list-view;
    in property <int> min-cols: 2;
    in property <bool> context-enabled;
    in property <bool> overlay-caption;
    // The library's own card and row look; see LibraryCard.
    in property <bool> library-style;
    in property <bool> in-library-badge;
    in property <length> viewport-top;
    in property <length> viewport-height;
    callback picked(int);
    callback context-requested(string,string,bool,length,length);
    callback request-artwork(int,int);
    // Library grids use three columns on phone widths.
    out property <int> columns: root.list-view ? 1
        : max(root.library-style && root.width < 600px ? 3 : root.min-cols, Math.floor((root.width + Theme.card_spacing) / (160px + Theme.card_spacing)));
    private property <length> item-width: max(1px, min(root.list-view ? root.width : 230px, (root.width - (root.columns - 1) * Theme.card_spacing) / root.columns));
    // Library cards are the cover alone; the caption sits on it.
    private property <length> card-height: root.library-style
        ? (root.list-view ? 94px : root.item-width * 3 / 2)
        : root.list-view ? 138px : root.item-width * 3 / 2 + (root.overlay-caption ? 0px : 76px);
    private property <length> stride: root.card-height + Theme.card_spacing;
    out property <length> row-stride: root.stride;
    private property <int> first-row: max(0, Math.floor((root.viewport-top - root.absolute-position.y) / root.stride) - 2);
    private property <int> last-row: max(0, Math.ceil((root.viewport-top + root.viewport-height - root.absolute-position.y) / root.stride) + 2);
    height: root.items.length > 0 ? Math.ceil(root.items.length / root.columns) * root.stride - Theme.card_spacing + 4px : 0px;
    function request-visible() {
        if root.visible && root.items.length > 0 { root.request-artwork(root.first-row * root.columns, min(root.items.length, (root.last-row + 1) * root.columns)); }
    }
    // Memory hits publish synchronously before paint. A coalesced retry handles
    // a callback received while Rust is still replacing the current model.
    changed first-row => { root.retry-ticks = 0; root.request-visible(); artwork-admit.restart(); }
    changed last-row => { root.retry-ticks = 0; root.request-visible(); artwork-admit.restart(); }
    changed columns => { root.retry-ticks = 0; root.request-visible(); artwork-admit.restart(); }
    changed items => { root.retry-ticks = 0; root.request-visible(); artwork-admit.restart(); }
    changed visible => { root.retry-ticks = 0; root.request-visible(); artwork-admit.restart(); }
    artwork-admit := Timer { interval: 1ms; running: false; triggered => {
        self.stop();
        root.request-visible();
    } }
    // Cold artwork loads are retried briefly. Any change of window or model
    // re-arms the budget, so an idle grid with unloadable art stops polling.
    private property <int> retry-ticks: 0;
    Timer { interval: 150ms; running: root.visible && root.items.length > 0 && root.retry-ticks < 40; triggered => { root.retry-ticks += 1; root.request-artwork(root.first-row * root.columns, min(root.items.length, (root.last-row + 1) * root.columns)); } }
    for item[i] in root.items: Rectangle {
        x: Math.mod(i, root.columns) * (root.item-width + Theme.card_spacing);
        y: Math.floor(i / root.columns) * root.stride + 4px;
        width: root.item-width; height: root.card-height;
        if Math.floor(i / root.columns) >= root.first-row && Math.floor(i / root.columns) <= root.last-row: LibraryCard {
            card: item; list-view: root.list-view; overlay-caption: root.overlay-caption; context-enabled: root.context-enabled;
            library-style: root.library-style; in-library-badge: root.in-library-badge;
            picked => { root.picked(i); }
            context-requested(x,y) => { root.context-requested(item.series-key,item.title,item.bookmarked,x,y); }
        }
    }
}
