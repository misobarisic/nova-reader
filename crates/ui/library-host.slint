import { LibraryBridge, ItemRow } from "@NovaUiShared";

// Mounts the separately compiled library page. Its properties alias
// `LibraryBridge`, so `app.slint` binds window state here as it did on the
// page itself; the bridge's callbacks are relayed to the window in Rust.
export component LibraryHost inherits Rectangle {
    // Never size from the embedded page: it sizes itself from this host.
    preferred-width: 100%; preferred-height: 100%;
    in-out property <[ItemRow]> items <=> LibraryBridge.items;
    in-out property <[string]> categories <=> LibraryBridge.categories;
    in-out property <[int]> category-counts <=> LibraryBridge.category-counts;
    in-out property <string> count-label <=> LibraryBridge.count-label;
    in-out property <int> category-index <=> LibraryBridge.category-index;
    in-out property <string> heading <=> LibraryBridge.heading;
    in-out property <string> caption <=> LibraryBridge.caption;
    in-out property <string> status <=> LibraryBridge.status;
    in-out property <bool> busy <=> LibraryBridge.busy;
    in-out property <bool> narrow <=> LibraryBridge.narrow;
    in-out property <bool> list-view <=> LibraryBridge.list-view;
    in-out property <int> min-cols <=> LibraryBridge.min-cols;
    in-out property <bool> touch-menus <=> LibraryBridge.touch-menus;
    in-out property <length> bottom-padding <=> LibraryBridge.bottom-padding;
    in-out property <bool> search-open <=> LibraryBridge.search-open;
    in-out property <int> search-focus-request <=> LibraryBridge.search-focus-request;
    in-out property <string> query <=> LibraryBridge.query;
    in-out property <length> scroll-y <=> LibraryBridge.scroll-y;
    in-out property <int> restore-index <=> LibraryBridge.restore-index;
    in-out property <float> restore-fraction <=> LibraryBridge.restore-fraction;
    in-out property <int> restore-serial <=> LibraryBridge.restore-serial;
    in-out property <length> viewport-width <=> LibraryBridge.viewport-width;
    in-out property <length> viewport-height <=> LibraryBridge.viewport-height;
    // Explicit positioning keeps the page's layout out of the host's: the page
    // sizes itself from `viewport-width`/`-height`, which come from this host.
    ComponentContainer { x: 0px; y: 0px; width: 100%; height: 100%; component-factory: LibraryBridge.factory; }
}
