// Nova's screenshot settings and NumericSetting geometry, using Kit controls.
import { InterfaceStyle } from "@NovaUiShared";
import { SettingsCard, SectionHeader, PillButton, MiniSlider, ValueBox, ToggleSwitch } from "@NovaUiBase/settings-controls.slint";
import { ReaderSelect } from "controls.slint";
import { Segmented } from "@NovaUiBase/settings-controls.slint";
import { SettingsRow } from "settings-row.slint";

export global CaptureSettings {
    in-out property <int> format-index: 0;
    in-out property <int> resolution-index: 0;
    in-out property <int> conflict-policy: 0;
    in-out property <float> jpeg-quality: 85;
    in-out property <float> webp-quality: 85;
    in-out property <float> avif-quality: 85;
    in-out property <float> jxl-quality: 85;
    in-out property <bool> series-folders: false;
    // Shows the simple Save image and screencap actions (stored as simple_screencaps).
    in-out property <bool> simple-screencaps: true;
    in-out property <int> save-source-index: 0;
    in-out property <bool> convert-saves: false;
    callback settings-changed(string, int);
}

// NumericSetting is owned by Nova's settings host; its three building blocks
// remain Kit controls so touch targets, slider behavior and value boxes match.
component NumericSetting inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: 1;
    in property <string> suffix: "";
    in property <string> name;
    in property <bool> enabled: true;
    in property <bool> focused: false;
    callback changed(float);
    function adjust(v: float) { root.value = Math.clamp(v, root.minimum, root.maximum); root.changed(root.value); }
    preferred-width: InterfaceStyle.tv ? 320px : 252px;
    min-width: 0px; height: InterfaceStyle.tv ? 56px : 44px;
    numeric-value-measure := Text { text: Math.round(root.value) + root.suffix; font-size: 20px; visible: false; }
    HorizontalLayout {
        spacing: 4px;
        PillButton {
            label: "−"; enabled: root.enabled && root.value > root.minimum;
            compact: true; btn-min-width: 44px;
            accessible-label: @tr("Decrease screenshot quality");
            accessible-action-default => { if self.enabled { root.adjust(root.value - root.step); } }
            clicked => { root.adjust(root.value - root.step); }
        }
        MiniSlider {
            min-width: 36px; horizontal-stretch: 1;
            enabled: root.enabled; focused: root.focused; name: root.name;
            value <=> root.value; minimum: root.minimum; maximum: root.maximum; step: root.step;
            changed(v) => { root.changed(v); }
        }
        ValueBox {
            width: InterfaceStyle.tv ? Math.max(64px, numeric-value-measure.preferred-width + 24px) : root.suffix == "" ? 36px : 68px;
            height: InterfaceStyle.tv ? 56px : 44px; text: Math.round(root.value) + root.suffix;
        }
        PillButton {
            label: "+"; enabled: root.enabled && root.value < root.maximum;
            compact: true; btn-min-width: 44px;
            accessible-label: @tr("Increase screenshot quality");
            accessible-action-default => { if self.enabled { root.adjust(root.value + root.step); } }
            clicked => { root.adjust(root.value + root.step); }
        }
    }
}

export component CaptureSettingsPage inherits VerticalLayout {
    in property <bool> interactive: true;
    spacing: 16px; alignment: start;
    SectionHeader { label: @tr("Saved images"); }
    SettingsCard {
        SettingsRow { setting-key: "reader:captures/save_source";
            row-title: @tr("Simple save image source");
            row-desc: CaptureSettings.save-source-index == 1
                ? @tr("Online chapters use the cached copy when it exists, otherwise the source. Downloaded chapters use the download.")
                : @tr("Online chapters fetch the page from the source; downloaded chapters use the download.");
            accessible-label: @tr("Simple save image source");
            ReaderSelect {
                width: Math.min(252px, Math.max(0px, root.width - 32px));
                enabled: root.interactive;
                placeholder-text: @tr("Simple save image source");
                model: [@tr("Page as it is"), @tr("Prefer cached copy")];
                current-index <=> CaptureSettings.save-source-index;
                selected(_) => { CaptureSettings.settings-changed("save_source", self.current-index); }
            }
        }
        SettingsRow { setting-key: "reader:captures/convert_saves";
            row-title: @tr("Convert simple saves");
            row-desc: @tr("Re-encode with the screenshot format and quality below instead of keeping the file as it is.");
            ToggleSwitch {
                name: @tr("Convert simple saves"); enabled: root.interactive;
                checked <=> CaptureSettings.convert-saves;
                accessible-action-default => { if self.enabled { self.checked = !self.checked; CaptureSettings.settings-changed("convert_saves", self.checked ? 1 : 0); } }
                toggled => { CaptureSettings.settings-changed("convert_saves", self.checked ? 1 : 0); }
            }
        }
        SettingsRow { setting-key: "reader:captures/simple_screencaps";
            row-title: @tr("Show simple image actions");
            row-desc: @tr("Add Save image (simple), Save screencap (simple) and Copy screencap (simple) to the reader menu. They act immediately with these settings; Save image… and Save screencap… let you choose first.");
            ToggleSwitch {
                name: @tr("Show simple image actions"); enabled: root.interactive;
                checked <=> CaptureSettings.simple-screencaps;
                accessible-action-default => { if self.enabled { self.checked = !self.checked; CaptureSettings.settings-changed("simple_screencaps", self.checked ? 1 : 0); } }
                toggled => { CaptureSettings.settings-changed("simple_screencaps", self.checked ? 1 : 0); }
            }
        }
    }
    SectionHeader { label: @tr("Format"); }
    SettingsCard {
        SettingsRow { setting-key: "reader:captures/format";
            row-title: @tr("Screenshot format");
            row-desc: @tr("Used for screencaps, converted saves and split pages. Lossless formats preserve every pixel; lossy formats use the quality setting below.");
            accessible-label: @tr("Screenshot format");
            ReaderSelect {
                width: Math.min(252px, Math.max(0px, root.width - 32px));
                enabled: root.interactive; roomy: true;
                placeholder-text: @tr("Screenshot format");
                model: [@tr("PNG (lossless)"), @tr("JPEG"), @tr("WebP (lossless)"), @tr("WebP (lossy)"), @tr("AVIF"), @tr("JPEG XL (lossless)"), @tr("JPEG XL (lossy)")];
                current-index <=> CaptureSettings.format-index;
                selected(_) => { CaptureSettings.settings-changed("format", self.current-index); }
            }
        }
        if CaptureSettings.format-index == 1: SettingsRow { setting-key: "reader:captures/jpeg_quality";
            row-title: @tr("JPEG quality");
            row-desc: @tr("Higher values retain more detail and create larger files.");
            accessible-label: @tr("JPEG quality");
            NumericSetting {
                width: Math.min(InterfaceStyle.tv ? 320px : 252px, Math.max(0px, root.width - 32px));
                enabled: root.interactive; name: @tr("JPEG quality");
                value <=> CaptureSettings.jpeg-quality;
                minimum: 1; maximum: 100; step: 1; suffix: "%";
                changed(v) => { CaptureSettings.settings-changed("jpeg_quality", Math.round(v)); }
            }
        }
        if CaptureSettings.format-index == 3: SettingsRow { setting-key: "reader:captures/webp_quality";
            row-title: @tr("WebP quality");
            row-desc: @tr("Higher values retain more detail and create larger files.");
            accessible-label: @tr("WebP quality");
            NumericSetting {
                width: Math.min(InterfaceStyle.tv ? 320px : 252px, Math.max(0px, root.width - 32px));
                enabled: root.interactive; name: @tr("WebP quality");
                value <=> CaptureSettings.webp-quality;
                minimum: 1; maximum: 100; step: 1; suffix: "%";
                changed(v) => { CaptureSettings.settings-changed("webp_quality", Math.round(v)); }
            }
        }
        if CaptureSettings.format-index == 4: SettingsRow { setting-key: "reader:captures/avif_quality";
            row-title: @tr("AVIF quality");
            row-desc: @tr("Higher values retain more detail and create larger files.");
            accessible-label: @tr("AVIF quality");
            NumericSetting {
                width: Math.min(InterfaceStyle.tv ? 320px : 252px, Math.max(0px, root.width - 32px));
                enabled: root.interactive; name: @tr("AVIF quality");
                value <=> CaptureSettings.avif-quality;
                minimum: 1; maximum: 100; step: 1; suffix: "%";
                changed(v) => { CaptureSettings.settings-changed("avif_quality", Math.round(v)); }
            }
        }
        if CaptureSettings.format-index == 6: SettingsRow { setting-key: "reader:captures/jxl_quality";
            row-title: @tr("JPEG XL quality");
            row-desc: @tr("Higher values retain more detail and create larger files.");
            accessible-label: @tr("JPEG XL quality");
            NumericSetting {
                width: Math.min(InterfaceStyle.tv ? 320px : 252px, Math.max(0px, root.width - 32px));
                enabled: root.interactive; name: @tr("JPEG XL quality");
                value <=> CaptureSettings.jxl-quality;
                minimum: 1; maximum: 100; step: 1; suffix: "%";
                changed(v) => { CaptureSettings.settings-changed("jxl_quality", Math.round(v)); }
            }
        }
        SettingsRow { setting-key: "reader:captures/resolution";
            row-title: @tr("Screencap resolution");
            row-desc: @tr("Capture your selection using device pixels or the chapter's original pixels.");
            accessible-label: @tr("Screencap resolution");
            ReaderSelect {
                width: Math.min(252px, Math.max(0px, root.width - 32px));
                enabled: root.interactive;
                placeholder-text: @tr("Screencap resolution");
                model: [@tr("Device resolution"), @tr("Chapter resolution")];
                current-index <=> CaptureSettings.resolution-index;
                selected(_) => { CaptureSettings.settings-changed("resolution", self.current-index); }
            }
        }
    }
    SectionHeader { label: @tr("Files"); }
    SettingsCard {
        SettingsRow { setting-key: "reader:captures/series_folders";
            row-title: @tr("Screenshot folder");
            row-desc: @tr("Save in Pictures/Nova Reader or group captures by series.");
            accessible-label: @tr("Screenshot folder");
            Segmented {
                enabled: root.interactive;
                labels: [@tr("Reader"), @tr("Series folders")];
                current-index: CaptureSettings.series-folders ? 1 : 0;
                picked(i) => { CaptureSettings.settings-changed("series_folders", i); }
            }
        }
        SettingsRow { setting-key: "reader:captures/conflict";
            row-title: @tr("File conflicts");
            row-desc: @tr("Choose what happens when a capture file already exists.");
            accessible-label: @tr("File conflicts");
            ReaderSelect {
                width: Math.min(252px, Math.max(0px, root.width - 32px));
                enabled: root.interactive;
                placeholder-text: @tr("File conflicts");
                model: [@tr("Ask"), @tr("Overwrite"), @tr("Do nothing")];
                current-index <=> CaptureSettings.conflict-policy;
                selected(_) => { CaptureSettings.settings-changed("conflict", self.current-index); }
            }
        }
    }
}
