import { ControlTouchArea } from "@NovaUiBase/control-input.slint";
// Mihon's source hierarchy with Nova's Kit controls, palette and focus rules.
import { Theme, SettingsStyle } from "@NovaUiShared";
import { AddonIcon } from "addon-icon.slint";
import { SourceRow } from "media-models.slint";
import { ActionButton, IconAction } from "controls.slint";

component SourceTip inherits Rectangle {
    in property <string> text;
    width: tip.preferred-width + 20px; height: tip.preferred-height + 14px;
    background: Theme.current.popup; border-radius: 6px;
    border-width: 1px; border-color: Theme.current.border_medium;
    tip := Text {
        x: 10px; y: 7px; text: root.text;
        color: Theme.current.text_primary; font-size: 12px;
    }
}

component SourceListRow inherits Rectangle {
    in property <SourceRow> item;
    callback picked;
    callback latest-picked;
    callback pin-picked;
    min-width: 0px; height: 80px;
    private property <bool> show-latest: root.item.enabled && root.item.latest;
    background: entry-touch.feedback-active ? Theme.current.control_hover : transparent;
    border-radius: Theme.card_corner_radius;
    border-width: scope.has-focus ? 2px : 0px;
    border-color: Theme.current.focus_ring;

    entry := Rectangle {
        x: 0px; y: 0px;
        width: max(1px, root.width - (root.show-latest ? 120px : 52px));
        height: 100%;
        accessible-role: button;
        accessible-label: root.item.name + ", " + root.item.language;
        accessible-enabled: root.item.enabled;
        accessible-action-default => { if root.item.enabled { root.picked(); } }
        AddonIcon {
            x: 4px; y: 20px;
            icon: root.item.icon; enabled: root.item.enabled;
        }
        VerticalLayout {
            x: 56px; y: 17px;
            width: max(1px, parent.width - 64px); height: 46px;
            alignment: center; spacing: 5px;
            Text {
                min-width: 0px; text: root.item.name; overflow: elide;
                color: root.item.enabled ? Theme.current.text_bright : Theme.current.text_muted;
                font-size: 16px; font-weight: 600;
            }
            Text {
                min-width: 0px; text: root.item.language; overflow: elide;
                color: root.item.enabled ? Theme.current.text_secondary : Theme.current.text_muted;
                font-size: 13px;
            }
        }
        scope := FocusScope {
            enabled: root.item.enabled;
            changed has-focus => {
                if self.has-focus { SettingsStyle.reveal_control(root.absolute-position.y, root.height, false); }
            }
            key-pressed(event) => {
                if event.text == Key.Return || event.text == " " {
                    if !event.repeat { root.picked(); }
                    return accept;
                }
                return reject;
            }
        }
        entry-touch := ControlTouchArea {
            enabled: root.item.enabled; mouse-cursor: pointer;
            clicked => { root.picked(); }
        }
        forward-focus: scope;
    }
    if root.show-latest: ActionButton {
        x: root.width - 116px; y: 18px; width: 64px; height: 44px;
        text: @tr("Latest"); clicked => { root.latest-picked(); }
        Tooltip { SourceTip { text: @tr("Latest chapters from {}", root.item.name); } }
    }
    IconAction {
        x: root.width - 44px; y: 18px; width: 44px; height: 44px;
        text: root.item.pinned ? @tr("Unpin source") : @tr("Pin source");
        accessible-checkable: true; accessible-checked: root.item.pinned;
        clicked => { root.pin-picked(); }
        Path {
            x: 12px; y: 12px; width: 20px; height: 20px;
            viewbox-width: 24; viewbox-height: 24;
            commands: root.item.pinned
                ? "M16 9V4h1V2H7v2h1v5c0 1.66-1.34 3-3 3v2h6v7l1 1 1-1v-7h6v-2c-1.66 0-3-1.34-3-3z"
                : "M19 12l-3-3V4h1V2H7v2h1v5l-3 3v2h6v7l1 1 1-1v-7h6v-2zM9.38 12L10 11.38V4h4v7.38l.62.62H9.38z";
            fill: root.item.pinned ? Theme.current.accent_vivid : Theme.current.text_secondary;
        }
        Tooltip { SourceTip { text: root.item.pinned ? @tr("Unpin source") : @tr("Pin source"); } }
    }
    forward-focus: scope;
}

export component SourceList inherits VerticalLayout {
    min-width: 0px;
    in property <[SourceRow]> items;
    callback picked(int);
    callback latest-picked(int);
    callback pin-picked(string);
    alignment: start; spacing: 0px; vertical-stretch: 0;

    for item[i] in root.items: VerticalLayout {
        min-width: 0px; spacing: 0px;
        if i == 0 || item.group != root.items[i - 1].group: Text {
            min-width: 0px; height: 40px; text: item.group;
            color: Theme.current.text_secondary; font-size: 14px; font-weight: 600;
            vertical-alignment: center; overflow: elide;
        }
        SourceListRow {
            item: item;
            picked => { root.picked(item.index); }
            latest-picked => { root.latest-picked(item.index); }
            pin-picked => { root.pin-picked(item.id); }
        }
    }
}
