export struct ItemRow {
    title: string, subtitle: string, badge: string, bookmarked: bool,
    artwork-key: string, series-key: string, poster: image, completed: int, total: int, read: bool,
    downloaded: bool, download-state: int, download-progress: float, has-download: bool, local-import: bool,
    chapter-meta: string, group: string, timestamp: string,
    // Chapter rows on the detail screen: the number column, the title without
    // a repeated "Chapter N" prefix (`title` stays whole for accessibility),
    // the status leading the details line and partly read progress.
    number: string, short-title: string, status: string, status-danger: bool, read-fraction: float,
    // The reading part of the status ("Page X"), kept so download polling can
    // rebuild `status` when a transfer starts or ends.
    reading-status: string,
    // New since the title was last opened (stays for the whole visit).
    is-new: bool,
    // Part of the detail screen's multi-chapter selection.
    selected: bool,
    // Library: chapters new since the title was last opened, chapters on
    // disk, the line under a grid title (success-coloured for "Completed")
    // and a list row's "status · source · N downloaded" line.
    new-count: int, downloaded-count: int, detail: string, detail-success: bool, list-detail: string
}

export struct SettingRow { key: string, name: string, kind: string, value: string, checked: bool, options: [string], selected: int }
// `code` is the short language tag (EN, JA, ALL), `extension` the providing
// addon's name and `adult` its adult marking.
export struct SourceRow { id:string, name:string, language:string, group:string, pinned:bool, enabled:bool, latest:bool, index:int, icon:image, code:string, extension:string, adult:bool }
// `sources` counts the visible sources the extension provides.
export struct ExtensionRow { id:string, name:string, version:string, language:string, enabled:bool, icon:image, sources:int }

// A ⋯ menu entry. Kinds: 0 section label, 1 check item, 2 action,
// 3 destructive action, 4 switch.
export struct PageMenuItem { label: string, kind: int, checked: bool, id: string }
