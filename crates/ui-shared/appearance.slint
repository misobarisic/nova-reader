// Reader-owned values; palette, controls and motion come from Nova Kit.
export global Appearance {
    in-out property <int> accent-color: 0;
    in-out property <int> background-style: 0;
    in-out property <int> card-radius: 10;
    in-out property <int> button-radius: 8;
    in-out property <int> card-spacing: 8;
    in-out property <bool> transparent-navbar: true;
    in-out property <bool> animations: true;
    in-out property <bool> transitions: true;
    in-out property <bool> hover: true;
    in-out property <bool> navigation-feedback: true;
    in-out property <bool> library-list-view: false;
    in-out property <int> library-min-cols: 2;
    in-out property <int> browse-min-cols: 3;
    in-out property <int> library-sort: 0;
    // Reverses the sort's natural order (0 Recently added, 1 Title, 2 Unread,
    // 3 Last read, 4 Latest chapter).
    in-out property <bool> library-sort-reversed: false;
    // Updates: 0 by day and series, 1 by day only.
    in-out property <int> updates-grouping: 0;
    // History: 0 session cards, 1 timeline.
    in-out property <int> history-view: 0;
    in-out property <bool> history-shelf-hidden: false;
    callback setting-changed(string, int);
    callback restore-theme;
}
